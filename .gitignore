node_modules/
.env
*-service-account*.json
jpsme-excel-report-*.json
.claude/settings.local.json
public/uploads/*
!public/uploads/.gitkeep
storage/certificates/events/*
!storage/certificates/events/.gitkeep
*.log
.DS_Store
CLAUDE.md

# Database snapshots written before destructive operations (see the backup and
# restore steps in the organization scripts). Local safety nets, often large,
# and stale the moment anything changes — never useful to anyone else.
# Supersedes the narrower org-backup-before-wipe.json entry.
org-backup*.json

# Generated documents. Produced on demand from the data or the source
# documents, so committing them means carrying a binary that silently goes out
# of date against whatever it was generated from.
JPSME-2.0-Blueprint.pdf
JPSME-Organization-*.pdf

# Local test-data seeder. Creates accounts with a shared, hardcoded password,
# which is fine on a development machine and not something to publish. Kept out
# of the repository so it can never be run against a real deployment.
prisma/seedDummyUsers.js
seed.js
seedDummyUsers.js

# .vscode/ is deliberately NOT ignored — launch.json is committed on purpose so
# the debug configuration is shared. Ignoring the folder here would contradict
# that without untracking it, which is the confusing half-state.
