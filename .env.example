## Copy this file to .env and adjust values for your local XAMPP MySQL setup.

# XAMPP MySQL default: root user with empty password on localhost:3306.
# IMPORTANT: this must be a dedicated database, separate from the legacy
# `jpsme2` database used by the existing PHP app at C:\xampp\htdocs\jpsme.
# Create it first (e.g. via phpMyAdmin): CREATE DATABASE jpsme2_new;
# In production, add ?connection_limit=N (e.g. 10) so CLUSTER_WORKERS x N stays
# comfortably under MySQL's max_connections — see README "Scaling & going live".
DATABASE_URL="mysql://root:@localhost:3306/jpsme2_new"

# Random long string used to sign session cookies. Generate a new one per environment.
SESSION_SECRET="change-this-to-a-long-random-string"

PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Number of worker processes `npm start` forks (one per CPU core is a good
# starting point in production). Defaults to 1 — safe to leave unset locally.
# CLUSTER_WORKERS=4

# Set to "true" only once this app runs behind a real reverse proxy (Nginx,
# GoDaddy's proxy, etc.) — it makes Express trust X-Forwarded-* headers for
# client IPs, which is required for rate limiting and secure cookies to work
# correctly behind a proxy, but unsafe to enable without one (IP spoofing).
# TRUST_PROXY=true

# Email — Brevo's transactional API takes priority when BREVO_API_KEY is set
# (src/config/mailer.js); SMTP below stays as a fallback for setups without a
# Brevo key. Leave both unset to just log emails to the console during local dev.
# Get the key from Brevo's dashboard (Settings > SMTP & API > API Keys) —
# server-side only, never expose it to the browser/frontend.
# BREVO_API_KEY="xkeysib-REPLACE_ME"
# BREVO_SENDER must be an email Brevo has you verify (Settings > Senders) —
# sends fail otherwise. Falls back to SMTP_FROM, then a hardcoded default.
# BREVO_SENDER="JPSME <no-reply@yourdomain.com>"

# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="JPSME <no-reply@jpsme.local>"

# Delay (ms) between each email in a bulk broadcast send (admin/broadcasts) —
# paces the batch to stay under the mail provider's rate limit and avoid
# stalling the event loop. Defaults to 350ms if unset.
# BROADCAST_SEND_INTERVAL_MS=350

# PayMongo (GCash membership payments). Get these from the PayMongo dashboard
# (Developers > API Keys / Webhooks). Use sk_test_*/pk_test_* while developing —
# the secret key's sk_live_ prefix is what switches webhook signature checking
# into live mode (see src/services/paymongo.service.js). NEVER commit real
# values or expose PAYMONGO_SECRET_KEY/PAYMONGO_WEBHOOK_SECRET to the browser.
# PAYMONGO_WEBHOOK_SECRET is the signing secret PayMongo shows you after you
# register a webhook endpoint in its dashboard — NOT the endpoint URL itself.
# It's used to compute/verify the Paymongo-Signature header's HMAC, so a URL
# here silently breaks webhook verification (every real delivery will fail
# signature checking and get rejected).
PAYMONGO_SECRET_KEY="sk_test_REPLACE_ME"
PAYMONGO_PUBLIC_KEY="pk_test_REPLACE_ME"
PAYMONGO_WEBHOOK_SECRET="REPLACE_ME"
