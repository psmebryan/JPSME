<section class="-mx-4 -mt-12 mb-10 border-b border-[#26365f] bg-[radial-gradient(circle_at_14%_25%,#1c1442_0,transparent_35%),#080f29] px-4 py-14 sm:-mx-6 sm:px-6"><div class="mx-auto max-w-6xl"><nav class="text-sm text-slate-400"><a href="/">Home</a><span class="mx-2">&gt;</span><span class="font-bold text-amber-400">Articles</span></nav><h1 class="mt-4 text-4xl font-extrabold">Articles &amp; News</h1></div></section>

<% if (categories && categories.length > 0) { %>
  <div class="mb-8 flex flex-wrap gap-2">
    <a href="/articles" class="px-4 py-1.5 rounded-full text-sm font-medium <%= !activeCategory ? 'bg-amber-400 text-[#071126]' : 'bg-[#111b3a] border border-[#263b70] text-slate-300 hover:text-amber-300' %>">All</a>
    <% categories.forEach(cat => { %>
      <a href="/articles?category=<%= encodeURIComponent(cat) %>" class="px-4 py-1.5 rounded-full text-sm font-medium <%= activeCategory === cat ? 'bg-amber-400 text-[#071126]' : 'bg-[#111b3a] border border-[#263b70] text-slate-300 hover:text-amber-300' %>"><%= cat %></a>
    <% }) %>
  </div>
<% } %>

<% if (!articles || articles.length === 0) { %>
  <p class="text-gray-400">No articles published yet.</p>
<% } else { %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% articles.forEach(article => { %>
      <div class="border border-[#263b70] bg-[#111b3a] rounded-2xl overflow-hidden flex flex-col hover:shadow-sm transition">
        <a href="/articles/<%= article.id %>">
          <% if (article.coverImage) { %>
            <img src="<%= article.coverImage %>" alt="" class="w-full h-40 object-cover">
          <% } else { %>
            <div class="w-full h-40 bg-gray-100 flex items-center justify-center text-gray-300">
              <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
              </svg>
            </div>
          <% } %>
        </a>
        <div class="p-4 flex-1 flex flex-col">
          <% if (article.category) { %>
            <span class="inline-block text-xs font-medium px-2 py-0.5 rounded-full mb-2 bg-sky-100 text-sky-700 self-start"><%= article.category %></span>
          <% } %>
          <h3 class="font-semibold text-lg"><a href="/articles/<%= article.id %>" class="hover:text-amber-300"><%= article.title %></a></h3>
          <p class="text-xs text-slate-400 mt-1">
            <% if (article.authorName) { %><%= article.authorName %> &middot; <% } %>
            <%= new Date(article.publishedAt).toLocaleDateString() %>
          </p>
          <p class="text-sm text-slate-400 mt-2 line-clamp-3 flex-1"><%= article.body %></p>
          <a href="/articles/<%= article.id %>" class="mt-3 text-sm font-medium text-amber-400 hover:text-amber-300">Read more &rarr;</a>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
