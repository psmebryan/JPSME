<%#
  News. Without a filter: every category's latest articles (the newest
  category first, shown as wide rows; the rest as cards), then By Year.
  With ?view=all, ?category=, ?year= or ?q=: a paged grid of the matches.
  See article.service newsLanding / listPublishedArticles.
%>
<%
  const f = filters;
  const qs = (over) => {
    const p = { view: f.all && !f.category && !f.year && !f.q ? 'all' : null, category: f.category || null, year: f.year || null, q: f.q || null, ...over };
    const s = Object.keys(p).filter((k) => p[k] !== null && p[k] !== undefined && p[k] !== '' && !(k === 'page' && Number(p[k]) === 1))
      .map((k) => `${encodeURIComponent(k)}=${encodeURIComponent(p[k])}`).join('&');
    return '/articles' + (s ? `?${s}` : '');
  };
  let heading = 'All News';
  if (f.category) heading = f.category;
  if (f.year) heading = f.category ? `${f.category} · ${f.year}` : `News from ${f.year}`;
  if (f.q) heading = `Search: “${f.q}”`;
%>
<section class="-mx-4 -mt-12 mb-10 overflow-hidden border-b border-[#26365f] bg-[radial-gradient(circle_at_14%_25%,#1c1442_0,transparent_35%),radial-gradient(circle_at_85%_80%,#2a1f05_0,transparent_30%),#080f29] px-4 py-16 sm:-mx-6 sm:px-6">
  <div class="mx-auto max-w-6xl text-center">
    <h1 class="text-4xl font-extrabold sm:text-5xl">News</h1>
    <p class="mx-auto mt-3 max-w-2xl text-slate-400">Circulars, newsletters and announcements from JPSME</p>
  </div>
</section>

<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <nav class="flex items-center gap-2 text-sm text-slate-400" aria-label="Breadcrumb">
    <a href="/" class="hover:text-amber-300">Home</a>
    <span aria-hidden="true">&rsaquo;</span>
    <% if (filtered) { %>
      <a href="/articles" class="hover:text-amber-300">News</a>
      <span aria-hidden="true">&rsaquo;</span>
      <span class="font-semibold text-amber-400"><%= heading %></span>
    <% } else { %>
      <span class="font-semibold text-amber-400">News</span>
    <% } %>
  </nav>
  <div class="flex gap-2">
    <form method="get" action="/articles" class="relative flex-1 sm:w-72 sm:flex-none" role="search">
      <% if (f.category) { %><input type="hidden" name="category" value="<%= f.category %>"><% } %>
      <% if (f.year) { %><input type="hidden" name="year" value="<%= f.year %>"><% } %>
      <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke-width="2"/><path d="M20 20l-3.5-3.5" stroke-width="2" stroke-linecap="round"/></svg>
      <input type="search" name="q" value="<%= f.q %>" maxlength="100" placeholder="Search news" aria-label="Search news"
             class="w-full rounded-lg border border-[#263b70] bg-[#0b1430] py-2.5 pl-9 pr-3 text-sm text-white placeholder:text-slate-500 focus:border-amber-400 focus:outline-none">
    </form>
    <% if (!f.all || f.category || f.year || f.q) { %>
      <a href="/articles?view=all" class="inline-flex items-center whitespace-nowrap rounded-lg bg-amber-400 px-5 py-2.5 text-sm font-semibold text-[#071126] hover:bg-amber-300">View All</a>
    <% } %>
  </div>
</div>

<% if (filtered) { %>
  <%# ---- the paged list ---- %>
  <% if (categories.length) { %>
    <div class="mb-6 flex flex-wrap gap-2">
      <a href="<%= f.year ? `/articles?year=${f.year}` : '/articles?view=all' %>" class="rounded-full px-4 py-1.5 text-sm font-medium <%= !f.category ? 'bg-amber-400 text-[#071126]' : 'border border-[#263b70] bg-[#111b3a] text-slate-300 hover:text-amber-300' %>">All</a>
      <% categories.forEach((c) => { %>
        <a href="/articles?category=<%= encodeURIComponent(c.name) %><%= f.year ? `&year=${f.year}` : '' %>" class="rounded-full px-4 py-1.5 text-sm font-medium <%= f.category === c.name ? 'bg-amber-400 text-[#071126]' : 'border border-[#263b70] bg-[#111b3a] text-slate-300 hover:text-amber-300' %>"><%= c.name %> <span class="opacity-60"><%= c.count %></span></a>
      <% }) %>
    </div>
  <% } %>
  <h2 class="mb-1 text-2xl font-bold text-white"><%= heading %></h2>
  <p class="mb-6 text-sm text-slate-400"><%= listing.total %> <%= listing.total === 1 ? 'article' : 'articles' %></p>
  <% if (!listing.articles.length) { %>
    <div class="rounded-2xl border border-dashed border-[#263b70] p-10 text-center text-slate-400">
      Nothing found. <a href="/articles" class="text-amber-400 hover:underline">Back to News</a>
    </div>
  <% } else { %>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-article-grid>
      <% listing.articles.forEach((a) => { %>
        <%- include('partials/article-card', { article: a, showCategory: !f.category, showTeaser: true }) %>
      <% }) %>
    </div>
    <% if (listing.totalPages > 1) { %>
      <nav class="mt-8 flex items-center justify-center gap-3 text-sm" aria-label="Pages">
        <% if (listing.page > 1) { %><a href="<%= qs({ page: listing.page - 1 }) %>" class="rounded-lg border border-[#263b70] px-4 py-2 text-slate-200 hover:border-amber-400">Previous</a><% } %>
        <span class="text-slate-400">Page <%= listing.page %> of <%= listing.totalPages %></span>
        <% if (listing.page < listing.totalPages) { %><a href="<%= qs({ page: listing.page + 1 }) %>" class="rounded-lg border border-[#263b70] px-4 py-2 text-slate-200 hover:border-amber-400">Next</a><% } %>
      </nav>
    <% } %>
  <% } %>
<% } else if (!sections.length) { %>
  <div class="rounded-2xl border border-dashed border-[#263b70] p-10 text-center text-slate-400">No news published yet.</div>
<% } else { %>
  <%# ---- the landing page: one section per category ---- %>
  <div class="space-y-14">
    <% sections.forEach((s, i) => { %>
      <section data-news-section="<%= s.name || '' %>">
        <div class="mb-5 flex items-end justify-between gap-4">
          <h2 class="text-2xl font-bold text-white"><%= s.name || 'More News' %></h2>
          <% if (s.name && s.count > s.articles.length) { %>
            <a href="/articles?category=<%= encodeURIComponent(s.name) %>" class="whitespace-nowrap text-sm font-medium text-amber-400 hover:text-amber-300">See all <%= s.count %> &rarr;</a>
          <% } %>
        </div>
        <% if (i === 0) { %>
          <div class="space-y-4">
            <% s.articles.slice(0, 3).forEach((a) => { %><%- include('partials/article-card', { article: a, wide: true }) %><% }) %>
          </div>
        <% } else { %>
          <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
            <% s.articles.forEach((a) => { %><%- include('partials/article-card', { article: a }) %><% }) %>
          </div>
        <% } %>
      </section>
    <% }) %>

    <% if (years.length) { %>
      <section data-news-years>
        <div class="mb-5 flex items-center justify-between">
          <h2 class="text-2xl font-bold text-white">By Year</h2>
          <div class="flex gap-2">
            <button type="button" class="rounded-full border border-[#263b70] p-2 text-slate-300 hover:border-amber-400 hover:text-amber-300" data-years-prev aria-label="Earlier years">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            </button>
            <button type="button" class="rounded-full border border-[#263b70] p-2 text-slate-300 hover:border-amber-400 hover:text-amber-300" data-years-next aria-label="Later years">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </button>
          </div>
        </div>
        <div class="flex snap-x gap-4 overflow-x-auto pb-2 [scrollbar-width:thin]" data-years-track>
          <% years.forEach((y) => { %>
            <a href="/articles?year=<%= y %>" class="group flex w-48 shrink-0 snap-start flex-col items-center gap-4 rounded-2xl border border-[#263b70] bg-gradient-to-br from-[#1b2a6b] to-[#111b3a] px-6 py-7 transition hover:border-amber-400/70 sm:w-56">
              <svg class="h-16 w-20 drop-shadow transition group-hover:-translate-y-0.5" viewBox="0 0 80 64" aria-hidden="true">
                <path d="M4 10a6 6 0 016-6h20l6 7h34a6 6 0 016 6v3H4z" fill="#f97362"/>
                <rect x="4" y="16" width="72" height="44" rx="6" fill="#fcd34d"/>
                <rect x="4" y="16" width="72" height="10" rx="5" fill="#fde68a" opacity=".6"/>
              </svg>
              <span class="rounded-lg bg-white/10 px-6 py-1.5 text-lg font-semibold text-white"><%= y %></span>
            </a>
          <% }) %>
        </div>
      </section>
    <% } %>
  </div>
<% } %>

<script nonce="<%= cspNonce %>">
(function () {
  const track = document.querySelector('[data-years-track]');
  if (!track) return;
  const step = () => Math.max(200, track.clientWidth * 0.8);
  document.querySelector('[data-years-prev]').addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
  document.querySelector('[data-years-next]').addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
}());
</script>
