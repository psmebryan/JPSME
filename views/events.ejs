<%
  function modalityLabel(m) {
    return m === 'ONLINE' ? 'Online' : 'Face to Face';
  }
  function modalityBadgeClass(m) {
    return m === 'ONLINE'
      ? 'bg-sky-100 text-sky-700'
      : 'bg-emerald-100 text-emerald-700';
  }
%>

<section class="-mx-4 -mt-12 mb-10 border-b border-[#26365f] bg-[radial-gradient(circle_at_14%_25%,#1c1442_0,transparent_35%),#080f29] px-4 py-14 sm:-mx-6 sm:px-6"><div class="mx-auto max-w-6xl"><nav class="text-sm text-slate-400"><a href="/">Home</a><span class="mx-2">&gt;</span><span class="font-bold text-amber-400">Events</span></nav><h1 class="mt-4 text-4xl font-extrabold">Events &amp; Symposia</h1></div></section>

<div class="mb-12 flex flex-col gap-3 rounded-xl border border-[#263b70] bg-[#111b3a] p-4 sm:flex-row"><input type="search" placeholder="Search events by keyword, topic, or location..." class="flex-1 rounded-lg border px-4 py-2.5 text-sm"><select class="rounded-lg border px-4 py-2.5 text-sm"><option>All Event Categories</option></select><select class="rounded-lg border px-4 py-2.5 text-sm"><option>Upcoming Year</option></select></div>

<% if (featuredEvents && featuredEvents.length > 0) { %>
  <div class="mb-10">
    <p class="text-xs font-semibold tracking-wide uppercase text-amber-600 mb-3">Featured</p>
    <div class="grid gap-4 sm:grid-cols-2">
      <% featuredEvents.forEach(event => { %>
        <a href="/events/<%= event.id %>" class="relative block border-2 border-amber-300 bg-amber-50 rounded-lg overflow-hidden hover:shadow-md transition">
          <% if (event.imageUrl) { %>
            <img src="<%= event.imageUrl %>" alt="" class="w-full h-40 object-cover">
          <% } else { %>
            <div class="w-full h-40 bg-amber-100 flex items-center justify-center text-amber-400">
              <svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3 20.25h18A1.5 1.5 0 0022.5 18.75V5.25A1.5 1.5 0 0021 3.75H3a1.5 1.5 0 00-1.5 1.5v13.5A1.5 1.5 0 003 20.25z" />
              </svg>
            </div>
          <% } %>
          <div class="p-4">
            <span class="inline-block text-[11px] font-bold uppercase tracking-wide text-amber-600 mb-1">Featured Event</span>
            <h3 class="font-semibold text-lg text-gray-900"><%= event.title %></h3>
            <p class="text-sm text-gray-500 mt-1"><%= new Date(event.startDate).toLocaleString() %></p>
            <span class="inline-block mt-2 text-xs font-medium px-2 py-0.5 rounded-full <%= modalityBadgeClass(event.modality) %>">
              <%= modalityLabel(event.modality) %>
            </span>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
<% } %>

<section class="mb-12">
  <h2 class="text-3xl font-extrabold mb-8">Upcoming Assemblies</h2>
  <% if (!upcomingEvents || upcomingEvents.length === 0) { %>
    <p class="text-gray-500">No upcoming events right now.</p>
  <% } else { %>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% upcomingEvents.forEach(event => { %>
        <div class="border border-[#263b70] bg-[#111b3a] rounded-2xl overflow-hidden flex flex-col justify-between hover:shadow-sm transition">
          <a href="/events/<%= event.id %>">
            <% if (event.imageUrl) { %>
              <img src="<%= event.imageUrl %>" alt="" class="w-full h-36 object-cover">
            <% } else { %>
              <div class="w-full h-36 bg-gray-100 flex items-center justify-center text-gray-300">
                <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3 20.25h18A1.5 1.5 0 0022.5 18.75V5.25A1.5 1.5 0 0021 3.75H3a1.5 1.5 0 00-1.5 1.5v13.5A1.5 1.5 0 003 20.25z" />
                </svg>
              </div>
            <% } %>
          </a>
          <div class="p-4 flex-1">
            <span class="inline-block text-xs font-medium px-2 py-0.5 rounded-full mb-2 <%= modalityBadgeClass(event.modality) %>">
              <%= modalityLabel(event.modality) %>
            </span>
            <h3 class="font-semibold text-lg">
              <a href="/events/<%= event.id %>" class="hover:text-indigo-600"><%= event.title %></a>
            </h3>
            <p class="text-sm text-gray-500 mt-1"><%= new Date(event.startDate).toLocaleString() %></p>
            <% if (event.location) { %><p class="text-sm text-gray-500"><%= event.location %></p><% } %>
            <% if (event.description) { %>
              <p class="text-sm text-gray-500 mt-2 line-clamp-2"><%= event.description %></p>
            <% } %>
          </div>
          <div class="p-4 pt-0">
            <% const registered = Array.isArray(registeredEventIds) ? registeredEventIds.includes(event.id) : (typeof isRegistered !== 'undefined' && isRegistered); %>
            <% if (registered) { %>
              <div class="flex items-center gap-3">
              <button class="bg-[#203666] text-emerald-400 px-4 py-2 rounded-md opacity-80 cursor-default" disabled aria-disabled="true">Registered</button>
                <button data-cancel-registration="<%= event.id %>" class="text-sm text-red-600 hover:underline">Cancel registration</button>
              </div>
            <% } else { %>
              <button
                data-register-event="<%= event.id %>"
                data-logged-in="<%= !!locals.currentUser %>"
                data-registered="<%= registered %>"
                class="bg-amber-400 text-[#071126] font-bold px-5 py-2.5 rounded-md hover:bg-amber-300 disabled:opacity-60 disabled:cursor-not-allowed">
                Register Now
              </button>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
    <%- include('partials/pagination', {
      currentPage: upcomingPage,
      totalPages: upcomingTotalPages,
      baseQuery: {},
      pageParam: 'upcomingPage'
    }) %>
  <% } %>
</section>

<section>
  <h2 class="text-3xl font-extrabold mb-8">Past Hosted Events</h2>
  <% if (!endedEvents || endedEvents.length === 0) { %>
    <p class="text-gray-400">No past events yet.</p>
  <% } else { %>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% endedEvents.forEach(event => { %>
        <div class="border border-[#263b70] bg-[#111b3a] rounded-2xl overflow-hidden opacity-90">
          <a href="/events/<%= event.id %>">
            <% if (event.imageUrl) { %>
              <img src="<%= event.imageUrl %>" alt="" class="w-full h-32 object-cover grayscale">
            <% } %>
          </a>
          <div class="p-4">
            <span class="inline-block text-xs font-medium px-2 py-0.5 rounded-full mb-2 bg-gray-100 text-gray-500">
              <%= modalityLabel(event.modality) %> &middot; Ended
            </span>
            <h3 class="font-semibold">
              <a href="/events/<%= event.id %>" class="hover:text-indigo-600"><%= event.title %></a>
            </h3>
            <p class="text-sm text-gray-500 mt-1"><%= new Date(event.startDate).toLocaleString() %></p>
          </div>
        </div>
      <% }) %>
    </div>
    <%- include('partials/pagination', {
      currentPage: endedPage,
      totalPages: endedTotalPages,
      baseQuery: {},
      pageParam: 'endedPage'
    }) %>
  <% } %>
</section>

<script src="/js/events.js"></script>
