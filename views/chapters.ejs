<%
const regions = locals.regions || [];
%>

<section class="relative left-1/2 -ml-[50vw] w-screen border-b border-[#26365f] bg-[radial-gradient(circle_at_14%_25%,#1c1442_0,transparent_35%),#080f29]">
  <div class="max-w-6xl mx-auto px-4 py-16">
    <nav class="text-sm text-slate-400 mb-4"><a href="/">Home</a><span class="mx-2">&gt;</span><span class="font-bold text-amber-400">Chapters</span></nav><h1 class="text-4xl sm:text-5xl font-extrabold text-white">Regional Chapters</h1>
  </div>
</section>

<div class="max-w-6xl mx-auto px-4 py-16">
  <nav class="text-sm text-gray-500 mb-8" aria-label="Breadcrumb">
    <a href="/" class="hover:text-indigo-600">Home</a>
    <span class="mx-2">&gt;</span>
    <span class="text-gray-700 font-medium">Chapters</span>
  </nav>

  <div class="grid gap-10 lg:grid-cols-[.65fr_1.35fr]"><div><h2 class="text-3xl font-extrabold">Uniting Chapters Across<br>the Philippines</h2><p class="mt-6 leading-7 text-slate-400">The Junior Philippine Society of Mechanical Engineers spans multiple regional clusters across Luzon, Visayas, and Mindanao. Explore the specific active chapters near you to join events and professional assemblies.</p><p class="mt-6 rounded-xl border border-[#263b70] bg-[#111b3a] p-5 text-sm leading-6 text-slate-400">Each regional chapter hosts bespoke assemblies designed around regional engineering highlights, providing localized mentoring and student assistance.</p></div><div>
  <% if (!regions.length) { %>
    <p class="text-center text-sm text-gray-500">No chapters have been added yet.</p>
  <% } else { %>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <% regions.forEach(region => { %>
        <a href="/chapters/region/<%= region.id %>"
           class="bg-indigo-950 border-2 border-amber-400 rounded-xl p-6 text-center shadow-sm hover:shadow-md transition-shadow">
          <div class="mx-auto w-16 h-16 rounded-full border-2 border-amber-400 flex items-center justify-center mb-4">
            <svg class="w-9 h-9 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.28z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <p class="font-bold text-white leading-snug"><%= region.name %></p>
          <p class="mt-1 text-xs font-semibold text-amber-400"><%= region.chapterCount %> Chapter<%= region.chapterCount === 1 ? '' : 's' %></p>
        </a>
      <% }) %>
    </div>
  <% } %></div></div>
</div>
