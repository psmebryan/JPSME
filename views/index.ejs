<% const displayEvents = events.slice(0, 3); %>
<div class="-mx-4 -my-8 overflow-hidden bg-[#080f29] text-white sm:-mx-6 lg:-mx-8">
  <%#
    The hero, built to match the JPSME banner artwork: navy at both edges with
    gold burning through the middle, over a technical drawing.

    The drawing is public/img/blueprint.svg rather than the raster banner. The
    host wipes uploaded files on every deploy, so shipping it with the code is
    what stops the hero going blank at the next publish — and a vector stays
    sharp on a phone and on a 4K monitor from the same two kilobytes.

    An uploaded hero image, when one is set in Admin - Settings, covers all of
    it. Rendered as a positioned <img> rather than an inline background-image
    because styleSrc carries a nonce and no 'unsafe-inline', so a style
    attribute built from a database value would simply be dropped.
  %>
  <section class="relative isolate overflow-hidden border-b border-amber-400/25">
    <%# Layer 1: the gold-through-navy gradient the banner is built on. %>
    <div class="absolute inset-0 -z-30 bg-[linear-gradient(100deg,#141a5c_0%,#1e2470_22%,#8a6a1e_46%,#f5c518_53%,#8a6a1e_60%,#1e2470_80%,#101641_100%)]"></div>
    <%# Layer 2: the drawing, tiled. Screen blend keeps the white linework
        bright over the navy and lets it burn out over the gold, which is what
        the original artwork does. %>
    <div class="absolute inset-0 -z-20 bg-[url('/img/blueprint.svg')] bg-[length:420px_420px] opacity-[0.22] mix-blend-screen"></div>
    <%# Layer 3: darkens the edges so white text stays readable across the gold
        band, which is far too bright to sit type on directly. %>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,#080f29_0%,rgba(8,15,41,.92)_30%,rgba(8,15,41,.55)_50%,rgba(8,15,41,.9)_72%,#080f29_100%)]"></div>

    <% if (locals.heroImageUrl) { %>
      <img src="<%= heroImageUrl %>" alt="" aria-hidden="true" class="absolute inset-0 -z-10 h-full w-full object-cover">
      <div class="absolute inset-0 -z-10 bg-[#080f29]/70"></div>
    <% } %>

    <div class="mx-auto grid max-w-[1280px] items-center gap-12 px-5 py-16 sm:px-8 sm:py-24 lg:min-h-[640px] lg:grid-cols-[1.1fr_.9fr] lg:px-12">
      <div class="max-w-[630px]">
        <p class="mb-8 inline-flex rounded-full border border-amber-400 bg-[#080f29]/60 px-3 py-1 text-xs font-bold tracking-[.18em] text-amber-400">NATIONAL STUDENT ORGANIZATION</p>
        <h1 class="text-6xl font-extrabold tracking-tight drop-shadow-[0_2px_12px_rgba(8,15,41,.9)] sm:text-7xl">JPSME</h1>
        <p class="mt-4 max-w-xl text-2xl font-bold leading-tight text-amber-400 drop-shadow-[0_2px_10px_rgba(8,15,41,.9)] sm:text-3xl">Junior Philippine Society of Mechanical Engineers</p>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-300 drop-shadow-[0_1px_8px_rgba(8,15,41,.95)] sm:text-lg">&quot;Connecting members, one event at a time.&quot; Building the path for next-generation Pinoy mechanical engineering leaders, innovators, and certified practitioners.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/register" class="inline-flex items-center rounded-lg bg-amber-400 px-7 py-3.5 text-sm font-extrabold text-[#071126] shadow-lg shadow-black/30 transition hover:bg-amber-300">Be a Member Now <span class="ml-1 text-lg">&rarr;</span></a>
          <a href="/events" class="inline-flex items-center rounded-lg border border-amber-400/70 bg-[#080f29]/60 px-7 py-3.5 text-sm font-extrabold text-amber-400 transition hover:bg-amber-400 hover:text-[#071126]">See Events</a>
        </div>
      </div>

      <%# The seal, lit rather than boxed. The old frame was a plate the logo
          sat on; against the drawing it reads better as the thing the light is
          coming from. %>
      <div class="relative mx-auto flex aspect-square w-full max-w-[420px] items-center justify-center">
        <div class="absolute inset-[12%] rounded-full bg-amber-300/25 blur-3xl"></div>
        <div class="absolute inset-[4%] rounded-full border border-amber-400/30"></div>
        <div class="absolute inset-[-2%] rounded-full border border-amber-400/15"></div>
        <img src="<%= locals.logoUrl || '/img/default-logo.svg' %>" alt="JPSME seal" class="relative h-[86%] w-[86%] object-contain drop-shadow-[0_0_36px_rgba(245,197,24,.45)]">
      </div>
    </div>
  </section>

  <section class="border-b border-[#26365f] bg-[#111b3a]"><div class="mx-auto grid max-w-[1280px] divide-y divide-[#26365f] px-5 py-5 text-center sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:px-8 lg:px-12"><div class="py-3"><p class="text-3xl font-extrabold text-amber-400"><%= stats.memberCount %> Approved Members</p><p class="mt-1 text-xs font-medium text-slate-400">VERIFIED PRACTITIONERS</p></div><div class="py-3"><p class="text-3xl font-extrabold text-amber-400"><%= stats.eventCount %> Events Hosted</p><p class="mt-1 text-xs font-medium text-slate-400">KNOWLEDGE &amp; ASSEMBLY FORUMS</p></div><div class="py-3"><p class="text-3xl font-extrabold text-amber-400"><%= stats.registrationCount %> Event Registrations</p><p class="mt-1 text-xs font-medium text-slate-400">ACTIVE ENGAGED ATTENDEES</p></div></div></section>

  <section class="mx-auto grid max-w-[1280px] items-center gap-12 px-5 py-24 sm:px-8 lg:grid-cols-2 lg:px-12">
    <div class="relative flex aspect-[4/2.55] items-center justify-center overflow-hidden rounded-2xl bg-[radial-gradient(circle_at_center,#095b95_0%,#052d59_32%,#071a38_68%,#061126_100%)]"><div class="absolute h-[68%] w-[52%] rounded-full border border-cyan-300/50 shadow-[0_0_0_20px_rgba(14,116,144,.15),0_0_0_48px_rgba(8,145,178,.08)]"></div><div class="absolute h-[42%] w-[72%] rounded-full border border-cyan-300/30"></div><img src="<%= locals.logoUrl || '/img/default-logo.svg' %>" alt="JPSME" class="relative h-28 w-28 object-contain opacity-90 sm:h-40 sm:w-40"><p class="absolute rounded bg-[#0d3970]/90 px-4 py-2 text-center text-sm font-bold leading-4 text-white">Building tomorrow's mechanical<br>engineers, together.</p></div>
    <div><h2 class="text-4xl font-extrabold leading-tight sm:text-5xl">Advancing Mechanical<br>Excellence</h2><p class="mt-6 max-w-xl leading-7 text-slate-400">The Junior Philippine Society of Mechanical Engineers (JPSME) is the leading national student guild dedicated to bridging academic training with professional reality. Through country-wide conventions, continuous development courses, and peer networks, we pave the way for successful professional licensure and career-long growth.</p><p class="mt-7 border-l-4 border-amber-400 pl-3 font-bold">&quot;Building tomorrow's mechanical engineers, together.&quot;</p><a href="/register" class="mt-7 inline-block rounded-lg bg-amber-400 px-6 py-3.5 text-sm font-extrabold text-[#071126] hover:bg-amber-300">Become a Member</a></div>
  </section>

  <section class="border-y border-[#15274e] bg-[#111b3a] px-5 py-24 sm:px-8 lg:px-12"><div class="mx-auto max-w-[1280px] text-center"><h2 class="text-3xl font-extrabold sm:text-4xl">What You Can Do Here</h2><p class="mx-auto mt-3 max-w-xl text-slate-400">Experience seamless onboarding to the most robust student engineering collective in the country.</p><div class="mt-12 grid gap-5 text-left sm:grid-cols-2 xl:grid-cols-4"><% const benefits = [['Create an Account', 'Sign up once with your educational or early career details to pre-validate your regional chapter association.'], ['Get Approved', 'Our local university or national organization administrators verify and confirm your active membership status.'], ['One-Click Register', 'No repetitive forms. Your verified profile details instantly sign you up for key seminars and national events.'], ['Track Registrations', 'Manage event certificates, chapter involvement, and professional metrics straight from your unified dashboard.']]; benefits.forEach((benefit, index) => { %><article class="rounded-2xl border border-[#263b70] bg-[#111b3a] p-8"><span class="flex h-10 w-10 items-center justify-center rounded-full bg-amber-400 font-extrabold text-[#0a1430]"><%= index + 1 %></span><h3 class="mt-5 text-xl font-bold"><%= benefit[0] %></h3><p class="mt-4 text-sm leading-6 text-slate-400"><%= benefit[1] %></p></article><% }) %></div></div></section>

  <section class="mx-auto max-w-[1280px] px-5 py-24 sm:px-8 lg:px-12"><div class="mb-10 flex flex-col justify-between gap-5 sm:flex-row sm:items-end"><div><h2 class="text-3xl font-extrabold sm:text-4xl">Upcoming Events &amp; Assemblies</h2><p class="mt-3 text-slate-400">Stay updated on professional growth opportunities, symposia, and network assemblies.</p></div><a href="/events" class="inline-flex w-fit rounded-lg border border-amber-400 px-6 py-3 text-sm font-bold text-amber-400 hover:bg-amber-400 hover:text-[#071126]">View All Events</a></div><% if (displayEvents.length === 0) { %><div class="rounded-2xl border border-[#263b70] p-8 text-slate-400">No upcoming events right now. Check back soon.</div><% } else { %><div class="grid gap-6 lg:grid-cols-3"><% displayEvents.forEach(event => { %><article class="overflow-hidden rounded-2xl border border-[#263b70] bg-[#111b3a]"><div class="flex h-48 items-center justify-center overflow-hidden bg-[radial-gradient(circle_at_center,#164d79,#0b1d3b_68%)]"><% if (event.imageUrl) { %><img src="<%= event.imageUrl %>" alt="" class="h-full w-full object-cover"><% } else { %><img src="<%= locals.logoUrl || '/img/default-logo.svg' %>" alt="" class="h-24 w-24 object-contain opacity-75"><% } %></div><div class="p-6"><div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-slate-400"><span class="rounded bg-[#203666] px-2 py-1 font-bold text-amber-400"><%= new Date(event.startDate).toLocaleDateString('en-US', { month: 'long', day: '2-digit', year: 'numeric' }) %></span><span><%= event.location || (event.modality === 'ONLINE' ? 'Interactive Online Event' : 'Venue to be announced') %></span></div><h3 class="mt-5 min-h-[3.5rem] text-xl font-bold leading-tight"><%= event.title %></h3><p class="mt-4 min-h-[4.5rem] text-sm leading-6 text-slate-400"><%= event.description || 'Join JPSME members for this upcoming professional development opportunity.' %></p><a href="/events/<%= event.id %>" class="mt-5 block rounded-lg bg-amber-400 px-4 py-3 text-center text-sm font-extrabold text-[#071126] hover:bg-amber-300">Register Now</a></div></article><% }) %></div><% } %></section>

  <section class="border-y border-[#26365f] bg-[radial-gradient(circle_at_12%_30%,#201447_0%,transparent_32%),linear-gradient(105deg,#0b0924,#0a1028)] px-5 py-28 text-center sm:px-8"><h2 class="text-4xl font-extrabold sm:text-5xl">Join the JPSME Community</h2><p class="mx-auto mt-6 max-w-2xl text-lg text-slate-400">Advancing excellence in mechanical engineering, together. Secure your membership to access certifications, resources, and nation-wide assemblies.</p><a href="/register" class="mt-8 inline-flex rounded-lg bg-amber-400 px-8 py-4 font-extrabold text-[#071126] hover:bg-amber-300">Be a Member Now <span class="ml-1 text-lg">&rarr;</span></a></section>

  <% if (sponsors && sponsors.length) { %><section class="border-b border-[#26365f] bg-[#101934] px-5 py-16 text-center sm:px-8"><p class="text-xs font-bold tracking-[.2em] text-amber-400">OUR SPONSORS</p><h2 class="mt-3 text-3xl font-extrabold">Partners in Engineering Excellence</h2><div class="mx-auto mt-10 flex max-w-5xl flex-wrap items-center justify-center gap-6"><% sponsors.forEach(sponsor => { %><a href="<%= sponsor.websiteUrl || '#' %>" <%= sponsor.websiteUrl ? 'target="_blank" rel="noopener"' : '' %> class="flex h-36 w-48 flex-col items-center justify-center rounded-xl border border-[#263b70] bg-[#080f29] p-5 transition hover:border-amber-400"><img src="<%= sponsor.logoUrl %>" alt="<%= sponsor.name.toUpperCase() %>" class="max-h-20 max-w-full object-contain"><span class="mt-3 text-sm font-bold text-white"><%= sponsor.name.toUpperCase() %></span></a><% }) %></div></section><% } %>
</div>
