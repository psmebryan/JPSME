<%
const feePhp = (feeCentavos / 100).toFixed(2);
const surchargePhp = ((locals.surchargeCentavos || 0) / 100).toFixed(2);
const totalPhp = ((feeCentavos + (locals.surchargeCentavos || 0)) / 100).toFixed(2);
const payButtonStatuses = ['FAILED', 'EXPIRED', 'CANCELLED', 'REFUNDED'];
const canPay = !payment || payment.status === 'PENDING' || payButtonStatuses.includes(payment.status);
%>
<div class="max-w-lg mx-auto">
  <section class="-mx-4 -mt-12 mb-10 border-b border-[#26365f] bg-[radial-gradient(circle_at_14%_25%,#1c1442_0,transparent_35%),#080f29] px-4 py-14 sm:-mx-6 sm:px-6">
    <div class="mx-auto max-w-lg"><h1 class="text-3xl font-extrabold">Membership Payment</h1></div>
  </section>

  <div class="rounded-2xl border border-gray-200 bg-white shadow-sm overflow-hidden">
    <div class="bg-indigo-950 px-6 py-5 text-white">
      <h2 class="text-lg font-bold">JPSME Membership Registration</h2>
    </div>

    <div class="p-6 md:p-8 space-y-6">
      <% if (payment && payment.status === 'PAID') { %>
        <div class="text-center py-4">
          <div class="text-4xl mb-3">&#10003;</div>
          <h3 class="text-xl font-bold text-green-700 mb-1">Payment Successful</h3>
          <p class="text-gray-600 mb-4">Your membership fee has been received. An admin will review and approve your account shortly.</p>
          <p class="text-2xl font-extrabold text-gray-900">&#8369;<%= (payment.amount / 100).toFixed(2) %></p>
          <p class="text-sm text-gray-500 mt-1"><%= payment.paidAt ? new Date(payment.paidAt).toLocaleString() : '' %></p>
        </div>
      <% } else if (payment && payment.status === 'PROCESSING') { %>
        <div class="text-center py-4">
          <div class="text-4xl mb-3">&#8987;</div>
          <h3 class="text-xl font-bold text-amber-700 mb-1">Payment Processing</h3>
          <p class="text-gray-600">We're waiting for confirmation from the payment provider. Please do not make another payment.</p>
        </div>
      <% } else { %>
        <div>
          <p class="text-sm text-gray-500 mb-1">Registration Fee</p>
          <p class="text-3xl font-extrabold text-gray-900">&#8369;<%= totalPhp %></p>
          <% if (locals.surchargeCentavos > 0) { %>
            <p class="text-xs text-gray-400 mt-1">&#8369;<%= feePhp %> membership fee + &#8369;<%= surchargePhp %> payment processing fee</p>
          <% } %>
        </div>

        <% if (payment && payButtonStatuses.includes(payment.status)) { %>
          <p class="rounded-md bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3">
            Your last payment attempt was <strong><%= payment.status.toLowerCase() %></strong>. You can try again below.
          </p>
        <% } %>

        <div>
          <p class="text-sm font-medium text-gray-700 mb-2">Payment Method</p>
          <div class="flex items-center gap-2 rounded-md border border-gray-300 px-4 py-3 bg-gray-50 w-fit">
            <span class="font-semibold text-sky-700">GCash</span>
          </div>
        </div>

        <button id="pay-now-btn" class="w-full bg-amber-400 text-indigo-950 font-bold py-3 rounded-md hover:bg-amber-300 disabled:opacity-60 disabled:cursor-not-allowed">
          Continue to Payment
        </button>

        <p class="text-xs text-gray-500 text-center">
          Your payment is processed securely through our payment provider. JPSME does not store your GCash credentials, MPIN, or OTP.
        </p>
      <% } %>
    </div>
  </div>
</div>

<script src="/js/payment.js"></script>
