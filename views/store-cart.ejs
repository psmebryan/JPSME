<%#
  The buyer's cart at today's prices, then how to receive it: delivery (a
  saved address or a new one, with the fee for its zone) or pickup (one of the
  open pickup points). Checkout holds the stock for holdMinutes and opens
  PayMongo. The server checks every price, stock level, address rule and fee
  again at checkout; this page only previews them.
%>
<% const peso = (c) => '₱' + (c / 100).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); %>
<nav class="mb-6 flex items-center gap-2 text-sm text-slate-400"><a href="/store" class="hover:text-amber-300">Store</a><span>&rsaquo;</span><span class="text-slate-300">Your cart</span></nav>
<h1 class="mb-6 text-3xl font-bold text-white">Your cart</h1>

<% if (openOrder) { %>
  <div class="mb-6 rounded-xl border border-amber-400/40 bg-amber-400/10 px-4 py-3 text-sm text-amber-100" data-open-order>
    You have an unpaid order, <strong><%= openOrder.orderNumber %></strong>. <a href="/store/orders/<%= openOrder.orderNumber %>" class="font-semibold text-amber-300 underline">Pay or cancel it</a> before checking out again.
  </div>
<% } %>

<% if (!cart.items.length) { %>
  <div class="rounded-2xl border border-dashed border-[#263b70] p-10 text-center text-slate-400">Your cart is empty. <a href="/store" class="text-amber-400 hover:underline">Browse the Store</a></div>
<% } else { %>
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_21rem]" id="store-cart" data-subtotal="<%= cart.subtotal %>">
    <div class="min-w-0 space-y-6">
      <ul class="divide-y divide-[#263b70] rounded-2xl border border-[#263b70] bg-[#111b3a]">
        <% cart.items.forEach((i) => { %>
          <%# On a phone: photo and name on top, quantity / total / Remove below. %>
          <li class="flex flex-wrap items-center gap-x-4 gap-y-3 p-4" data-line="<%= i.variantId %>">
            <div class="flex min-w-0 basis-full items-center gap-4 sm:basis-0 sm:flex-1">
              <div class="h-16 w-16 shrink-0 overflow-hidden rounded-lg bg-[#0b1430]"><% if (i.photo) { %><img src="<%= i.photo %>" alt="" class="h-full w-full object-cover"><% } %></div>
              <div class="min-w-0 flex-1">
                <a href="/store/products/<%= i.productId %>" class="break-words font-semibold text-white hover:text-amber-300"><%= i.productName %></a>
                <p class="text-sm text-slate-400"><%= i.label %> · <%= i.unitPrice === null ? 'price not set' : peso(i.unitPrice) + (i.priceType === 'MEMBER' ? ' member price' : '') %></p>
                <% if (i.problem) { %><p class="mt-1 text-sm font-medium text-red-400" data-problem><%= i.problem %></p><% } %>
              </div>
            </div>
            <div class="flex flex-1 items-center justify-end gap-4 sm:flex-none">
              <input type="number" inputmode="numeric" min="0" max="100" value="<%= i.quantity %>" aria-label="Quantity of <%= i.productName %> <%= i.label %>" class="mr-auto w-20 rounded-lg border border-[#263b70] bg-[#0b1430] px-3 py-2 text-white sm:mr-0" data-qty>
              <p class="text-right font-semibold tabular-nums text-white sm:w-28"><%= i.lineTotal === null ? '—' : peso(i.lineTotal) %></p>
              <button type="button" class="-m-2 p-2 text-sm text-red-400 hover:underline" data-remove>Remove</button>
            </div>
          </li>
        <% }) %>
      </ul>

      <%# ---------- how to receive it ---------- %>
      <section class="rounded-2xl border border-[#263b70] bg-[#111b3a] p-5" data-fulfilment>
        <h2 class="text-lg font-semibold text-white">How do you want to get it?</h2>
        <% if (!options.deliveryOffered && !options.pickupOffered) { %>
          <p class="mt-2 text-sm text-amber-200" data-no-fulfilment>Orders are not being taken yet: no delivery fee or pickup point has been set up. Please check back soon.</p>
        <% } else { %>
          <div class="mt-3 grid gap-3 sm:grid-cols-2" role="radiogroup">
            <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-[#263b70] p-4 has-[:checked]:border-amber-400 has-[:checked]:bg-amber-400/5 <%= options.deliveryOffered ? '' : 'opacity-50' %>">
              <input type="radio" name="fulfilment" value="DELIVERY" class="mt-1" <%= options.deliveryOffered ? '' : 'disabled' %>>
              <span><span class="block font-semibold text-white">Delivery</span><span class="block text-sm text-slate-400"><%= options.deliveryOffered ? 'Fee depends on your region' : 'Not available yet' %></span></span>
            </label>
            <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-[#263b70] p-4 has-[:checked]:border-amber-400 has-[:checked]:bg-amber-400/5 <%= options.pickupOffered ? '' : 'opacity-50' %>">
              <input type="radio" name="fulfilment" value="PICKUP" class="mt-1" <%= options.pickupOffered ? '' : 'disabled' %>>
              <span><span class="block font-semibold text-white">Pickup</span><span class="block text-sm text-slate-400"><%= options.pickupOffered ? 'Free, at a pickup point' : 'Not available yet' %></span></span>
            </label>
          </div>

          <div class="mt-5 space-y-4" data-delivery hidden>
            <% if (options.addresses.length) { %>
              <div class="space-y-2" data-saved>
                <p class="text-sm font-medium text-slate-300">Deliver to</p>
                <% options.addresses.forEach((a, i) => { %>
                  <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-[#263b70] p-3 has-[:checked]:border-amber-400">
                    <input type="radio" name="addressChoice" value="<%= a.id %>" data-region="<%= a.regionCode %>" class="mt-1" <%= i === 0 ? 'checked' : '' %>>
                    <span class="text-sm text-slate-300"><span class="font-semibold text-white"><%= a.recipientName %></span><% if (a.isDefault) { %> <span class="text-xs text-amber-300">default</span><% } %><br><%= a.lines.slice(2, 6).join(', ') %></span>
                  </label>
                <% }) %>
                <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-dashed border-[#263b70] p-3 has-[:checked]:border-amber-400">
                  <input type="radio" name="addressChoice" value="new"><span class="text-sm text-slate-300">Use a new address</span>
                </label>
              </div>
            <% } %>
            <div data-new-address <%= options.addresses.length ? 'hidden' : '' %>>
              <%- include('partials/address-form', { prefix: 'co', addressTypes, value: null }) %>
              <label class="mt-3 flex items-center gap-2 text-sm text-slate-300"><input type="checkbox" name="saveAddress" checked> Save this address for next time</label>
            </div>
            <p class="text-sm" data-zone-note></p>
            <div class="hidden rounded-xl border border-[#263b70] bg-[#0b1430] p-3 text-sm text-slate-200" data-label-preview></div>
            <label class="flex items-start gap-2 text-sm text-slate-200"><input type="checkbox" name="confirmAddress" class="mt-0.5"> This address is complete and correct</label>
          </div>

          <div class="mt-5 space-y-2" data-pickup hidden>
            <% options.pickupPoints.forEach((pt, i) => { %>
              <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-[#263b70] p-3 has-[:checked]:border-amber-400">
                <input type="radio" name="pickupPointId" value="<%= pt.id %>" class="mt-1" <%= i === 0 ? 'checked' : '' %>>
                <span class="text-sm text-slate-300"><span class="font-semibold text-white"><%= pt.name %></span><br><%= pt.address %><% if (pt.hours) { %><br><span class="text-slate-400"><%= pt.hours %></span><% } %><% if (pt.endsAt) { %><br><span class="text-xs text-amber-300">Until <%= new Date(pt.endsAt).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila', dateStyle: 'medium' }) %></span><% } %></span>
              </label>
            <% }) %>
            <p class="text-xs text-slate-400">We email you when it is ready. Bring the QR code from your order page.</p>
          </div>
        <% } %>
      </section>
    </div>

    <div class="h-fit rounded-2xl border border-[#263b70] bg-[#111b3a] p-5 lg:sticky lg:top-24">
      <dl class="space-y-2 text-sm">
        <div class="flex justify-between text-slate-300"><dt>Items</dt><dd class="tabular-nums"><%= peso(cart.subtotal) %></dd></div>
        <div class="flex justify-between text-slate-300"><dt>Delivery</dt><dd class="tabular-nums" data-delivery-fee>—</dd></div>
        <div class="flex justify-between text-slate-300"><dt>Payment processing fee</dt><dd class="tabular-nums" data-channel-fee><%= peso(cart.channelFee) %></dd></div>
        <div class="flex justify-between border-t border-[#263b70] pt-2 text-base font-bold text-white"><dt>Total</dt><dd class="tabular-nums" data-total><%= peso(cart.total) %></dd></div>
      </dl>
      <p class="mt-3 text-xs text-slate-400"><%= cart.member ? 'Member prices applied.' : 'Non-member prices.' %></p>
      <button type="button" class="mt-4 w-full rounded-lg bg-amber-400 px-4 py-3 font-semibold text-[#071126] hover:bg-amber-300 disabled:cursor-not-allowed disabled:opacity-50" data-checkout <%= cart.ready && !openOrder && (options.deliveryOffered || options.pickupOffered) ? '' : 'disabled' %>>Checkout and pay with GCash</button>
      <p class="mt-2 text-xs text-slate-400">Your items are held for <%= holdMinutes %> minutes while you pay.</p>
    </div>
  </div>
<% } %>

<script src="/js/address-form.js"></script>
<script nonce="<%= cspNonce %>">
(function () {
  const root = document.getElementById('store-cart');
  if (!root) return;
  const peso = (c) => '₱' + (c / 100).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const reload = () => window.location.reload();
  const $ = (s) => root.querySelector(s);
  const form = $('[data-address-form]');
  const delivery = $('[data-delivery]');
  const pickup = $('[data-pickup]');
  const newAddr = $('[data-new-address]');
  const zoneNote = $('[data-zone-note]');
  let addressReady = false;

  // --- quantities ---
  root.addEventListener('change', async (e) => {
    const input = e.target.closest('[data-qty]');
    if (!input) return;
    const id = input.closest('[data-line]').getAttribute('data-line');
    try { await apiFetch(`/api/store/cart/${id}`, { method: 'PUT', body: JSON.stringify({ quantity: Number(input.value) || 0 }) }); reload(); } catch (err) { showToast(err.message, 'error'); }
  });

  // --- totals preview (the server recomputes at checkout) ---
  async function preview(regionCode) {
    if (!regionCode) { $('[data-delivery-fee]').textContent = '—'; zoneNote.textContent = ''; return; }
    try {
      const res = await apiFetch(`/api/store/delivery-quote?region=${regionCode}`);
      const { quote, totals } = res.data;
      $('[data-delivery-fee]').textContent = quote.available ? peso(totals.deliveryFee) : 'Not available';
      $('[data-channel-fee]').textContent = peso(totals.channelFee);
      $('[data-total]').textContent = peso(totals.total);
      zoneNote.className = `text-sm ${quote.available ? 'text-slate-400' : 'text-amber-300'}`;
      zoneNote.textContent = quote.available ? `Delivery zone: ${quote.zoneName}` : quote.reason;
    } catch (err) { showToast(err.message, 'error'); }
  }
  async function pickupTotals() {
    try {
      const res = await apiFetch('/api/store/delivery-quote?region=');
      $('[data-delivery-fee]').textContent = 'Free';
      $('[data-channel-fee]').textContent = peso(res.data.totals.channelFee);
      $('[data-total]').textContent = peso(res.data.totals.total);
    } catch (err) { /* keep the cart's own numbers */ }
  }
  const chosenAddress = () => { const r = root.querySelector('input[name="addressChoice"]:checked'); return r ? r.value : 'new'; };
  function refreshAddressPreview() {
    const choice = chosenAddress();
    if (choice !== 'new') { preview(root.querySelector(`input[name="addressChoice"][value="${choice}"]`).getAttribute('data-region')); return; }
    preview(form ? form.querySelector('[data-level="region"]').value : '');
  }

  // --- delivery or pickup ---
  root.querySelectorAll('input[name="fulfilment"]').forEach((r) => r.addEventListener('change', async () => {
    const way = r.value;
    delivery.hidden = way !== 'DELIVERY';
    pickup.hidden = way !== 'PICKUP';
    if (way === 'DELIVERY') {
      if (form && !addressReady) { addressReady = true; await window.AddressForm.init(form); }
      refreshAddressPreview();
    } else {
      pickupTotals();
    }
  }));
  root.querySelectorAll('input[name="addressChoice"]').forEach((r) => r.addEventListener('change', async () => {
    newAddr.hidden = chosenAddress() !== 'new';
    if (chosenAddress() === 'new' && form && !addressReady) { addressReady = true; await window.AddressForm.init(form); }
    refreshAddressPreview();
  }));
  if (form) form.addEventListener('regionchange', (e) => { if (chosenAddress() === 'new') preview(e.detail.regionCode); });

  // The new address as the courier's label will read it, before paying.
  const labelBox = $('[data-label-preview]');
  function showLabel() {
    if (!form || chosenAddress() !== 'new') { labelBox.classList.add('hidden'); return; }
    const v = window.AddressForm.read(form);
    const opt = (level) => { const s = form.querySelector(`[data-level="${level}"]`); return s && s.value && s.value !== '__none' ? s.options[s.selectedIndex].text : ''; };
    const lines = [
      v.recipientName, [v.mobile, v.altMobile].filter(Boolean).join(' / '),
      [v.houseNo, v.building, v.street].filter(Boolean).join(', '),
      [v.subdivision, opt('barangay') && `Brgy. ${opt('barangay')}`].filter(Boolean).join(', '),
      [opt('city'), opt('province'), v.zip].filter(Boolean).join(', '), opt('region'),
      v.landmark && `Landmark: ${v.landmark}`, v.notes && `Notes: ${v.notes}`,
    ].filter(Boolean);
    labelBox.textContent = '';
    lines.forEach((l, i) => { const d = document.createElement('div'); d.textContent = l; if (i === 0) d.className = 'font-semibold'; labelBox.appendChild(d); });
    labelBox.classList.toggle('hidden', lines.length < 3);
  }
  if (form) { form.addEventListener('input', showLabel); form.addEventListener('change', showLabel); }
  root.querySelectorAll('input[name="addressChoice"]').forEach((r) => r.addEventListener('change', showLabel));

  // --- checkout ---
  root.addEventListener('click', async (e) => {
    if (e.target.closest('[data-remove]')) {
      const id = e.target.closest('[data-line]').getAttribute('data-line');
      try { await apiFetch(`/api/store/cart/${id}`, { method: 'DELETE' }); reload(); } catch (err) { showToast(err.message, 'error'); }
      return;
    }
    const btn = e.target.closest('[data-checkout]');
    if (!btn) return;
    const way = (root.querySelector('input[name="fulfilment"]:checked') || {}).value;
    if (!way) { showToast('Choose delivery or pickup first.', 'error'); return; }
    const body = { fulfilment: way };
    if (way === 'DELIVERY') {
      const choice = chosenAddress();
      if (choice === 'new') {
        body.address = window.AddressForm.read(form);
        body.saveAddress = root.querySelector('input[name="saveAddress"]').checked;
      } else {
        body.addressId = Number(choice);
      }
      body.confirmAddress = root.querySelector('input[name="confirmAddress"]').checked;
      if (!body.confirmAddress) { showToast('Tick "This address is complete and correct" first.', 'error'); return; }
    } else {
      const pt = root.querySelector('input[name="pickupPointId"]:checked');
      if (!pt) { showToast('Choose a pickup point.', 'error'); return; }
      body.pickupPointId = Number(pt.value);
    }
    btn.disabled = true;
    try {
      const res = await apiFetch('/api/store/checkout', { method: 'POST', body: JSON.stringify(body) });
      window.location.href = res.data.checkoutUrl;
    } catch (err) {
      showToast(err.message, 'error');
      if (err.data && err.data.orderNumber) setTimeout(() => { window.location.href = `/store/orders/${err.data.orderNumber}`; }, 1200);
      else btn.disabled = false;
    }
  });
}());
</script>

<%- include('partials/store-feedback') %>
