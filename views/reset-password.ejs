<%#
  Two pages in one, chosen by the link rather than by the URL.

  A RESET: somebody who has an account and lost the password. Asks for a new
  password and nothing else.

  An ACTIVATION: an account created for somebody by a spreadsheet import, which
  has never been signed in to. Asks for a password AND their organization,
  because an import leaves that blank on purpose — the member knows their own
  school unit and the admin importing 60 rows is guessing.

  Which one it is comes from the ACCOUNT, returned by the check endpoint. It is
  deliberately not a flag in the link: whether submitting this form also verifies
  an address and approves an account is not a decision to take from a query
  string somebody is holding.

  Either way the link is checked BEFORE the form appears. Asking somebody to
  choose and confirm a password and only then telling them the link expired is
  the kind of thing that makes people give up on an account entirely.
%>
<div class="max-w-md mx-auto bg-white border border-gray-200 rounded-lg p-8 shadow-sm" data-reset>
  <div class="mb-6 flex flex-col items-center text-center">
    <img src="<%= locals.logoUrl || '/img/default-logo.svg' %>" alt="JPSME" class="h-16 w-16 object-contain">
    <h1 class="mt-3 text-2xl font-bold" id="reset-title">Choose a new password</h1>
    <p class="mt-1 hidden text-sm text-gray-500" id="reset-subtitle"></p>
  </div>

  <p id="reset-checking" class="text-sm text-gray-500 text-center">Checking your link&hellip;</p>

  <%# Dead link. Offers the one action that helps rather than a bare error. %>
  <div id="reset-bad" hidden>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4">
      <p class="text-sm font-semibold text-red-800">This link cannot be used</p>
      <p class="mt-1 text-sm text-red-700" id="reset-bad-msg"></p>
    </div>
    <a href="/forgot-password"
       class="mt-4 block w-full rounded-md bg-indigo-600 py-2 text-center text-white hover:bg-indigo-700">
      Request a new link
    </a>
  </div>

  <form id="reset-form" hidden class="space-y-4">
    <input type="hidden" id="uid" value="<%= locals.uid || '' %>">
    <input type="hidden" id="token" value="<%= locals.token || '' %>">

    <div>
      <label class="block text-sm font-medium mb-1" for="password">
        <span id="password-label">New password</span>
      </label>
      <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password"
        class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
      <p class="mt-1 text-xs text-gray-500">At least 8 characters.</p>
    </div>
    <div>
      <label class="block text-sm font-medium mb-1" for="confirm">Confirm password</label>
      <input type="password" id="confirm" name="confirm" required minlength="8" autocomplete="new-password"
        class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>

    <%#
      Activation only. The element ids below are the ones public/js/auth.js
      already binds on the register page — search, cascade, hidden value and
      the confirmation panel — so the picker is reused rather than rebuilt.
      auth.js guards every block on its elements being present, so loading it
      here brings the picker and nothing else.
    %>
    <div id="activation-org" hidden class="border-t border-gray-200 pt-4">
      <div class="relative mb-3">
        <label class="block text-sm font-medium mb-1" for="organization-search">
          Your school or organization
        </label>
        <input id="organization-search" type="text" autocomplete="off"
          placeholder="Type your school, unit, chapter or cluster&hellip;"
          class="w-full border border-gray-300 rounded-md px-3 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <div id="organization-results"
             class="hidden absolute z-20 mt-1 w-full max-h-64 overflow-y-auto rounded-md border border-gray-300 bg-white shadow-lg"></div>
        <p class="text-xs text-gray-500 mt-1">Or choose it step by step below.</p>
      </div>

      <div id="organization-cascade" class="space-y-3"></div>
      <input type="hidden" id="organizationId" name="organizationId">

      <div id="organization-selected" class="hidden mt-3 rounded-md border border-indigo-200 bg-indigo-50 p-3">
        <p class="text-[11px] font-semibold uppercase tracking-wider text-indigo-700 mb-1">Your organization</p>
        <p class="text-sm font-semibold text-indigo-950" id="organization-selected-name"></p>
        <p class="text-xs text-gray-500 mt-0.5" id="organization-selected-path"></p>
      </div>

      <p class="text-xs text-gray-500 mt-2">
        Choose as far down as your own organization goes. If your branch has no
        cluster or chapter, that step simply won't appear.
      </p>
    </div>

    <button type="submit" id="reset-submit"
            class="w-full bg-indigo-600 text-white py-2 rounded-md hover:bg-indigo-700 disabled:opacity-50">
      Change my password
    </button>
    <p class="text-xs text-gray-500" id="reset-note">
      You will be signed out on every device and will need to sign in again with the new password.
    </p>
  </form>

  <div id="reset-done" hidden class="rounded-lg border border-green-200 bg-green-50 p-4">
    <p class="text-sm font-semibold text-green-800" id="done-title">Password changed</p>
    <p class="mt-1 text-sm text-green-700" id="done-msg">You can sign in with your new password now.</p>
    <a href="/login" class="mt-3 block w-full rounded-md bg-green-600 py-2 text-center text-white hover:bg-green-700">
      Go to sign in
    </a>
  </div>
</div>

<%# Brings the organization picker. Every block in it is guarded on its own
    elements, so on this page it wires the picker and no more. %>
<script src="/js/auth.js"></script>
<script nonce="<%= cspNonce %>">
// apiFetch and showToast live in /js/api.js, which the layout loads at the END
// of <body> — after this page's markup and after this script. So nothing here
// may touch them while the document is still parsing.
//
// That is not theoretical: this page called its link check immediately and died
// with "apiFetch is not defined", which it then displayed to the reader as
// "This link cannot be used" — a real link reported as broken by a bug in the
// page that was checking it.
//
// readyState rather than a bare DOMContentLoaded listener: if this ever moves
// somewhere that runs later, a listener for an event that has already fired
// never runs at all, and the page would silently do nothing instead.
function onReady(fn) {
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn);
  else fn();
}
onReady(function () {
  const uid = document.getElementById('uid').value;
  const token = document.getElementById('token').value;
  const checking = document.getElementById('reset-checking');
  const bad = document.getElementById('reset-bad');
  const form = document.getElementById('reset-form');
  const done = document.getElementById('reset-done');
  const orgBlock = document.getElementById('activation-org');
  const orgHidden = document.getElementById('organizationId');

  let isActivation = false;

  function showBad(message) {
    checking.hidden = true;
    form.hidden = true;
    document.getElementById('reset-bad-msg').textContent = message;
    bad.hidden = false;
  }

  // An activation is a welcome, not a recovery, and the page should not open by
  // talking about a password they never had.
  function dressAsActivation(firstName) {
    document.getElementById('reset-title').textContent = 'Activate your account';
    const sub = document.getElementById('reset-subtitle');
    sub.textContent = firstName
      ? `Welcome, ${firstName}. Choose a password and tell us where you study.`
      : 'Choose a password and tell us where you study.';
    sub.hidden = false;
    document.getElementById('password-label').textContent = 'Choose a password';
    document.getElementById('reset-submit').textContent = 'Activate my account';
    document.getElementById('reset-note').textContent =
      'Your password is yours alone — nobody at JPSME can see it.';
    orgBlock.hidden = false;
  }

  async function check() {
    if (!uid || !token) {
      showBad('This link is missing part of its address. Open it straight from the email, or request a new one.');
      return;
    }
    try {
      const res = await apiFetch(
        `/api/auth/reset-password/check?uid=${encodeURIComponent(uid)}&token=${encodeURIComponent(token)}`
      );
      if (!res.data.valid) { showBad(res.message); return; }

      isActivation = Boolean(res.data.isActivation);
      if (isActivation) {
        dressAsActivation(res.data.firstName);
        // Pre-fill if the import happened to name one. auth.js fills the
        // cascade from this value when it is already set, and the member can
        // still change it — an admin filling that column in was guessing.
        if (res.data.organizationId && orgHidden) orgHidden.value = res.data.organizationId;
      }

      checking.hidden = true;
      form.hidden = false;
      document.getElementById('password').focus();
    } catch (err) {
      showBad(err.message);
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const password = document.getElementById('password').value;
    const confirm = document.getElementById('confirm').value;

    // Checked here as well as on the server: mistyping a password you cannot
    // see is the single most likely thing to go wrong on this form, and a round
    // trip to be told so is a round trip too many.
    if (password !== confirm) {
      showToast('The two passwords do not match', 'error');
      return;
    }
    // The server enforces this too — this is only so they are told before the
    // request rather than after it.
    if (isActivation && (!orgHidden || !orgHidden.value)) {
      showToast('Please choose your school or organization', 'error');
      document.getElementById('organization-search').focus();
      return;
    }

    const btn = document.getElementById('reset-submit');
    const label = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Saving…';
    try {
      const body = { uid: Number(uid), token, password };
      if (isActivation && orgHidden.value) body.organizationId = Number(orgHidden.value);

      const res = await apiFetch('/api/auth/reset-password', {
        method: 'POST',
        body: JSON.stringify(body),
      });

      if (res.data && res.data.activated) {
        document.getElementById('done-title').textContent = 'Your account is ready';
        document.getElementById('done-msg').textContent =
          'Sign in with your email address and the password you just chose.';
      }
      form.hidden = true;
      done.hidden = false;
    } catch (err) {
      // A link that died between the check and the submit (used in another tab,
      // or expired while the form sat open) is not a form error — it needs the
      // dead-link panel and its "request a new one" button.
      if (err.code === 'USED' || err.code === 'EXPIRED' || err.code === 'INVALID') {
        showBad(err.message);
        return;
      }
      showToast(err.message, 'error');
      btn.disabled = false;
      btn.textContent = label;
    }
  });

  check();
});
</script>
