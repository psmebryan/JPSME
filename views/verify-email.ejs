<%
/*
  Two arrivals, one page.

  The common one is a login that got the password right against an address
  that was never confirmed. The server already knows who that is, has already
  mailed the code, and can therefore ask for one thing and nothing else. That
  is the whole fix: it used to land here demanding a code the person did not
  have, with the only way to get one buried in a second card below, behind a
  retyped address and an image captcha.

  The other is somebody arriving cold — a bookmark, an old link, a browser that
  dropped the session. Nothing is known about them, so they still get an address
  field and a captcha: this is a request that will mail whatever address it is
  handed, which is exactly what the check is for. But they type that address
  once. It used to be twice, in two fields in two cards, because entering a code
  and asking for one were built as separate tasks — and anybody without a code
  had to do both.
*/
%>
<% const known = Boolean(locals.pendingEmail); %>
<%
  // A code lives three minutes. Short enough that one sitting in an inbox is
  // not a standing credential, which is the entire reason for the ring below:
  // a limit nobody can see is a limit that runs out mid-typing with no warning.
  const lifetimeMs = locals.codeLifetimeMs || 3 * 60 * 1000;
  const lifetimeMinutes = Math.max(1, Math.round(lifetimeMs / 60000));
  const countdown = known && typeof locals.expiresInMs === 'number';
%>
<div class="max-w-md mx-auto">
  <div class="bg-white border border-gray-200 rounded-lg p-6 sm:p-8 shadow-sm">
    <div id="verify-panel">
      <div class="flex flex-col items-center text-center">
        <%
          /*
            The seal inside the countdown, rather than a timer parked somewhere
            else on the page. There is one thing running out here, and putting
            the ring anywhere but around the thing you are already looking at
            means it is read second, or not at all.

            Drawn as SVG attributes (stroke-dashoffset, stroke) rather than
            inline style, because styleSrc carries a nonce and no
            'unsafe-inline' — a style attribute written from script is dropped
            with no error, which is how the hero background silently vanished.
          */
        %>
        <div class="relative h-28 w-28">
          <svg class="absolute inset-0 h-28 w-28 -rotate-90" viewBox="0 0 112 112" aria-hidden="true">
            <circle cx="56" cy="56" r="52" fill="none" stroke="#e5e7eb" stroke-width="4"></circle>
            <circle id="expiry-ring" cx="56" cy="56" r="52" fill="none" stroke="#4f46e5" stroke-width="4"
                    stroke-linecap="round" stroke-dasharray="326.7" stroke-dashoffset="0"></circle>
          </svg>
          <div class="absolute inset-0 flex items-center justify-center">
            <img src="<%= locals.logoUrl || '/img/default-logo.svg' %>" alt="JPSME" class="h-16 w-16 object-contain">
          </div>
        </div>

        <% if (countdown) { %>
          <p id="expiry-label" class="mt-3 text-sm font-semibold tabular-nums text-indigo-700"
             data-expires-in="<%= locals.expiresInMs %>" data-lifetime="<%= lifetimeMs %>">
            &nbsp;
          </p>
        <% } %>

        <h1 class="mt-2 text-2xl font-bold text-gray-900">Enter your code</h1>

        <% if (known) { %>
          <p class="mt-2 text-sm text-gray-600">
            We emailed a 6-digit code to<br>
            <span class="font-semibold text-gray-900 break-all"><%= pendingEmail %></span>
          </p>
        <% } else { %>
          <p class="mt-2 text-sm text-gray-600">
            Enter the address you registered with and the 6-digit code we emailed you.
          </p>
        <% } %>
      </div>

      <form id="verify-code-form" class="mt-6 space-y-5">
        <% if (known) { %>
          <%# Not a field. The address came from the server, and there is
              nothing here for anyone to mistype. %>
          <input type="hidden" name="email" id="verify-email-input" value="<%= pendingEmail %>">
        <% } else { %>
          <div>
            <label for="verify-email-input" class="block text-sm font-medium text-gray-700 mb-1">Email address</label>
            <input id="verify-email-input" name="email" type="email" required
                   value="<%= locals.email || '' %>"
                   autocomplete="email"
                   class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500">
          </div>
        <% } %>

        <div>
          <%
            /*
              Six boxes rather than one long field, because a six-digit code is
              six things and looking like six things is most of what makes it
              quick to type: you can see at a glance how many are left, and a
              wrong digit is one backspace rather than a re-read.

              autocomplete="one-time-code" sits on the first box only — that is
              where iOS and Android offer the code straight from the
              notification, and they fill the whole code into it, which the
              input handler below spreads across the rest. Pasting anywhere
              does the same. inputmode="numeric" brings up the number pad.
            */
          %>
          <div class="flex justify-center gap-2 sm:gap-3" id="code-boxes">
            <% for (let i = 0; i < 6; i++) { %>
              <input type="text" class="code-digit w-11 h-14 sm:w-12 sm:h-16 rounded-lg border-2 border-gray-300 bg-white text-center text-2xl font-mono font-semibold text-gray-900 focus:outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/30 transition-colors disabled:bg-gray-100 disabled:text-gray-400 disabled:border-gray-200"
                     inputmode="numeric" maxlength="1"
                     aria-label="Digit <%= i + 1 %> of 6"
                     <%# Unescaped on purpose: this is an attribute, not text.
                         Escaped, its quotes come out as &quot; and the phone
                         never recognises the field at all. %>
                     <%- i === 0 ? 'autocomplete="one-time-code"' : 'autocomplete="off"' %>>
            <% } %>
          </div>
          <%# What actually gets submitted, so the form still works if a box is
              filled by something the handlers did not anticipate. %>
          <input type="hidden" name="code" id="verify-code-input">

          <p id="expiry-note" class="mt-3 text-center text-xs text-gray-500">
            <% if (countdown) { %>
              This code is only good for <%= lifetimeMinutes %> minute<%= lifetimeMinutes === 1 ? '' : 's' %>.
            <% } else { %>
              The code expires <%= lifetimeMinutes %> minute<%= lifetimeMinutes === 1 ? '' : 's' %> after it is sent.
            <% } %>
          </p>
        </div>

        <%
          /*
            The human check, in front of the code rather than behind it.

            Six digits is a million guesses. The rate limiter caps how fast one
            address can work through them; this is what stops the attempt being
            made at all by something that can come from many. Rendered once per
            page — a session holds one challenge, so a second box would show the
            same image and spend the same answer.

            It costs something real: the challenge is single-use, so a wrong
            code spends it too. captcha.js reloads the image and clears the box
            after every submit, which is what makes the retry "read the new one"
            rather than "wonder why the right code was refused".
          */
        %>
        <%- include('partials/human-check') %>

        <button type="submit" id="verify-submit"
                class="w-full bg-indigo-600 text-white px-5 py-3 rounded-md hover:bg-indigo-700 font-medium disabled:bg-gray-300 disabled:text-gray-500 disabled:cursor-not-allowed">
          Verify my email
        </button>
      </form>

      <% if (known) { %>
        <%
          /*
            The resend that made this page worth rewriting. It sends to the
            address the server put in the session, so it needs no retyped
            address and no captcha — see resendPendingVerification in
            auth.api.js for why that is safe here and not on the public form.
          */
        %>
        <div class="mt-6 pt-5 border-t border-gray-200 text-center">
          <p id="resend-prompt" class="text-sm text-gray-600">Didn't get the code? Check your spam folder.</p>
          <form id="pending-resend-form" class="mt-2">
            <button type="submit" id="pending-resend-button"
                    data-wait-ms="<%= locals.resendWaitMs || 0 %>"
                    class="text-sm font-semibold text-indigo-600 hover:underline disabled:text-gray-400 disabled:no-underline disabled:cursor-not-allowed">
              Resend
            </button>
          </form>
          <p class="mt-4 text-xs text-gray-500">
            Wrong address?
            <a href="/login" class="text-gray-700 hover:underline">Sign in as someone else</a>
          </p>
        </div>
      <% } else { %>
        <%
          /*
            The cold resend, in the same card and sharing the field above it.

            It used to be a second card with a second email input, so somebody
            who had just typed their address to enter a code had to type the
            same address again to be sent one — two fields, one answer, and the
            second one sitting under a heading that read like a different task.

            The address is carried across in a hidden field kept in step with
            the one above (see the script). The captcha stays, and only here:
            this endpoint mails whatever address is handed to it, which is the
            one thing on the page an attacker would actually want. The signed-in
            resend has no such field and needs no such check.
          */
        %>
        <div class="mt-6 pt-5 border-t border-gray-200">
          <p class="text-sm text-gray-600">Didn't get the code?</p>

          <%# Offered first, because it is genuinely the shorter road: signing
              in sends a code by itself, with no captcha and nothing to fill
              in. Somebody who knows their password should not be reading an
              image of wobbly letters to get where they are already allowed. %>
          <p class="mt-1 text-xs text-gray-500">
            If you know your password, <a href="/login" class="text-indigo-600 hover:underline">signing in</a>
            sends one automatically &mdash; no address to type. Otherwise:
          </p>

          <form id="resend-verification-form" class="mt-3">
            <%# The address, taken from the field above rather than typed twice.
                No challenge answer: this resend no longer asks for one. See the
                route in auth.routes.js for why — it can only ever mail somebody
                who is already waiting on a code. %>
            <input type="hidden" name="email" id="carried-email" value="<%= locals.email || '' %>">
            <%- include('partials/human-check', { challenge: false }) %>
            <button type="submit" id="cold-resend-button"
                    class="w-full rounded-md border border-gray-300 bg-white px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-50 disabled:text-gray-400 disabled:cursor-not-allowed">
              Resend
            </button>
          </form>
        </div>
      <% } %>
    </div>

    <div id="verify-success" class="hidden text-center py-4">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-green-100">
        <svg class="h-6 w-6 text-green-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      <p class="mt-3 text-lg font-semibold text-gray-900">Email verified</p>
      <%# Only ever seen when the sign-in shortcut did not apply — a cold
          arrival, or a session too old to still count as proof of the
          password. Everyone else is already on their way somewhere. %>
      <p class="text-sm text-gray-600 mt-1">
        <% if (locals.paymentRequired) { %>
          Log in to complete your membership payment &mdash; an admin will review and approve your account once it's received.
        <% } else { %>
          You can log in now. Paying the membership fee is optional &mdash; you'll find it on your profile whenever you're ready.
        <% } %>
      </p>
      <a href="/login" class="inline-block mt-4 bg-indigo-600 text-white px-5 py-2.5 rounded-md hover:bg-indigo-700 font-medium">Go to login</a>
    </div>
  </div>

</div>

<script src="/js/auth.js"></script>
<script nonce="<%= cspNonce %>">
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('verify-code-form');
    if (!form) return;

    const hidden = document.getElementById('verify-code-input');
    const boxes = Array.prototype.slice.call(document.querySelectorAll('.code-digit'));
    const emailInput = document.getElementById('verify-email-input');
    const submitButton = document.getElementById('verify-submit');

    function currentCode() {
      return boxes.map((b) => b.value).join('');
    }

    // A button that counts itself back to life: 60, 59, 58 … then clickable
    // again. Used by both resend buttons, because a wait that is enforced but
    // not shown is indistinguishable from a button that does nothing.
    function startableCooldown(button, label) {
      let remaining = 0;
      let ticker = null;

      function render() {
        button.disabled = remaining > 0;
        button.textContent = remaining > 0 ? `${label} in ${remaining}s` : label;
      }

      function start(ms) {
        remaining = Math.ceil((ms || 0) / 1000);
        clearInterval(ticker);
        render();
        if (remaining <= 0) return;
        ticker = setInterval(() => {
          remaining -= 1;
          render();
          if (remaining <= 0) clearInterval(ticker);
        }, 1000);
      }

      return { start };
    }

    function sync() {
      hidden.value = currentCode();
    }

    // Puts one or more digits in starting at `from`, moves the caret to the
    // first empty box after them, and submits once all six are there. One
    // function for typing, pasting and phone autofill, because all three are
    // the same thing: some digits arrived at some box.
    function place(from, digits) {
      let i = from;
      for (let d = 0; d < digits.length && i < boxes.length; d += 1, i += 1) {
        boxes[i].value = digits[d];
      }
      sync();
      const caret = Math.min(i, boxes.length - 1);
      boxes[caret].focus();
      boxes[caret].select();

      if (hidden.value.length !== boxes.length) return;

      // Six digits used to mean "send it". It cannot now: there is a check in
      // front of the code, and submitting with it blank would fail every time
      // and spend a code doing it. So the last digit hands over to whatever is
      // still unanswered instead of guessing that nothing is.
      const challenge = document.querySelector('[name="challengeAnswer"]');
      if (challenge && !challenge.value.trim()) {
        challenge.focus();
        return;
      }
      submit();
    }

    boxes.forEach((box, index) => {
      box.addEventListener('input', () => {
        const digits = box.value.replace(/[^0-9]/g, '');
        box.value = '';
        if (!digits) { sync(); return; }
        place(index, digits);
      });

      box.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !box.value && index > 0) {
          // Reaching back a box on an empty one, so holding backspace clears
          // the code instead of stopping dead at the first empty field.
          e.preventDefault();
          boxes[index - 1].value = '';
          sync();
          boxes[index - 1].focus();
        } else if (e.key === 'ArrowLeft' && index > 0) {
          e.preventDefault();
          boxes[index - 1].focus();
        } else if (e.key === 'ArrowRight' && index < boxes.length - 1) {
          e.preventDefault();
          boxes[index + 1].focus();
        }
      });

      box.addEventListener('paste', (e) => {
        e.preventDefault();
        const text = (e.clipboardData || window.clipboardData).getData('text') || '';
        place(index, text.replace(/[^0-9]/g, '').slice(0, boxes.length - index));
      });

      // So typing over a filled box replaces it rather than being ignored by
      // maxlength.
      box.addEventListener('focus', () => box.select());
    });

    function clearBoxes() {
      boxes.forEach((b) => { b.value = ''; });
      sync();
      boxes[0].focus();
    }

    // Straight to the code when the address is already settled, which is now
    // the usual case — nobody should have to click into the first box.
    if (!emailInput || emailInput.type === 'hidden' || emailInput.value) {
      boxes[0].focus();
    } else {
      emailInput.focus();
    }

    function submit() {
      if (form.requestSubmit) form.requestSubmit();
      else form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
    }

    // --- how long this code has left ----------------------------------------
    //
    // Counted from a duration the server sent, never from a timestamp: a phone
    // whose clock is ten minutes out would otherwise count down to a moment
    // that has already passed. The server is still the one that decides — this
    // only shows what it will decide, early enough to do something about it.
    const ring = document.getElementById('expiry-ring');
    const label = document.getElementById('expiry-label');
    const note = document.getElementById('expiry-note');
    const resendPrompt = document.getElementById('resend-prompt');
    const CIRCUMFERENCE = 2 * Math.PI * 52;

    let deadline = null;
    let lifetime = 0;
    let ticker = null;
    let expired = false;

    function clock(ms) {
      const total = Math.max(0, Math.ceil(ms / 1000));
      return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;
    }

    function paintRing(fraction, color) {
      if (!ring) return;
      // An SVG presentation attribute, not a style property — see the comment
      // on the markup above.
      ring.setAttribute('stroke-dashoffset', String(CIRCUMFERENCE * (1 - fraction)));
      ring.setAttribute('stroke', color);
    }

    function onExpired() {
      expired = true;
      clearInterval(ticker);
      paintRing(0, '#e5e7eb');

      boxes.forEach((b) => { b.value = ''; b.disabled = true; });
      sync();
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = 'Code expired';
      }
      if (label) {
        label.textContent = 'Code expired';
        label.className = 'mt-3 text-sm font-semibold text-red-600';
      }
      // The note and the prompt both change, because at this point there is
      // exactly one thing left to do and both should say it.
      if (note) note.textContent = 'Codes last a few minutes. Send yourself a new one below.';
      if (resendPrompt) resendPrompt.textContent = 'That code has expired.';
    }

    function tick() {
      const left = deadline - Date.now();
      if (left <= 0) return onExpired();

      const fraction = lifetime > 0 ? Math.min(1, left / lifetime) : 0;
      // Amber under a minute, red under twenty seconds. The colour is doing
      // the same job as the number for anyone not reading it closely.
      const color = left < 20000 ? '#dc2626' : (left < 60000 ? '#d97706' : '#4f46e5');
      paintRing(fraction, color);

      if (label) {
        label.textContent = `Expires in ${clock(left)}`;
        label.className = `mt-3 text-sm font-semibold tabular-nums ${
          left < 20000 ? 'text-red-600' : (left < 60000 ? 'text-amber-600' : 'text-indigo-700')
        }`;
      }
      return undefined;
    }

    function startCountdown(remainingMs, lifetimeMs) {
      expired = false;
      lifetime = lifetimeMs || remainingMs;
      deadline = Date.now() + remainingMs;

      boxes.forEach((b) => { b.disabled = false; });
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = 'Verify my email';
      }

      clearInterval(ticker);
      tick();
      // Four times a second, so the ring drains smoothly rather than jumping
      // once a second; the label only redraws text that changed.
      ticker = setInterval(tick, 250);
    }

    if (label && label.dataset.expiresIn) {
      startCountdown(Number(label.dataset.expiresIn), Number(label.dataset.lifetime));
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (expired) {
        showToast('That code has expired. Send yourself a new one.', 'error');
        return;
      }

      const email = emailInput ? emailInput.value.trim() : '';
      const code = hidden.value.trim();

      if (code.length !== boxes.length) {
        showToast('Enter all six digits of your code.', 'error');
        boxes[Math.max(0, code.length)].focus();
        return;
      }

      await withPending(form, 'Verifying...', async () => {
        try {
          const res = await apiFetch('/api/auth/verify-code', {
            method: 'POST',
            body: JSON.stringify({ email, code }),
          });
          showToast(res.message);
          clearInterval(ticker);

          // Straight on to wherever the server says, which is the login page
          // with the address already filled in.
          if (res.data && res.data.redirectTo) {
            window.location.href = res.data.redirectTo;
            return;
          }

          // Only reachable if a response ever arrives without somewhere to go.
          // The verification still happened, so say so rather than stranding
          // them on a form that now does nothing.
          document.getElementById('verify-panel').classList.add('hidden');
          document.getElementById('verify-success').classList.remove('hidden');
        } catch (err) {
          showToast(err.message, 'error');
          // Cleared rather than left in place: the next attempt is a fresh
          // reading of the email, and a wrong code sitting in the boxes invites
          // resubmitting the same wrong thing.
          clearBoxes();
        }
      });
    });

    // --- the cold resend shares the field above it --------------------------
    //
    // public/js/auth.js owns the submit itself; all this does is make sure the
    // address is in the form by the time it reads it, so nobody types it twice.
    const coldResend = document.getElementById('resend-verification-form');
    const carried = document.getElementById('carried-email');

    if (coldResend && carried && emailInput) {
      // Copies the typed address into the hidden field the resend submits.
      // Both value and defaultValue: auth.js calls form.reset() after a
      // successful send and reset restores defaultValue, so setting only the
      // value would empty it after the first resend and fail the second with
      // nothing on screen to explain it.
      const carry = () => {
        const value = String(emailInput.value || '').trim();
        carried.value = value;
        carried.defaultValue = value;
      };
      emailInput.addEventListener('input', carry);
      carry();

      const coldButton = document.getElementById('cold-resend-button');
      if (coldButton) {
        const coldCooldown = startableCooldown(coldButton, 'Resend');

        // On the button's click rather than the form's submit: auth.js
        // registered its submit handler first and would otherwise send an
        // empty address before this ran. Cancelling the click cancels the
        // submit that would have followed it.
        coldButton.addEventListener('click', (e) => {
          carry();
          const stop = (message, focus) => {
            e.preventDefault();
            e.stopPropagation();
            showToast(message, 'error');
            if (focus) focus.focus();
          };

          if (!carried.value) return stop('Enter your email address above first.', emailInput);

          // The same minute the signed-in resend waits. Enforced here because
          // this endpoint answers everybody identically to avoid confirming an
          // address exists, so it cannot tell the page how long to wait.
          coldCooldown.start(60000);
          return undefined;
        });
      }
    }

    // --- resend, with the wait shown rather than enforced silently ----------
    const resendForm = document.getElementById('pending-resend-form');
    const resendButton = document.getElementById('pending-resend-button');

    if (resendForm && resendButton) {
      const cooldown = startableCooldown(resendButton, resendButton.textContent.trim());
      const startCooldown = (ms) => cooldown.start(ms);

      // The server sent the code while the login request was still in flight,
      // so some of the wait is already spent by the time this page paints.
      startCooldown(Number(resendButton.dataset.waitMs || 0));

      resendForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (resendButton.disabled) return;

        // Started after withPending returns, not inside it: withPending puts
        // the button's own label and enabled state back when it finishes, so a
        // cooldown begun in there would be wiped a moment later.
        let cooldown = null;

        await withPending(resendForm, 'Sending...', async () => {
          try {
            const res = await apiFetch('/api/auth/verification/resend', { method: 'POST' });
            showToast(res.message);
            clearBoxes();
            cooldown = (res.data && res.data.cooldownMs) || 60000;

            // A new code means a new deadline, so the ring starts over rather
            // than sitting at whatever the dead one left behind.
            if (res.data && res.data.expiresInMs) {
              startCountdown(res.data.expiresInMs, Number((label && label.dataset.lifetime) || res.data.expiresInMs));
              if (note) note.textContent = 'Enter the newest code — the earlier one no longer works.';
              if (resendPrompt) resendPrompt.textContent = "Didn't get it? Check your spam folder.";
            }
          } catch (err) {
            showToast(err.message, 'error');
            // The session that vouched for the password is gone, so there is
            // nothing this page can do for them any more — only the login form
            // can start it again.
            if (err.code === 'NO_PENDING_VERIFICATION') {
              setTimeout(() => { window.location.href = '/login'; }, 1500);
            }
          }
        });

        if (cooldown !== null) startCooldown(cooldown);
      });
    }
  });
</script>
