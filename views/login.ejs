<div class="max-w-md mx-auto bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
  <%# The seal, so the page identifies itself. A login form is the page most
      likely to be reached from an emailed link, where somebody arrives with no
      other clue whose site this is. Uses the uploaded logo, same as the navbar. %>
  <div class="mb-6 flex flex-col items-center text-center">
    <img src="<%= locals.logoUrl || '/img/default-logo.svg' %>" alt="JPSME" class="h-16 w-16 object-contain">
    <h1 class="mt-3 text-2xl font-bold">Login</h1>
    <p class="mt-1 text-sm text-gray-500">Junior Philippine Society of Mechanical Engineers</p>
  </div>
  <form id="login-form" class="space-y-4">
    <input type="hidden" name="context" value="user">
    <div>
      <label class="block text-sm font-medium mb-1" for="email">Email</label>
      <input type="email" id="email" name="email" required
        class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <div>
      <label class="block text-sm font-medium mb-1" for="password">Password</label>
      <input type="password" id="password" name="password" required
        class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <button type="submit" class="w-full bg-indigo-600 text-white py-2 rounded-md hover:bg-indigo-700">
      Login
    </button>
  </form>
  <p class="text-sm text-gray-500 mt-4">
    No account? <a href="/register" class="text-indigo-600 hover:underline">Register here</a>
  </p>

  <details class="mt-4 text-sm">
    <summary class="text-gray-500 cursor-pointer hover:text-gray-700 py-2">Need to verify your email?</summary>
    <%# Two different people open this. One already has a code and needs the
        field to type it in, which is on /verify-email and was reachable from
        nowhere — they used to land here, resend, and have no way to use what
        arrived. The other has no code and needs a new one. Both are answered,
        the shorter path first. %>
    <p class="mt-2 text-gray-600">
      Already have a code?
      <a href="/verify-email" class="text-indigo-600 hover:underline">Enter it here</a>.
    </p>
    <p class="mt-3 text-gray-500">Otherwise, send yourself a new one:</p>
    <form id="resend-verification-form" class="mt-2 flex flex-wrap gap-2">
      <input type="email" name="email" required placeholder="you@example.com"
        class="flex-1 min-w-[200px] border border-gray-300 rounded-md px-3 py-2">
      <%# The same endpoint as the resend form on /verify-email, so it needs the
          same check — without this it would start failing the moment
          TURNSTILE_SITE_KEY is set, on a page nobody would think to re-test. %>
      <%- include('partials/human-check') %>
      <button type="submit" class="bg-gray-900 text-white px-3 py-2 rounded-md text-sm hover:bg-gray-800">Resend</button>
    </form>
  </details>
</div>

<script src="/js/auth.js"></script>
