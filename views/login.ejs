<div class="max-w-md mx-auto bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
  <%# The seal, so the page identifies itself. A login form is the page most
      likely to be reached from an emailed link, where somebody arrives with no
      other clue whose site this is. Uses the uploaded logo, same as the navbar. %>
  <div class="mb-6 flex flex-col items-center text-center">
    <img src="<%= locals.logoUrl || '/img/default-logo.svg' %>" alt="JPSME" class="h-16 w-16 object-contain">
    <h1 class="mt-3 text-2xl font-bold">Login</h1>
    <p class="mt-1 text-sm text-gray-500">Junior Philippine Society of Mechanical Engineers</p>
  </div>
  <% if (locals.justVerified) { %>
    <%# Said here rather than on the page they just left. Confirming an address
        and signing in are two steps, and a confirmation that shows for a
        moment and is then replaced by a login form reads as dismissed rather
        than completed. %>
    <div class="mb-5 flex items-start gap-3 rounded-lg border border-green-200 bg-green-50 p-3">
      <svg class="mt-0.5 h-5 w-5 shrink-0 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
      </svg>
      <div>
        <p class="text-sm font-semibold text-green-800">Email verified</p>
        <p class="text-xs text-green-700">Sign in to finish setting up your account.</p>
      </div>
    </div>
  <% } %>

  <form id="login-form" class="space-y-4">
    <input type="hidden" name="context" value="user">
    <div>
      <label class="block text-sm font-medium mb-1" for="email">Email</label>
      <%# Prefilled by the verification page. Escaped by EJS, capped in the
          controller, and editable — the worst a crafted link can do is put
          somebody else's address in a box, which is what typing would do. %>
      <input type="email" id="email" name="email" required
        value="<%= locals.email || '' %>"
        class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <div>
      <label class="block text-sm font-medium mb-1" for="password">Password</label>
      <input type="password" id="password" name="password" required
        class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <button type="submit" class="w-full bg-indigo-600 text-white py-2 rounded-md hover:bg-indigo-700">
      Login
    </button>
  </form>
  <p class="text-sm text-gray-500 mt-4">
    No account? <a href="/register" class="text-indigo-600 hover:underline">Register here</a>
  </p>

  <%#
    What used to be here: a collapsed "Need to verify your email?" panel hiding
    a resend form and a captcha. It asked somebody to find a disclosure
    triangle, retype the address they had just typed above, and read characters
    out of an image — all to get a code the login button could have sent them.

    Now it does. Signing in with an address that was never confirmed mails the
    code and takes them to the page with the field, so there is nothing to open
    and nothing to fill in. The one line left is for somebody who already has a
    code in their inbox and does not want to sign in again to use it.
  %>
  <p class="text-sm text-gray-500 mt-2">
    Waiting on a verification code?
    <a href="/verify-email" class="text-indigo-600 hover:underline">Enter it here</a> —
    or just sign in above and we'll send you a new one.
  </p>
</div>

<script src="/js/auth.js"></script>
<script nonce="<%= cspNonce %>">
  // Straight to the password when the address arrived filled in. Landing in a
  // box that already holds the right answer is a small thing to have to notice
  // and skip past, and it happens to everybody coming off verification.
  document.addEventListener('DOMContentLoaded', () => {
    const email = document.getElementById('email');
    const password = document.getElementById('password');
    if (email && email.value && password) password.focus();
  });
</script>
