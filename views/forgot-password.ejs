<div class="max-w-md mx-auto bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
  <div class="mb-6 flex flex-col items-center text-center">
    <img src="<%= locals.logoUrl || '/img/default-logo.svg' %>" alt="JPSME" class="h-16 w-16 object-contain">
    <h1 class="mt-3 text-2xl font-bold">Forgot your password?</h1>
    <p class="mt-1 text-sm text-gray-500">
      Enter the email address on your account and we will send you a link to choose a new password.
    </p>
  </div>

  <form id="forgot-form" class="space-y-4">
    <div>
      <label class="block text-sm font-medium mb-1" for="email">Email</label>
      <input type="email" id="email" name="email" required autocomplete="email"
        value="<%= locals.email || '' %>"
        class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <button type="submit" id="forgot-submit"
            class="w-full bg-indigo-600 text-white py-2 rounded-md hover:bg-indigo-700 disabled:opacity-50">
      Send reset link
    </button>
  </form>

  <%# The reply is deliberately the same whether or not that address has an
      account — see passwordReset.service. It is rendered here rather than as a
      toast because it tells them to go and check an inbox, which is an
      instruction to act on, not a notification to dismiss. %>
  <div id="forgot-done" hidden class="mt-5 rounded-lg border border-green-200 bg-green-50 p-4">
    <p class="text-sm font-semibold text-green-800">Check your email</p>
    <p class="mt-1 text-sm text-green-700" id="forgot-done-msg"></p>
    <p class="mt-2 text-xs text-green-700">
      The link works once and expires in an hour. If nothing arrives in a few minutes, check your spam folder.
    </p>
  </div>

  <p class="text-sm text-gray-500 mt-4">
    Remembered it? <a href="/login" class="text-indigo-600 hover:underline">Back to sign in</a>
  </p>
</div>

<script nonce="<%= cspNonce %>">
// apiFetch and showToast live in /js/api.js, which the layout loads at the END
// of <body> — after this page's markup and after this script. So nothing here
// may touch them while the document is still parsing.
//
// That is not theoretical: the reset page called its link check immediately and
// died with "apiFetch is not defined", which it then displayed to the reader as
// "This link cannot be used" — a real link reported as broken by a bug in the
// page that was checking it.
//
// readyState rather than a bare DOMContentLoaded listener: if this ever moves
// somewhere that runs later, a listener for an event that has already fired
// never runs at all, and the page would silently do nothing instead.
function onReady(fn) {
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn);
  else fn();
}
onReady(function () {
  document.getElementById('forgot-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('forgot-submit');
    const email = document.getElementById('email').value.trim();
    if (!email) return;

    btn.disabled = true;
    btn.textContent = 'Sending…';
    try {
      const res = await apiFetch('/api/auth/forgot-password', {
        method: 'POST',
        body: JSON.stringify({ email }),
      });
      // The form is replaced rather than left sitting there: leaving a filled
      // form under a success message invites a second submit, which is how
      // somebody ends up with three links and uses the oldest.
      document.getElementById('forgot-form').hidden = true;
      document.getElementById('forgot-done-msg').textContent = res.message;
      document.getElementById('forgot-done').hidden = false;
    } catch (err) {
      showToast(err.message, 'error');
      btn.disabled = false;
      btn.textContent = 'Send reset link';
    }
  });
});
</script>
