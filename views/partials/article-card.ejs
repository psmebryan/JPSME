<%#
  One article as a card (News pages, Explore More). Locals: article (with
  teaser), and optionally `wide` for the image-left row style.
%>
<%
  const a = locals.article;
  const date = a.publishedAt ? new Date(a.publishedAt).toLocaleDateString('en-US', { timeZone: 'Asia/Manila', month: 'short', day: 'numeric', year: 'numeric' }) : '';
%>
<% if (locals.wide) { %>
  <a href="/articles/<%= a.id %>" class="group flex flex-col overflow-hidden rounded-2xl border border-[#263b70] bg-[#111b3a] transition hover:border-amber-400/60 sm:flex-row">
    <div class="relative h-48 shrink-0 overflow-hidden bg-[#0b1430] sm:h-auto sm:w-72">
      <% if (a.coverImage) { %>
        <img src="<%= a.coverImage %>" alt="" loading="lazy" class="h-full w-full object-cover transition duration-300 group-hover:scale-105">
      <% } else { %>
        <div class="flex h-full min-h-[10rem] items-center justify-center text-[#33467a]"><svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z"/></svg></div>
      <% } %>
    </div>
    <div class="flex flex-1 flex-col justify-center p-5 sm:p-6">
      <% if (a.category) { %><p class="text-xs font-semibold uppercase tracking-wide text-slate-400"><%= a.category %></p><% } %>
      <h3 class="mt-1 text-lg font-bold uppercase leading-snug text-white group-hover:text-amber-300 sm:text-xl"><%= a.title %></h3>
      <p class="mt-1 text-xs font-semibold text-amber-400"><%= date %></p>
      <p class="mt-3 line-clamp-3 text-sm leading-6 text-slate-400"><%= a.teaser %></p>
    </div>
  </a>
<% } else { %>
  <a href="/articles/<%= a.id %>" class="group flex flex-col overflow-hidden rounded-2xl border border-[#263b70] bg-[#111b3a] transition hover:-translate-y-0.5 hover:border-amber-400/60">
    <div class="relative aspect-[16/11] overflow-hidden bg-[#0b1430]">
      <% if (a.coverImage) { %>
        <img src="<%= a.coverImage %>" alt="" loading="lazy" class="h-full w-full object-cover transition duration-300 group-hover:scale-105">
      <% } else { %>
        <div class="flex h-full items-center justify-center text-[#33467a]"><svg class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 01-2.25 2.25M16.5 7.5V18a2.25 2.25 0 002.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 002.25 2.25h13.5M6 7.5h3v3H6v-3z"/></svg></div>
      <% } %>
      <% if (a.category && locals.showCategory) { %>
        <span class="absolute left-3 top-3 rounded-full bg-[#080f29]/80 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-amber-300 backdrop-blur"><%= a.category %></span>
      <% } %>
    </div>
    <div class="flex flex-1 flex-col p-4">
      <p class="text-xs text-slate-400"><%= date %></p>
      <h3 class="mt-1 line-clamp-2 font-semibold leading-snug text-white group-hover:text-amber-300"><%= a.title %></h3>
      <% if (locals.showTeaser) { %><p class="mt-2 line-clamp-2 text-sm text-slate-400"><%= a.teaser %></p><% } %>
    </div>
  </a>
<% } %>
