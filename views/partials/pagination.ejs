<%
/*
  Reusable pagination partial.

  Expected locals when including this partial:
    - currentPage   (Number) 1-indexed current page
    - totalPages    (Number) total number of pages
    - baseQuery     (Object) all query params to preserve EXCEPT the page param itself
                     e.g. { search: 'seminar', modality: 'ONLINE' }
    - pageParam     (String) name of the query param this pagination controls.
                     Defaults to "page". Use distinct names ("upcomingPage",
                     "endedPage") when two paginated lists appear on the same view.

  Include it from a view one level below views/ (e.g. views/events.ejs) as:
    partials/pagination
  Include it from a view nested one level deeper (e.g. views/admin/events.ejs) as:
    ../partials/pagination
  passing currentPage, totalPages, baseQuery, and pageParam as above.

  Looks and behaves like the admin Users list's pagination (admin.js
  renderMembersPagination): at most ten numbers that slide with the current
  page — 1-10, then e.g. 5-14 on page 9 — between ‹ › arrows that grey out at
  either end.
*/
const _pageParam = typeof pageParam !== 'undefined' ? pageParam : 'page';
const _baseQuery = typeof baseQuery !== 'undefined' ? baseQuery : {};

function _buildPageUrl(targetPage) {
  const params = new URLSearchParams();
  Object.keys(_baseQuery).forEach((k) => {
    if (_baseQuery[k] !== undefined && _baseQuery[k] !== null && _baseQuery[k] !== '') params.set(k, _baseQuery[k]);
  });
  params.set(_pageParam, targetPage);
  return '?' + params.toString();
}

const _base = 'px-3 py-1.5 text-sm rounded-md border';
const _idle = 'border-slate-200 text-slate-600 hover:bg-slate-50';
const _off = 'border-slate-100 text-slate-300 cursor-not-allowed';
%>
<% if (totalPages > 1) { %>
  <%
    let _start = Math.max(1, currentPage - 4);
    const _end = Math.min(totalPages, _start + 9);
    _start = Math.max(1, _end - 9);
  %>
  <nav class="flex flex-wrap items-center justify-center gap-1 p-4" aria-label="Pagination">
    <% if (currentPage > 1) { %>
      <a href="<%= _buildPageUrl(currentPage - 1) %>" class="<%= _base %> <%= _idle %>" aria-label="Previous page">&lsaquo;</a>
    <% } else { %>
      <span class="<%= _base %> <%= _off %>" aria-hidden="true">&lsaquo;</span>
    <% } %>

    <% for (let p = _start; p <= _end; p++) { %>
      <a href="<%= _buildPageUrl(p) %>"
         class="<%= _base %> <%= p === currentPage ? 'bg-indigo-600 text-white border-indigo-600' : _idle %>"
         <%= p === currentPage ? 'aria-current="page"' : '' %>><%= p %></a>
    <% } %>

    <% if (currentPage < totalPages) { %>
      <a href="<%= _buildPageUrl(currentPage + 1) %>" class="<%= _base %> <%= _idle %>" aria-label="Next page">&rsaquo;</a>
    <% } else { %>
      <span class="<%= _base %> <%= _off %>" aria-hidden="true">&rsaquo;</span>
    <% } %>
  </nav>
<% } %>
