<%#
  The site bar.

  Sticky, and it changes on scroll: at the top it is translucent over whatever
  the page opens with, and once the page has moved it goes solid, gains a
  shadow and loses 16px of height. Height and colour only — a bar that
  rearranges itself on scroll moves the links out from under the pointer.

  Everything visual here comes from the .jp-nav* components in the stylesheet.
  styleSrc carries a nonce and no 'unsafe-inline', so a style attribute would
  be dropped silently; there are none in this file, and there must not be.
%>
<% const navAt = (name) => (locals.title === name ? 'is-active' : ''); %>
<% const aboutPages = [
     ['/about', 'About JPSME National'],
     ['/about/quality-policy', 'Quality Policy'],
     ['/about/code-of-ethics', 'Code of Ethics'],
     ['/about/theme-of-the-year', 'Theme of the Year'],
     ['/about/officers', 'Officers'],
     ['/about/membership', 'Membership'],
   ]; %>
<header class="jp-nav" id="siteNav">
  <div class="jp-container">
    <div class="jp-nav-inner">

      <a href="/" class="flex shrink-0 items-center gap-3 rounded-lg leading-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-400 focus-visible:ring-offset-2 focus-visible:ring-offset-ink-950">
        <img src="<%= locals.logoUrl || '/img/default-logo.svg' %>" alt="" class="h-11 w-11 shrink-0 object-contain">
        <span>
          <span class="block text-lg font-extrabold leading-none tracking-tight text-gold-300">JPSME</span>
          <span class="mt-1 block font-tech text-[10px] font-semibold uppercase tracking-[.18em] text-mist-400">Philippines</span>
        </span>
      </a>

      <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
        <a href="/" class="jp-nav-link <%= navAt('Home') %>">Home</a>

        <div class="relative" id="aboutDropdown">
          <button type="button" id="aboutDropdownBtn"
                  class="jp-nav-link gap-1.5 <%= navAt('About') %>"
                  aria-haspopup="true" aria-expanded="false" aria-controls="aboutDropdownMenu">
            About
            <svg class="h-3 w-3 transition-transform duration-200" id="aboutChevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div id="aboutDropdownMenu" class="jp-nav-menu hidden">
            <% aboutPages.forEach(([href, label]) => { %><a href="<%= href %>"><%= label %></a><% }) %>
          </div>
        </div>

        <a href="/events" class="jp-nav-link <%= navAt('Events') %>">Events</a>
        <a href="/organizations" class="jp-nav-link <%= locals.title === 'Organizations' || locals.organization ? 'is-active' : '' %>">Organizations</a>
        <a href="/articles" class="jp-nav-link <%= navAt('Articles') %>">Articles</a>
        <a href="/contact" class="jp-nav-link <%= navAt('Contact Us') %>">Contact Us</a>
      </nav>

      <div class="flex items-center gap-3">
        <% if (locals.currentUser) { %>
          <% const canAccessAdmin = currentUser.role === 'ADMIN' || currentUser.role === 'CHAPTER_ADMIN'; %>
          <div class="relative hidden sm:block" id="userMenuDropdown">
            <button type="button" id="userMenuBtn"
                    class="flex h-11 items-center gap-2.5 rounded-lg px-2 text-sm font-semibold text-mist-200 transition-colors hover:bg-white/[.07] hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-400"
                    aria-haspopup="true" aria-expanded="false" aria-controls="userMenuList">
              <%# The member's own photo, not a gear. A cog reads as "site
                  settings"; this menu is about who is signed in, and a face
                  answers that at a glance. %>
              <img src="<%= currentUser.profileImage || '/img/default-avatar.svg' %>" alt=""
                   class="h-8 w-8 shrink-0 rounded-full bg-ink-800 object-cover ring-2 ring-gold-400/30">
              <span class="max-w-[10rem] truncate"><%= currentUser.firstName %></span>
              <svg class="h-3 w-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div id="userMenuList" class="jp-nav-menu left-auto right-0 hidden w-56">
              <p class="px-4 pb-2 pt-2.5 font-tech text-[10px] font-bold uppercase tracking-[.16em] text-mist-500">Signed in as</p>
              <p class="truncate px-4 pb-2 text-sm font-semibold text-white"><%= currentUser.firstName %> <%= currentUser.lastName %></p>
              <div class="my-1.5 h-px bg-white/10"></div>
              <a href="/profile">My Profile</a>
              <a href="/profile#registrations">My Registrations</a>
              <% if (canAccessAdmin) { %>
                <div class="my-1.5 h-px bg-white/10"></div>
                <a href="/admin/dashboard" class="text-gold-300"><%= currentUser.role === 'CHAPTER_ADMIN' ? 'Chapter Admin' : 'Admin Dashboard' %></a>
              <% } %>
              <div class="my-1.5 h-px bg-white/10"></div>
              <a href="/logout">Log Out</a>
            </div>
          </div>
        <% } else { %>
          <%# Login first, membership second and gold: the bar reads left to
              right, so the primary action is the one nearest the edge the eye
              finishes on. %>
          <a href="/login" class="hidden h-11 items-center rounded-lg px-4 text-sm font-semibold text-mist-200 transition-colors hover:bg-white/[.07] hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-400 sm:inline-flex">Login</a>
          <a href="/register" class="jp-btn jp-btn-gold hidden px-5 focus-visible:ring-offset-ink-950 sm:inline-flex">Become a Member</a>
        <% } %>

        <button id="navToggle" type="button"
                class="-mr-2 inline-flex h-11 w-11 items-center justify-center rounded-lg text-white transition-colors hover:bg-white/[.07] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold-400 lg:hidden"
                aria-label="Open menu" aria-expanded="false" aria-controls="mobileNav">
          <svg id="navIconOpen" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg id="navIconClose" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <%# The phone menu. Scrolls on its own rather than growing the page, and the
      two calls to action sit at the bottom where the thumb already is. %>
  <div id="mobileNav" class="hidden border-t border-white/10 bg-ink-950 lg:hidden">
    <nav class="jp-container max-h-[calc(100dvh-64px)] overflow-y-auto py-4" aria-label="Main">
      <div class="flex flex-col gap-0.5">
        <a href="/" class="jp-mobile-link">Home</a>

        <button type="button" id="mobileAboutBtn" class="jp-mobile-link justify-between" aria-expanded="false" aria-controls="mobileAbout">
          About
          <svg id="mobileAboutChevron" class="h-4 w-4 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="mobileAbout" class="hidden flex-col gap-0.5 border-l border-white/10 pl-1">
          <% aboutPages.forEach(([href, label]) => { %><a href="<%= href %>" class="jp-mobile-sublink"><%= label %></a><% }) %>
        </div>

        <a href="/events" class="jp-mobile-link">Events</a>
        <a href="/organizations" class="jp-mobile-link">Organizations</a>
        <a href="/articles" class="jp-mobile-link">Articles</a>
        <a href="/contact" class="jp-mobile-link">Contact Us</a>
      </div>

      <div class="mt-4 border-t border-white/10 pt-4">
        <% if (locals.currentUser) { %>
          <div class="flex items-center gap-3 px-3 pb-3">
            <img src="<%= currentUser.profileImage || '/img/default-avatar.svg' %>" alt=""
                 class="h-10 w-10 shrink-0 rounded-full bg-ink-800 object-cover ring-2 ring-gold-400/30">
            <span class="truncate text-sm font-semibold text-white"><%= currentUser.firstName %> <%= currentUser.lastName %></span>
          </div>
          <div class="flex flex-col gap-0.5">
            <a href="/profile" class="jp-mobile-link">My Profile</a>
            <a href="/profile#registrations" class="jp-mobile-link">My Registrations</a>
            <% if (currentUser.role === 'ADMIN' || currentUser.role === 'CHAPTER_ADMIN') { %>
              <a href="/admin/dashboard" class="jp-mobile-link text-gold-300"><%= currentUser.role === 'CHAPTER_ADMIN' ? 'Chapter Admin' : 'Admin Dashboard' %></a>
            <% } %>
            <a href="/logout" class="jp-mobile-link">Log Out</a>
          </div>
        <% } else { %>
          <div class="flex flex-col gap-2.5">
            <a href="/register" class="jp-btn jp-btn-gold jp-btn-lg w-full focus-visible:ring-offset-ink-950">Become a Member</a>
            <a href="/login" class="jp-btn jp-btn-ghost jp-btn-lg w-full">Login</a>
          </div>
        <% } %>
      </div>
    </nav>
  </div>
</header>

<%# The bar's behaviour lives in a static file rather than inline here: it
    carries no EJS values, it is on every page so it is worth caching once, and
    the scroll logic in it needs a regression test (tests/navbar.test.js). %>
<script src="/js/navbar.js" defer></script>
