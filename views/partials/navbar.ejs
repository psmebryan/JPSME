<header class="sticky top-0 z-40 border-b border-[#26365f] bg-[#080f21] text-white">
  <div class="mx-auto flex min-h-[88px] max-w-[1280px] items-center justify-between gap-6 px-4 sm:px-8 lg:px-12">
    <a href="/" class="flex items-center gap-3 leading-none shrink-0">
      <img src="<%= locals.logoUrl || '/img/default-logo.svg' %>" alt="JPSME logo" class="h-10 w-10 object-contain">
      <span><span class="block text-lg font-extrabold text-amber-400">JPSME</span><span class="mt-1 block text-[10px] tracking-wide text-slate-400">PHILIPPINES</span></span>
    </a>

    <nav class="hidden lg:flex items-center gap-8 text-sm font-medium text-slate-400">
      <a href="/" class="<%= locals.title === 'Home' ? 'border-b-2 border-amber-400 pb-2 text-amber-400' : 'hover:text-amber-300' %>">Home</a>

      <div class="relative" id="aboutDropdown">
        <button type="button" id="aboutDropdownBtn"
                class="flex items-center gap-1 hover:text-amber-300 <%= locals.title === 'About' ? 'text-amber-300' : '' %>"
                aria-haspopup="true" aria-expanded="false">
          About
          <svg class="h-3.5 w-3.5 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div id="aboutDropdownMenu"
             class="hidden absolute left-0 top-full mt-0 w-56 bg-indigo-950 rounded-b-md shadow-lg overflow-hidden">
          <a href="/about" class="block px-5 py-3 text-sm hover:bg-indigo-900">About JPSME National</a>
          <a href="/about/quality-policy" class="block px-5 py-3 text-sm hover:bg-indigo-900">Quality Policy</a>
          <a href="/about/code-of-ethics" class="block px-5 py-3 text-sm hover:bg-indigo-900">Code of Ethics</a>
          <a href="/about/theme-of-the-year" class="block px-5 py-3 text-sm hover:bg-indigo-900">Theme of the Year</a>
          <a href="/about/officers" class="block px-5 py-3 text-sm hover:bg-indigo-900">Officers</a>
          <a href="/about/membership" class="block px-5 py-3 text-sm hover:bg-indigo-900">Membership</a>
        </div>
      </div>

      <a href="/events" class="<%= locals.title === 'Events' ? 'border-b-2 border-amber-400 pb-2 text-amber-400' : 'hover:text-amber-300' %>">Event</a>
      <a href="/organizations" class="<%= locals.title === 'Organizations' || locals.organization ? 'border-b-2 border-amber-400 pb-2 text-amber-400' : 'hover:text-amber-300' %>">Organizations</a>
      <a href="/articles" class="<%= locals.title === 'Articles' ? 'border-b-2 border-amber-400 pb-2 text-amber-400' : 'hover:text-amber-300' %>">Articles</a>
      <a href="/contact" class="<%= locals.title === 'Contact Us' ? 'border-b-2 border-amber-400 pb-2 text-amber-400' : 'hover:text-amber-300' %>">Contact Us</a>
    </nav>

    <div class="flex items-center gap-3">
      <% if (locals.currentUser) { %>
        <% const canAccessAdmin = currentUser.role === 'ADMIN' || currentUser.role === 'CHAPTER_ADMIN'; %>
        <div class="relative hidden sm:block" id="userMenuDropdown">
          <button type="button" id="userMenuBtn"
                  class="flex items-center gap-2 text-sm font-semibold hover:text-amber-300"
                  aria-haspopup="true" aria-expanded="false">
            <!-- The member's own photo, not a gear. A cog reads as "site
                 settings"; this menu is about who is signed in, and a face
                 answers that at a glance. Same fallback as every other avatar
                 in the app, so an account with no photo still renders a real
                 image rather than a broken one. -->
            <img src="<%= currentUser.profileImage || '/img/default-avatar.svg' %>" alt=""
                 class="h-8 w-8 rounded-full object-cover ring-2 ring-white/25 bg-indigo-900 shrink-0">
            <span class="max-w-[11rem] truncate"><%= currentUser.firstName %> <%= currentUser.lastName %></span>
            <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div id="userMenuList"
               class="hidden absolute right-0 top-full mt-0 w-48 bg-indigo-950 rounded-b-md shadow-lg overflow-hidden">
            <a href="/profile" class="block px-5 py-3 text-sm hover:bg-indigo-900">My Profile</a>
            <a href="/profile#registrations" class="block px-5 py-3 text-sm hover:bg-indigo-900">My Registrations</a>
            <% if (canAccessAdmin) { %>
              <div class="border-t border-white/10"></div>
              <a href="/admin/dashboard" class="block px-5 py-3 text-sm text-amber-300 hover:bg-indigo-900">
                <%= currentUser.role === 'CHAPTER_ADMIN' ? 'Chapter Admin' : 'Admin Dashboard' %>
              </a>
            <% } %>
            <div class="border-t border-white/10"></div>
            <a href="/logout" class="block px-5 py-3 text-sm hover:bg-indigo-900">Log Out</a>
          </div>
        </div>
      <% } else { %>
        <a href="/register" class="hidden sm:inline-block bg-amber-400 text-[#071126] text-sm font-bold px-5 py-2.5 rounded-md hover:bg-amber-300">Be a Member</a>
        <a href="/login" class="hidden sm:inline-block border border-slate-500 text-white text-sm font-bold px-6 py-2.5 rounded-md hover:bg-white/10">Login</a>
      <% } %>

      <button id="navToggle" type="button" class="lg:hidden inline-flex items-center justify-center p-3 rounded-md hover:bg-white/10" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileNav">
        <svg id="navIconOpen" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="navIconClose" class="h-6 w-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <div id="mobileNav" class="hidden lg:hidden border-t border-white/10 bg-indigo-950">
    <nav class="px-4 sm:px-6 py-4 flex flex-col gap-1 text-sm font-semibold">
      <a href="/" class="py-3 hover:text-amber-300">Home</a>
      <p class="py-3 text-amber-300">About</p>
      <a href="/about" class="pl-4 py-2.5 text-sm hover:text-amber-300">About JPSME National</a>
      <a href="/about/quality-policy" class="pl-4 py-2.5 text-sm hover:text-amber-300">Quality Policy</a>
      <a href="/about/code-of-ethics" class="pl-4 py-2.5 text-sm hover:text-amber-300">Code of Ethics</a>
      <a href="/about/theme-of-the-year" class="pl-4 py-2.5 text-sm hover:text-amber-300">Theme of the Year</a>
      <a href="/about/officers" class="pl-4 py-2.5 text-sm hover:text-amber-300">Officers</a>
      <a href="/about/membership" class="pl-4 py-2.5 text-sm hover:text-amber-300">Membership</a>
      <a href="/events" class="py-3 hover:text-amber-300">Event</a>
      <a href="/organizations" class="py-3 hover:text-amber-300">Organizations</a>
      <a href="/articles" class="py-3 hover:text-amber-300">Articles</a>
      <a href="/contact" class="py-3 hover:text-amber-300">Contact Us</a>
      <% if (locals.currentUser) { %>
        <div class="flex items-center gap-3 py-3 border-t border-white/10 mt-2">
          <img src="<%= currentUser.profileImage || '/img/default-avatar.svg' %>" alt=""
               class="h-9 w-9 rounded-full object-cover ring-2 ring-white/25 bg-indigo-900 shrink-0">
          <span class="text-sm font-semibold truncate"><%= currentUser.firstName %> <%= currentUser.lastName %></span>
        </div>
        <a href="/profile" class="py-3 hover:text-amber-300">My Profile</a>
        <a href="/profile#registrations" class="py-3 hover:text-amber-300">My Registrations</a>
        <% if (currentUser.role === 'ADMIN' || currentUser.role === 'CHAPTER_ADMIN') { %>
          <a href="/admin/dashboard" class="py-3 text-amber-300 hover:text-amber-200">
            <%= currentUser.role === 'CHAPTER_ADMIN' ? 'Chapter Admin' : 'Admin Dashboard' %>
          </a>
        <% } %>
        <a href="/logout" class="py-3 hover:text-amber-300">Log Out</a>
      <% } else { %>
        <a href="/register" class="py-3 hover:text-amber-300">Be a Member</a>
        <a href="/login" class="py-3 hover:text-amber-300">Login</a>
      <% } %>
    </nav>
  </div>
</header>

<script nonce="<%= cspNonce %>">
  (function () {
    const toggle = document.getElementById('navToggle');
    const panel = document.getElementById('mobileNav');
    const iconOpen = document.getElementById('navIconOpen');
    const iconClose = document.getElementById('navIconClose');
    function closeMobileNav() {
      panel.classList.add('hidden');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
      toggle.setAttribute('aria-expanded', 'false');
    }
    toggle.addEventListener('click', function () {
      const isHidden = panel.classList.contains('hidden');
      panel.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
    });
    document.addEventListener('click', function (e) {
      if (!panel.classList.contains('hidden') && !panel.contains(e.target) && !toggle.contains(e.target)) {
        closeMobileNav();
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeMobileNav();
    });

    const aboutBtn = document.getElementById('aboutDropdownBtn');
    const aboutMenu = document.getElementById('aboutDropdownMenu');
    aboutBtn.addEventListener('click', function () {
      const isHidden = aboutMenu.classList.contains('hidden');
      aboutMenu.classList.toggle('hidden');
      aboutBtn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
    });
    document.addEventListener('click', function (e) {
      if (!document.getElementById('aboutDropdown').contains(e.target)) {
        aboutMenu.classList.add('hidden');
        aboutBtn.setAttribute('aria-expanded', 'false');
      }
    });

    // User menu (gear icon) — opens on click or hover, closes on outside click or mouse leave.
    const userMenuWrapper = document.getElementById('userMenuDropdown');
    const userMenuBtn = document.getElementById('userMenuBtn');
    const userMenuList = document.getElementById('userMenuList');
    if (userMenuWrapper && userMenuBtn && userMenuList) {
      function openUserMenu() {
        userMenuList.classList.remove('hidden');
        userMenuBtn.setAttribute('aria-expanded', 'true');
      }
      function closeUserMenu() {
        userMenuList.classList.add('hidden');
        userMenuBtn.setAttribute('aria-expanded', 'false');
      }
      userMenuBtn.addEventListener('click', function () {
        userMenuList.classList.contains('hidden') ? openUserMenu() : closeUserMenu();
      });
      userMenuWrapper.addEventListener('mouseenter', openUserMenu);
      userMenuWrapper.addEventListener('mouseleave', closeUserMenu);
      document.addEventListener('click', function (e) {
        if (!userMenuWrapper.contains(e.target)) closeUserMenu();
      });
    }
  })();
</script>
