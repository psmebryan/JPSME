<%
/*
  Choosing your own seat.

  The counterpart to the registration desk: the desk can hand somebody a seat,
  and this lets them take one themselves. Both go through the same service and
  the same one-seat-per-registration constraint, so it does not matter which
  happens first, or whether both are happening at once in different rooms.

  Two things this page must never do, both enforced by the API rather than here:
  show whose seat a taken seat is (the attendee map carries no names), and let
  anybody act on a registration other than their own (the request never names
  one — the session does).

  The map itself is drawn by public/js/seat-picker.js, because it changes while
  you are looking at it. Everything that is already known — the event, the
  current seat, why you cannot choose — is rendered here so the page says
  something true before any fetch returns.
*/
%>
<div class="max-w-3xl mx-auto"
     data-seat-picker
     data-event-id="<%= event.id %>"
     data-hold-ms="<%= holdMs %>">

  <a href="/events/<%= event.id %>/ticket" class="text-sm text-indigo-600 hover:underline">&larr; Back to my ticket</a>

  <h1 class="mt-3 text-2xl font-bold text-slate-900"><%= event.title %></h1>
  <p class="mt-1 text-sm text-slate-600">Choose where you would like to sit.</p>

  <% if (blocked) { %>
    <%# A dead end, but an explained one. Each reason gets the action that
        actually resolves it rather than a generic "go back". %>
    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 text-center">
      <p class="text-sm text-slate-700"><%= blocked.message %></p>
      <% if (blocked.reason === 'NOT_REGISTERED') { %>
        <a href="/events/<%= event.id %>" class="btn-primary mt-4 inline-block px-5 py-2.5">Register for this event</a>
      <% } else if (blocked.reason === 'UNPAID') { %>
        <a href="/profile" class="btn-primary mt-4 inline-block px-5 py-2.5">Go to my registrations</a>
      <% } else { %>
        <a href="/events/<%= event.id %>/ticket" class="btn-secondary mt-4 inline-block px-5 py-2.5">Back to my ticket</a>
      <% } %>
    </div>
  <% } else { %>

    <!-- What they have now. Server-rendered from the same source the map uses,
         then kept up to date by the script as they choose. -->
    <div class="mt-5 rounded-xl border border-slate-200 bg-white p-5" data-current-panel>
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-500">Your seat</p>

      <div class="<%= mySeat ? '' : 'hidden' %>" data-has-seat>
        <p class="mt-1 font-mono text-3xl font-bold text-slate-900" data-seat-label><%= mySeat ? mySeat.label : '' %></p>
        <p class="text-sm text-slate-600" data-seat-where>
          <%= mySeat ? [mySeat.section, mySeat.room].filter(Boolean).join(' · ') : '' %>
        </p>
        <p class="mt-3 text-xs text-slate-500">
          To move, pick another seat below &mdash; yours is only given up once the new one is confirmed.
        </p>
      </div>

      <p class="mt-1 text-sm text-slate-600 <%= mySeat ? 'hidden' : '' %>" data-no-seat>
        You have not chosen one yet. Tap any free seat on the plan below.
      </p>
    </div>

    <!-- The tentative claim. Hidden until there is one; it carries the clock,
         so it has to be impossible to miss while it is running. -->
    <div class="mt-4 hidden rounded-xl border-2 border-amber-400 bg-amber-50 p-5" data-hold-panel>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
          <p class="text-xs font-semibold uppercase tracking-widest text-amber-700">Holding for you</p>
          <p class="mt-0.5 font-mono text-2xl font-bold text-slate-900" data-hold-label></p>
          <p class="text-sm text-slate-600">
            Confirm within <span class="font-semibold tabular-nums" data-hold-countdown></span>
            or it goes back to everyone else.
          </p>
        </div>
        <div class="flex shrink-0 gap-2">
          <button type="button" class="btn-secondary px-4 py-2.5" data-give-up>Give up</button>
          <button type="button" class="btn-primary px-6 py-2.5" data-confirm>Confirm seat</button>
        </div>
      </div>
    </div>

    <!-- Anything the server said back: a refusal, a success, a stale map. -->
    <p class="mt-4 hidden rounded-lg px-4 py-3 text-sm" data-message role="status" aria-live="polite"></p>

    <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-slate-600">
      <span><span class="seat-legend-dot seat-available"></span> Free</span>
      <span><span class="seat-legend-dot seat-mine"></span> Yours</span>
      <span><span class="seat-legend-dot seat-holding"></span> Holding</span>
      <span><span class="seat-legend-dot seat-taken"></span> Taken</span>
      <span><span class="seat-legend-dot seat-blocked"></span> Not in use</span>
    </div>

    <div class="mt-4 space-y-6" data-map>
      <p class="text-sm text-slate-500">Loading the seat plan&hellip;</p>
    </div>

  <% } %>
</div>

<%# api.js is already loaded by the layout. %>
<script src="/js/seat-picker.js"></script>
