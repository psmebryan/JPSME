<%
/*
  Who may run which door.

  A main admin can already check in anywhere, so this page is entirely about
  lending that authority to a chapter admin for one specific event. Revocations
  stay listed rather than disappearing: after a disputed admission, "who could
  scan here, and who let them" has to still be answerable.
*/
function fullName(u) {
  return u ? `${u.firstName} ${u.lastName}` : '—';
}
function when(d) {
  return d ? new Date(d).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' }) : '—';
}
const active = staff.filter(function (g) { return !g.revokedAt; });
const revoked = staff.filter(function (g) { return g.revokedAt; });
const activeIds = active.map(function (g) { return g.userId; });
const available = grantable.filter(function (u) { return activeIds.indexOf(u.id) === -1; });
%>
<div class="max-w-4xl mx-auto" data-checkin-staff <% if (event) { %>data-event-id="<%= event.id %>"<% } %>>
  <a href="/admin/check-in" class="text-sm text-indigo-600 hover:underline">&larr; Back to check-in</a>
  <h1 class="admin-h1 mt-1">Check-in staff</h1>
  <p class="admin-subtitle">
    Main admins can check in at every event. Use this to let a chapter admin run the door at one.
  </p>

  <form method="GET" action="/admin/check-in/staff" class="mt-4 admin-card p-4">
    <label for="eventId" class="form-label">Event</label>
    <div class="flex flex-wrap gap-2">
      <select id="eventId" name="eventId" class="form-input flex-1 min-w-[240px]">
        <option value="">Choose an event…</option>
        <% events.forEach(function (e) { %>
          <option value="<%= e.id %>" <%= event && event.id === e.id ? 'selected' : '' %>>
            <%= e.title %> — <%= new Date(e.startDate).toLocaleDateString() %>
          </option>
        <% }) %>
      </select>
      <button type="submit" class="btn-primary">Show staff</button>
    </div>
  </form>

  <% if (!event) { %>
    <div class="admin-card mt-4">
      <%- include('../partials/empty-state', {
        title: 'Pick an event',
        hint: 'Check-in access is granted one event at a time, so that running the door at a convention gives no access to anything else.',
      }) %>
    </div>
  <% } else { %>

    <div class="mt-4 admin-card p-4">
      <h2 class="text-sm font-semibold text-slate-800">Grant access</h2>
      <% if (!grantable.length) { %>
        <p class="text-sm text-slate-500 mt-2">
          There are no chapter admins yet. Only a chapter admin can be given check-in access —
          <a href="/admin/organization-admins" class="text-indigo-600 hover:underline">assign one first</a>.
        </p>
      <% } else if (!available.length) { %>
        <p class="text-sm text-slate-500 mt-2">Every chapter admin already has access to this event.</p>
      <% } else { %>
        <div class="mt-2 flex flex-wrap gap-2">
          <select data-grant-user class="form-input flex-1 min-w-[240px]">
            <% available.forEach(function (u) { %>
              <option value="<%= u.id %>"><%= fullName(u) %> — <%= u.email %></option>
            <% }) %>
          </select>
          <button type="button" data-grant-btn class="btn-primary">Give access</button>
        </div>
      <% } %>
    </div>

    <div class="mt-4">
      <h2 class="text-sm font-semibold text-slate-800">
        Can scan at "<%= event.title %>" <span class="font-normal text-slate-500">(<%= active.length %>)</span>
      </h2>
      <div class="admin-table-wrap mt-2">
        <table class="admin-table">
          <thead class="admin-table-head">
            <tr>
              <th class="admin-th">Person</th>
              <th class="admin-th">Granted by</th>
              <th class="admin-th">Granted</th>
              <th class="admin-th"></th>
            </tr>
          </thead>
          <tbody class="admin-tbody">
            <% if (!active.length) { %>
              <tr><td colspan="4" class="admin-td">
                <%- include('../partials/empty-state', {
                  title: 'Nobody else can scan here yet',
                  hint: 'Main admins can already run this door. Grant a chapter admin above if someone else needs to.',
                }) %>
              </td></tr>
            <% } else { %>
              <% active.forEach(function (g) { %>
                <tr class="admin-tr">
                  <td class="admin-td">
                    <span class="font-medium text-slate-900"><%= fullName(g.user) %></span>
                    <span class="block text-xs text-slate-500"><%= g.user.email %></span>
                  </td>
                  <td class="admin-td text-sm text-slate-600"><%= fullName(g.grantedByUser) %></td>
                  <td class="admin-td text-sm text-slate-600 whitespace-nowrap"><%= when(g.grantedAt) %></td>
                  <td class="admin-td text-right">
                    <button type="button" data-revoke-user="<%= g.userId %>"
                            class="text-sm text-red-600 hover:underline">Remove</button>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <% if (revoked.length) { %>
      <div class="mt-6">
        <h2 class="text-sm font-semibold text-slate-800">
          Previously had access <span class="font-normal text-slate-500">(<%= revoked.length %>)</span>
        </h2>
        <p class="text-xs text-slate-500 mt-0.5">
          Kept on record so a disputed admission can still be traced back to who was allowed to scan at the time.
        </p>
        <div class="admin-table-wrap mt-2">
          <table class="admin-table">
            <thead class="admin-table-head">
              <tr>
                <th class="admin-th">Person</th>
                <th class="admin-th">Removed by</th>
                <th class="admin-th">Removed</th>
              </tr>
            </thead>
            <tbody class="admin-tbody">
              <% revoked.forEach(function (g) { %>
                <tr class="admin-tr">
                  <td class="admin-td text-sm text-slate-600"><%= fullName(g.user) %></td>
                  <td class="admin-td text-sm text-slate-600"><%= fullName(g.revokedByUser) %></td>
                  <td class="admin-td text-sm text-slate-600 whitespace-nowrap"><%= when(g.revokedAt) %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <%# ---- Integration keys ------------------------------------------------
        On this page rather than its own, because it answers the same question
        the rest of the page does: what is allowed to open this door. The only
        difference is that these are systems rather than people. %>
    <div class="mt-8 border-t border-slate-200 pt-6">
      <h2 class="text-sm font-semibold text-slate-800">Other systems that can scan here</h2>
      <p class="text-xs text-slate-500 mt-1 max-w-2xl">
        A JPSME QR code contains nothing but a random number, so another system cannot
        identify anybody from a scan on its own &mdash; it has to ask this server. An
        integration key is how it asks. Each key works for <strong>this event only</strong>,
        and check-ins it makes are recorded here exactly as if a staff member had scanned them.
      </p>

      <div class="mt-3 flex flex-wrap gap-2">
        <input type="text" data-key-label class="form-input flex-1 min-w-[240px]"
               maxlength="120" placeholder="What is this key for? e.g. Gate system &mdash; main lobby">
        <button type="button" data-create-key class="btn-primary">Create key</button>
      </div>

      <%# The one and only time the secret exists in a readable form. Hidden
          until a key is made, and never re-rendered on a later page load: the
          server stores a hash and genuinely cannot show it again. %>
      <div data-new-key hidden class="mt-3 rounded-lg border border-amber-300 bg-amber-50 p-4">
        <p class="text-sm font-semibold text-amber-900">Copy this key now</p>
        <p class="text-xs text-amber-800 mt-1">
          This is the only time it can be shown. Only a hash of it is stored, so if it is
          lost the key has to be revoked and a new one created.
        </p>
        <div class="mt-2 flex flex-wrap items-center gap-2">
          <code data-new-key-value class="flex-1 min-w-[260px] break-all rounded border border-amber-200 bg-white px-3 py-2 font-mono text-xs text-slate-900"></code>
          <button type="button" data-copy-key class="btn-secondary">Copy</button>
        </div>
      </div>

      <div class="admin-table-wrap mt-3">
        <table class="admin-table">
          <thead class="admin-table-head">
            <tr>
              <th class="admin-th">Label</th>
              <th class="admin-th">Key ID</th>
              <th class="admin-th">Last used</th>
              <th class="admin-th">Status</th>
              <th class="admin-th"></th>
            </tr>
          </thead>
          <tbody class="admin-tbody">
            <% if (!integrationKeys.length) { %>
              <tr><td colspan="5" class="admin-td">
                <%- include('../partials/empty-state', {
                  title: 'No other systems have access',
                  hint: 'Create a key only if a separate system needs to scan the tickets for this event.',
                }) %>
              </td></tr>
            <% } else { %>
              <% integrationKeys.forEach(function (k) { %>
                <tr class="admin-tr">
                  <td class="admin-td">
                    <span class="font-medium text-slate-900"><%= k.label %></span>
                    <span class="block text-xs text-slate-500">Created <%= when(k.createdAt) %><%= k.createdBy ? ' by ' + k.createdBy : '' %></span>
                  </td>
                  <td class="admin-td"><code class="font-mono text-xs text-slate-600"><%= k.keyId %></code></td>
                  <td class="admin-td text-sm text-slate-600 whitespace-nowrap"><%= when(k.lastUsedAt) %></td>
                  <td class="admin-td">
                    <% if (k.active) { %>
                      <span class="badge-green">Active</span>
                    <% } else { %>
                      <span class="badge-slate">Revoked <%= when(k.revokedAt) %></span>
                    <% } %>
                  </td>
                  <td class="admin-td text-right">
                    <% if (k.active) { %>
                      <button type="button" data-revoke-key="<%= k.id %>"
                              class="text-sm text-red-600 hover:underline">Revoke</button>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>

      <details class="mt-3">
        <summary class="cursor-pointer text-sm font-medium text-indigo-600">How the other system uses it</summary>
        <div class="mt-2 space-y-3 rounded-lg border border-slate-200 bg-slate-50 p-4 text-xs text-slate-700">
          <p>Send the key as a bearer token. The event is part of the key, so it never appears in the URL.</p>
<pre class="overflow-x-auto rounded border border-slate-200 bg-white p-3 font-mono text-[11px] leading-5">POST <%= locals.appUrl || '' %>/api/integration/checkin
Authorization: Bearer jpsme_ik_...
Content-Type: application/json

{ "qrToken": "&lt;whatever the scanner read&gt;", "station": "Lobby 1" }</pre>
          <p>
            The reply is the usual <code>{ success, message, data }</code>. Inside <code>data</code>:
            <code>ok</code> (admitted or not), <code>result</code>, <code>participant</code> and
            <code>checkedInAt</code>.
          </p>
          <p>
            <code>result</code> is one of <code>SUCCESS</code>, <code>ALREADY_CHECKED_IN</code>,
            <code>INVALID_QR</code>, <code>WRONG_EVENT</code>, <code>CANCELLED</code>,
            <code>UNPAID</code>, <code>NOT_REGISTERED</code>, <code>REJECTED</code>. A refusal is
            still HTTP 200 &mdash; being turned away at a door is a normal outcome, not a failed
            request.
          </p>
          <p>
            <code>GET /api/integration/whoami</code> confirms which event a key opens, and
            <code>POST /api/integration/lookup</code> identifies somebody <em>without</em>
            admitting them.
          </p>
        </div>
      </details>
    </div>
  <% } %>
</div>

<script nonce="<%= cspNonce %>">
  document.addEventListener('DOMContentLoaded', () => {
    const root = document.querySelector('[data-checkin-staff]');
    if (!root || !root.dataset.eventId) return;
    const eventId = root.dataset.eventId;

    const grantBtn = root.querySelector('[data-grant-btn]');
    if (grantBtn) {
      grantBtn.addEventListener('click', async () => {
        const select = root.querySelector('[data-grant-user]');
        if (!select || !select.value) return;
        grantBtn.disabled = true;
        try {
          await apiFetch(`/api/events/${eventId}/checkin/staff`, {
            method: 'POST',
            body: JSON.stringify({ userId: Number(select.value) }),
          });
          showToast('Check-in access granted');
          window.location.reload();
        } catch (err) {
          showToast(err.message, 'error');
          grantBtn.disabled = false;
        }
      });
    }

    // --- integration keys ---------------------------------------------------
    const createKeyBtn = root.querySelector('[data-create-key]');
    if (createKeyBtn) {
      createKeyBtn.addEventListener('click', async () => {
        const input = root.querySelector('[data-key-label]');
        const label = input ? input.value.trim() : '';
        if (!label) {
          showToast('Give the key a label, so it is clear later what it is for', 'error');
          return;
        }
        createKeyBtn.disabled = true;
        try {
          const res = await apiFetch(`/api/events/${eventId}/integration-keys`, {
            method: 'POST',
            body: JSON.stringify({ label }),
          });
          // Shown, not reloaded into. The secret exists in this response only,
          // so reloading the page to pick it up would lose it for good.
          const panel = root.querySelector('[data-new-key]');
          const value = root.querySelector('[data-new-key-value]');
          value.textContent = res.data.plaintext;
          panel.hidden = false;
          if (input) input.value = '';
          showToast('Key created \u2014 copy it now');
        } catch (err) {
          showToast(err.message, 'error');
        } finally {
          createKeyBtn.disabled = false;
        }
      });
    }

    const copyBtn = root.querySelector('[data-copy-key]');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const value = root.querySelector('[data-new-key-value]').textContent;
        try {
          await navigator.clipboard.writeText(value);
          showToast('Key copied');
        } catch (err) {
          // The clipboard API needs a secure context, and this panel is the
          // only place the key exists \u2014 a failed copy must not leave them stuck.
          showToast('Could not copy automatically. Select the key and copy it by hand.', 'error');
        }
      });
    }

    root.querySelectorAll('[data-revoke-key]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!window.confirm('Revoke this key? The other system stops being able to scan immediately.')) return;
        btn.disabled = true;
        try {
          await apiFetch(`/api/events/${eventId}/integration-keys/${btn.dataset.revokeKey}`, { method: 'DELETE' });
          showToast('Key revoked');
          window.location.reload();
        } catch (err) {
          showToast(err.message, 'error');
          btn.disabled = false;
        }
      });
    });

    root.querySelectorAll('[data-revoke-user]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const userId = btn.dataset.revokeUser;
        if (!window.confirm('Remove this person\'s check-in access for this event?')) return;
        btn.disabled = true;
        try {
          await apiFetch(`/api/events/${eventId}/checkin/staff/${userId}`, { method: 'DELETE' });
          showToast('Check-in access removed');
          window.location.reload();
        } catch (err) {
          showToast(err.message, 'error');
          btn.disabled = false;
        }
      });
    });
  });
</script>
