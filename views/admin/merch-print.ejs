<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pick list and packing slips | JPSME</title>
  <link rel="stylesheet" href="/css/tailwind.css">
</head>
<%#
  Pick list (everything to pull, by variant) and one packing slip per order,
  for printing on packing day. Each slip starts a new page; pickup orders
  carry their QR. Rendered without the admin layout.
%>
<% const peso = (c) => '₱' + (c / 100).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); %>
<body class="bg-white text-slate-900">
  <div class="mx-auto max-w-3xl p-8 print:p-0">
    <div class="mb-6 flex items-center justify-between print:hidden">
      <p class="text-sm text-slate-500"><%= slips.length %> order<%= slips.length === 1 ? '' : 's' %></p>
      <button type="button" class="btn-primary px-4 py-2" data-print>Print</button>
    </div>

    <section>
      <h1 class="text-2xl font-bold">Pick list</h1>
      <p class="text-sm text-slate-500">Printed <%= new Date().toLocaleString('en-PH', { timeZone: 'Asia/Manila', dateStyle: 'medium', timeStyle: 'short' }) %></p>
      <% if (!pickList.length) { %><p class="mt-4 text-slate-600">Nothing to pick: no paid orders waiting.</p><% } else { %>
        <table class="mt-4 w-full border-collapse text-sm" data-pick-list>
          <thead><tr class="border-b-2 border-slate-800 text-left"><th class="py-1">✓</th><th class="py-1">Product</th><th class="py-1">Variant</th><th class="py-1">SKU</th><th class="py-1 text-right">Qty</th><th class="py-1 text-right">Orders</th></tr></thead>
          <tbody>
            <% pickList.forEach((r) => { %><tr class="border-b border-slate-300"><td class="py-1.5">☐</td><td class="py-1.5"><%= r.productName %></td><td class="py-1.5"><%= r.label %></td><td class="py-1.5 font-mono"><%= r.sku %></td><td class="py-1.5 text-right text-base font-bold"><%= r.quantity %></td><td class="py-1.5 text-right"><%= r.orders %></td></tr><% }) %>
          </tbody>
        </table>
      <% } %>
    </section>

    <% slips.forEach((o) => { %>
      <section class="mt-10 break-before-page border-t-2 border-dashed border-slate-400 pt-6" data-slip="<%= o.orderNumber %>">
        <div class="flex items-start justify-between gap-6">
          <div>
            <p class="text-xs uppercase tracking-wide text-slate-500">JPSME packing slip</p>
            <h2 class="font-mono text-2xl font-bold"><%= o.orderNumber %></h2>
            <p class="text-sm"><%= o.buyerName %> · <%= o.buyerEmail %></p>
          </div>
          <% if (o.qr) { %><div class="text-center"><img src="<%= o.qr %>" alt="Pickup QR" class="h-32 w-32"><p class="text-xs text-slate-500">Pickup</p></div><% } %>
        </div>
        <div class="mt-4 rounded border border-slate-400 p-3 text-sm">
          <% if (o.fulfilment === 'DELIVERY') { %>
            <p class="mb-1 text-xs font-semibold uppercase">Ship to · <%= o.zoneName %></p>
            <% (o.shipLines || []).forEach((l, i) => { %><p class="<%= i === 0 ? 'text-base font-bold' : '' %>"><%= l %></p><% }) %>
          <% } else if (o.pickupPoint) { %>
            <p class="mb-1 text-xs font-semibold uppercase">Pickup at</p>
            <p class="text-base font-bold"><%= o.pickupPoint.name %></p><p><%= o.pickupPoint.address %></p>
          <% } %>
        </div>
        <table class="mt-4 w-full border-collapse text-sm">
          <thead><tr class="border-b border-slate-800 text-left"><th class="py-1">✓</th><th class="py-1">Item</th><th class="py-1">SKU</th><th class="py-1 text-right">Qty</th></tr></thead>
          <tbody><% o.items.forEach((i) => { %><tr class="border-b border-slate-200"><td class="py-1">☐</td><td class="py-1"><%= i.productName %> (<%= i.label %>)</td><td class="py-1 font-mono"><%= i.sku %></td><td class="py-1 text-right font-bold"><%= i.quantity %></td></tr><% }) %></tbody>
        </table>
        <p class="mt-3 text-sm">Paid: <strong><%= peso(o.total) %></strong> (items <%= peso(o.subtotal) %><%= o.deliveryFee ? `, delivery ${peso(o.deliveryFee)}` : '' %>)</p>
      </section>
    <% }) %>
  </div>
  <script nonce="<%= cspNonce %>">
    document.querySelector('[data-print]').addEventListener('click', () => window.print());
  </script>
</body>
</html>
