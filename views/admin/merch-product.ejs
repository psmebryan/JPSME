<%#
  Merchandise -> one product (phase 1): its details and On sale switch, up to
  six photos, and its variants with member price, non-member price, unit cost,
  limit per buyer and low-stock level. Every price or cost change is kept
  (History). Stock is shown here but changed only on the Inventory page.
  Phase 4: the cost appears only with cost.view (the server has already taken
  it out otherwise), and the edit controls only with catalog.edit.
%>
<%
  const p = product;
  const peso = (c) => (c === null || c === undefined ? null : '₱' + (c / 100).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
  const seeCost = locals.merchCaps ? merchCaps.has('cost.view') : true;
  const canEdit = locals.merchCaps ? merchCaps.has('catalog.edit') : true;
  const stockBadge = { OK: ['badge-green', 'In stock'], LOW: ['badge-amber', 'Low'], SOLD_OUT: ['badge-red', 'Sold out'] };
%>
<div class="w-full space-y-6" id="merch-product" data-product-id="<%= p.id %>" data-max-photos="<%= maxPhotos %>">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <a href="/admin/merch/products" class="text-sm text-indigo-600 hover:underline">&larr; All products</a>
      <h1 class="admin-h1 mt-1"><%= p.name %></h1>
    </div>
    <a href="/admin/merch/inventory?product=<%= p.id %>" class="btn-secondary px-4 py-2">Stock for this product</a>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <%# ---------- variants ---------- %>
    <div class="admin-card overflow-hidden">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-5 py-4">
        <div>
          <h2 class="font-semibold text-slate-900">Variants and prices</h2>
          <p class="text-xs text-slate-500">One row per size or colour sold. Leave a price or cost empty until it is decided.</p>
        </div>
        <% if (canEdit) { %><div class="flex gap-2">
          <button type="button" class="btn-secondary px-3 py-2 text-sm" data-open-setprices <%= p.variants.length ? '' : 'disabled' %>>Set prices</button>
          <button type="button" class="btn-secondary px-3 py-2 text-sm" data-open-bulk>Add several sizes</button>
          <button type="button" class="btn-primary px-3 py-2 text-sm" data-open-variant>+ Add variant</button>
        </div><% } %>
      </div>
      <div class="overflow-x-auto">
        <table class="admin-table">
          <thead class="admin-table-head">
            <tr>
              <th class="admin-th">Variant</th>
              <th class="admin-th">SKU</th>
              <th class="admin-th text-right">Member</th>
              <th class="admin-th text-right">Non-member</th>
              <% if (seeCost) { %><th class="admin-th text-right">Cost</th><% } %>
              <th class="admin-th text-right">Limit</th>
              <th class="admin-th text-right">On hand</th>
              <th class="admin-th">On</th>
              <th class="admin-th text-right">Action</th>
            </tr>
          </thead>
          <tbody class="admin-tbody">
            <% p.variants.forEach((v) => { %>
              <tr class="admin-tr" data-variant='<%= JSON.stringify(v) %>'>
                <td class="admin-td font-medium text-slate-900"><%= v.label %></td>
                <td class="admin-td font-mono text-xs"><%= v.sku %></td>
                <td class="admin-td text-right tabular-nums"><%= peso(v.memberPriceCentavos) || '' %><% if (v.memberPriceCentavos === null) { %><span class="badge-amber">TBD</span><% } %></td>
                <td class="admin-td text-right tabular-nums"><%= peso(v.priceCentavos) || '' %><% if (v.priceCentavos === null) { %><span class="badge-amber">TBD</span><% } %></td>
                <% if (seeCost) { %><td class="admin-td text-right tabular-nums text-slate-500"><%= peso(v.costCentavos) || 'TBD' %></td><% } %>
                <td class="admin-td text-right tabular-nums"><%= v.limitPerBuyer || '—' %></td>
                <td class="admin-td text-right">
                  <span class="tabular-nums"><%= v.onHand %></span>
                  <% if (v.stockState !== 'OK') { %><span class="ml-1 <%= stockBadge[v.stockState][0] %>"><%= stockBadge[v.stockState][1] %></span><% } %>
                </td>
                <td class="admin-td"><span class="<%= v.isActive ? 'badge-green' : 'badge-slate' %>"><%= v.isActive ? 'On' : 'Off' %></span></td>
                <td class="admin-td whitespace-nowrap text-right">
                  <% if (canEdit) { %><button type="button" class="mr-3 text-sm text-indigo-600 hover:underline" data-edit-variant>Edit</button><% } %>
                  <button type="button" class="text-sm text-slate-600 hover:underline" data-history>History</button>
                  <% if (canEdit) { %><button type="button" class="ml-3 text-sm text-red-600 hover:underline" data-remove-variant>Remove</button><% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <% if (!p.variants.length) { %>
          <p class="px-5 py-8 text-center text-sm text-slate-500">No variants yet. A pin or lanyard needs one; a polo shirt needs one per size and colour.</p>
        <% } %>
      </div>
    </div>

    <%# ---------- details and photos ---------- %>
    <div class="space-y-6">
      <form id="product-form" class="admin-card p-5">
        <fieldset class="space-y-4" <%= canEdit ? '' : 'disabled' %>>
        <h2 class="font-semibold text-slate-900">Details</h2>
        <div>
          <label for="pd-name" class="form-label">Name</label>
          <input id="pd-name" name="name" maxlength="80" required value="<%= p.name %>" class="form-input">
        </div>
        <div>
          <label for="pd-desc" class="form-label">Description</label>
          <textarea id="pd-desc" name="description" rows="4" maxlength="4000" class="form-input"><%= p.description || '' %></textarea>
        </div>
        <label class="flex cursor-pointer items-center justify-between gap-3">
          <span>
            <span class="block text-sm font-medium text-slate-800">On sale</span>
            <span class="block text-xs text-slate-500">Members will see it once the store opens.</span>
          </span>
          <span class="relative inline-flex items-center">
            <input type="checkbox" name="isActive" class="peer sr-only" <%= p.isActive ? 'checked' : '' %>>
            <span class="h-6 w-11 rounded-full bg-slate-300 transition-colors peer-checked:bg-emerald-600"></span>
            <span class="pointer-events-none absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5"></span>
          </span>
        </label>
        <% if (canEdit) { %><div class="flex justify-between gap-2 border-t border-slate-100 pt-4">
          <button type="button" class="text-sm text-red-600 hover:underline" data-remove-product>Remove product</button>
          <button type="submit" class="btn-primary px-4 py-2">Save</button>
        </div><% } %>
        </fieldset>
      </form>

      <div class="admin-card space-y-3 p-5">
        <div class="flex items-center justify-between">
          <h2 class="font-semibold text-slate-900">Photos <span class="text-sm font-normal text-slate-400"><%= p.images.length %>/<%= maxPhotos %></span></h2>
          <% if (canEdit) { %><label class="btn-secondary cursor-pointer px-3 py-1.5 text-sm <%= p.images.length >= maxPhotos ? 'pointer-events-none opacity-50' : '' %>">
            Add photos
            <input type="file" accept="image/png,image/jpeg,image/webp" multiple class="sr-only" data-photo-input <%= p.images.length >= maxPhotos ? 'disabled' : '' %>>
          </label><% } %>
        </div>
        <ul class="grid grid-cols-3 gap-2">
          <% p.images.forEach((img) => { %>
            <li class="group relative overflow-hidden rounded-lg border border-slate-200">
              <img src="<%= img.url %>" alt="" class="aspect-square w-full object-cover">
              <% if (canEdit) { %><button type="button" class="absolute right-1 top-1 rounded bg-red-600 px-1.5 text-xs text-white opacity-100 sm:opacity-0 sm:group-hover:opacity-100" data-remove-photo="<%= img.id %>" aria-label="Remove photo">Remove</button><% } %>
            </li>
          <% }) %>
        </ul>
        <% if (!p.images.length) { %><p class="text-sm text-slate-400">No photos yet. PNG, JPEG or WEBP, 5 MB each.</p><% } %>
      </div>
    </div>
  </div>
</div>

<%# Add or edit one variant. %>
<dialog id="variant-dialog" class="w-full max-w-xl rounded-xl p-0 shadow-xl backdrop:bg-slate-900/40">
  <form id="variant-form" class="space-y-4 p-6">
    <input type="hidden" name="variantId">
    <div class="flex items-start justify-between">
      <h2 class="text-lg font-semibold text-slate-900" data-variant-title>Add variant</h2>
      <button type="button" class="text-xl text-slate-400 hover:text-slate-600" data-close aria-label="Close">&times;</button>
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <label for="vf-label" class="form-label">Variant name</label>
        <input id="vf-label" name="label" maxlength="80" required placeholder="e.g. Navy / L, or Standard" class="form-input">
      </div>
      <div><label for="vf-size" class="form-label">Size</label><input id="vf-size" name="size" maxlength="20" placeholder="e.g. L" class="form-input"></div>
      <div><label for="vf-color" class="form-label">Colour</label><input id="vf-color" name="color" maxlength="30" placeholder="e.g. Navy" class="form-input"></div>
      <div class="sm:col-span-2">
        <label for="vf-sku" class="form-label">SKU <span class="font-normal text-slate-400">(empty = made from the name)</span></label>
        <input id="vf-sku" name="sku" maxlength="40" placeholder="e.g. POLO-NAVY-L" class="form-input font-mono uppercase">
      </div>
      <div><label for="vf-mp" class="form-label">Member price (PHP)</label><input id="vf-mp" name="memberPrice" type="text" inputmode="decimal" autocomplete="off" placeholder="TBD" data-price class="form-input"></div>
      <div><label for="vf-p" class="form-label">Non-member price (PHP)</label><input id="vf-p" name="price" type="text" inputmode="decimal" autocomplete="off" placeholder="TBD" data-price class="form-input"></div>
      <% if (seeCost) { %><div><label for="vf-cost" class="form-label">Unit cost (PHP)</label><input id="vf-cost" name="cost" type="text" inputmode="decimal" autocomplete="off" placeholder="TBD" data-price class="form-input"></div><% } %>
      <div><label for="vf-limit" class="form-label">Limit per buyer</label><input id="vf-limit" name="limitPerBuyer" type="number" min="1" max="1000" step="1" placeholder="No limit" class="form-input"></div>
      <div><label for="vf-low" class="form-label">Low-stock level</label><input id="vf-low" name="lowStockLevel" type="number" min="0" step="1" placeholder="e.g. 5" class="form-input"></div>
      <label class="flex items-center gap-2 self-end pb-2 text-sm text-slate-700"><input type="checkbox" name="isActive" checked> On</label>
    </div>
    <div class="flex justify-end gap-2 border-t border-slate-100 pt-4">
      <button type="button" class="btn-secondary px-4 py-2" data-close>Cancel</button>
      <button type="submit" class="btn-primary px-4 py-2">Save</button>
    </div>
  </form>
</dialog>

<%# Several sizes in one colour, at the same prices. %>
<dialog id="bulk-dialog" class="w-full max-w-lg rounded-xl p-0 shadow-xl backdrop:bg-slate-900/40">
  <form id="bulk-form" class="space-y-4 p-6">
    <div class="flex items-start justify-between">
      <h2 class="text-lg font-semibold text-slate-900">Add several sizes</h2>
      <button type="button" class="text-xl text-slate-400 hover:text-slate-600" data-close aria-label="Close">&times;</button>
    </div>
    <div><label for="bk-sizes" class="form-label">Sizes, separated by commas</label><input id="bk-sizes" name="sizes" value="XS, S, M, L, XL, 2XL, 3XL" class="form-input"></div>
    <div><label for="bk-color" class="form-label">Colour <span class="font-normal text-slate-400">(optional)</span></label><input id="bk-color" name="color" maxlength="30" placeholder="e.g. Navy" class="form-input"></div>
    <div class="grid gap-3 sm:grid-cols-3">
      <div><label for="bk-mp" class="form-label">Member (PHP)</label><input id="bk-mp" name="memberPrice" type="text" inputmode="decimal" autocomplete="off" placeholder="TBD" data-price class="form-input"></div>
      <div><label for="bk-p" class="form-label">Non-member (PHP)</label><input id="bk-p" name="price" type="text" inputmode="decimal" autocomplete="off" placeholder="TBD" data-price class="form-input"></div>
      <% if (seeCost) { %><div><label for="bk-cost" class="form-label">Cost (PHP)</label><input id="bk-cost" name="cost" type="text" inputmode="decimal" autocomplete="off" placeholder="TBD" data-price class="form-input"></div><% } %>
    </div>
    <p class="text-xs text-slate-500">Makes one variant per size, named "Colour / Size", each with its own SKU.</p>
    <div class="flex justify-end gap-2 border-t border-slate-100 pt-4">
      <button type="button" class="btn-secondary px-4 py-2" data-close>Cancel</button>
      <button type="submit" class="btn-primary px-4 py-2">Add sizes</button>
    </div>
  </form>
</dialog>

<%# One set of prices for many variants: one colour, or all of them. Only the
    boxes filled in are changed; each change is kept in price history. %>
<% const colours = Array.from(new Set(p.variants.map((v) => v.color).filter(Boolean))); %>
<dialog id="setprices-dialog" class="w-full max-w-lg rounded-xl p-0 shadow-xl backdrop:bg-slate-900/40">
  <form id="setprices-form" class="space-y-4 p-6">
    <div class="flex items-start justify-between">
      <h2 class="text-lg font-semibold text-slate-900">Set prices</h2>
      <button type="button" class="text-xl text-slate-400 hover:text-slate-600" data-close aria-label="Close">&times;</button>
    </div>
    <div>
      <label for="sp-scope" class="form-label">Apply to</label>
      <select id="sp-scope" name="scope" class="form-input">
        <% colours.forEach((c) => { %><option value="color:<%= c %>">All <%= c %> variants (<%= p.variants.filter((v) => v.color === c).length %>)</option><% }) %>
        <option value="tbd">Only variants still TBD (<%= p.variants.filter((v) => v.memberPriceCentavos === null || v.priceCentavos === null).length %>)</option>
        <option value="all">All variants (<%= p.variants.length %>)</option>
      </select>
    </div>
    <div class="grid gap-3 sm:grid-cols-3">
      <div><label for="sp-mp" class="form-label">Member (PHP)</label><input id="sp-mp" name="memberPrice" type="text" inputmode="decimal" autocomplete="off" data-price class="form-input"></div>
      <div><label for="sp-p" class="form-label">Non-member (PHP)</label><input id="sp-p" name="price" type="text" inputmode="decimal" autocomplete="off" data-price class="form-input"></div>
      <% if (seeCost) { %><div><label for="sp-cost" class="form-label">Cost (PHP)</label><input id="sp-cost" name="cost" type="text" inputmode="decimal" autocomplete="off" data-price class="form-input"></div><% } %>
    </div>
    <p class="text-xs text-slate-500">Only the boxes you fill in are changed; empty ones keep each variant's current value.</p>
    <div class="flex justify-end gap-2 border-t border-slate-100 pt-4">
      <button type="button" class="btn-secondary px-4 py-2" data-close>Cancel</button>
      <button type="submit" class="btn-primary px-4 py-2">Apply</button>
    </div>
  </form>
</dialog>

<dialog id="history-dialog" class="w-full max-w-lg rounded-xl p-0 shadow-xl backdrop:bg-slate-900/40">
  <div class="space-y-4 p-6">
    <div class="flex items-start justify-between">
      <div><h2 class="text-lg font-semibold text-slate-900">Price history</h2><p class="text-sm text-slate-500" data-history-title></p></div>
      <button type="button" class="text-xl text-slate-400 hover:text-slate-600" data-close aria-label="Close">&times;</button>
    </div>
    <div class="max-h-80 overflow-y-auto" data-history-body></div>
  </div>
</dialog>

<script nonce="<%= cspNonce %>">
(function () {
  const root = document.getElementById('merch-product');
  const id = root.dataset.productId;
  const base = `/api/admin/merch/products/${id}`;
  const esc = (v) => String(v == null ? '' : v).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const peso = (c) => (c === null || c === undefined ? 'empty' : '₱' + (c / 100).toLocaleString('en-PH', { minimumFractionDigits: 2 }));
  const reload = () => window.location.reload();
  // Same rule as the server: "350", "₱350", "1,500.50". A box that is filled
  // but not a price stops the save, instead of quietly saving TBD.
  const PRICE_NAMES = { memberPrice: 'Member price', price: 'Non-member price', cost: 'Unit cost' };
  function badPrice(form) {
    for (const input of form.querySelectorAll('[data-price]')) {
      const raw = input.value.trim().replace(/^(₱|php)\s*/i, '').replace(/[,\s]/g, '');
      if (raw && !/^\d+(\.\d{1,2})?$/.test(raw)) {
        input.focus();
        return `${PRICE_NAMES[input.name] || 'Price'}: enter a number, e.g. 350 or 1,500.50`;
      }
    }
    return null;
  }
  const fail = (err) => showToast(err.message, 'error');
  // Controls a read-only viewer does not have are simply absent.
  const on = (el, ev, fn) => { if (el) el.addEventListener(ev, fn); };
  document.querySelectorAll('dialog [data-close]').forEach((b) => b.addEventListener('click', () => b.closest('dialog').close()));

  // --- details ---
  const pform = document.getElementById('product-form');
  const pf = (n) => pform.elements.namedItem(n);
  pform.addEventListener('submit', async (e) => {
    e.preventDefault();
    try {
      const res = await apiFetch(base, { method: 'PUT', body: JSON.stringify({ name: pf('name').value, description: pf('description').value, isActive: pf('isActive').checked }) });
      showToast(res.message); setTimeout(reload, 400);
    } catch (err) { fail(err); }
  });
  on(root.querySelector('[data-remove-product]'), 'click', async () => {
    if (!confirm('Remove this product and its photos? A product with stock history cannot be removed; switch it off instead.')) return;
    try { await apiFetch(base, { method: 'DELETE' }); window.location.href = '/admin/merch/products'; } catch (err) { fail(err); }
  });

  // --- photos ---
  on(root.querySelector('[data-photo-input]'), 'change', async (e) => {
    const files = Array.from(e.target.files || []);
    e.target.value = '';
    if (!files.length) return;
    if (files.some((f) => f.size > 5 * 1024 * 1024)) { showToast('Each photo must be 5 MB or less.', 'error'); return; }
    const data = new FormData();
    files.forEach((f) => data.append('photos', f));
    try { const res = await apiFetch(`${base}/photos`, { method: 'POST', body: data }); showToast(res.message); setTimeout(reload, 400); } catch (err) { fail(err); }
  });
  root.addEventListener('click', async (e) => {
    const b = e.target.closest('[data-remove-photo]');
    if (!b || !confirm('Remove this photo?')) return;
    try { await apiFetch(`${base}/photos/${b.getAttribute('data-remove-photo')}`, { method: 'DELETE' }); reload(); } catch (err) { fail(err); }
  });

  // --- variants ---
  const vdialog = document.getElementById('variant-dialog');
  const vform = document.getElementById('variant-form');
  const vf = (n) => vform.elements.namedItem(n);
  const pesoField = (c) => (c === null || c === undefined ? '' : (c / 100).toFixed(2));
  function openVariant(v) {
    vform.reset();
    vf('variantId').value = v ? v.id : '';
    vdialog.querySelector('[data-variant-title]').textContent = v ? `Edit ${v.label}` : 'Add variant';
    if (v) {
      ['label', 'size', 'color', 'sku'].forEach((k) => { vf(k).value = v[k] || ''; });
      vf('memberPrice').value = pesoField(v.memberPriceCentavos);
      vf('price').value = pesoField(v.priceCentavos);
      if (vf('cost')) vf('cost').value = pesoField(v.costCentavos);
      vf('limitPerBuyer').value = v.limitPerBuyer || '';
      vf('lowStockLevel').value = v.lowStockLevel === null ? '' : v.lowStockLevel;
      vf('isActive').checked = v.isActive;
    }
    vdialog.showModal();
    vf('label').focus();
  }
  on(root.querySelector('[data-open-variant]'), 'click', () => openVariant(null));
  vform.addEventListener('submit', async (e) => {
    e.preventDefault();
    const problem = badPrice(vform);
    if (problem) { showToast(problem, 'error'); return; }
    const variantId = vf('variantId').value;
    const body = {};
    ['label', 'size', 'color', 'sku', 'memberPrice', 'price', 'cost', 'limitPerBuyer', 'lowStockLevel'].forEach((k) => { if (vf(k)) body[k] = vf(k).value; });
    body.isActive = vf('isActive').checked;
    try {
      const res = await apiFetch(variantId ? `${base}/variants/${variantId}` : `${base}/variants`, { method: variantId ? 'PUT' : 'POST', body: JSON.stringify(body) });
      showToast(res.message); setTimeout(reload, 400);
    } catch (err) { fail(err); }
  });
  root.addEventListener('click', async (e) => {
    const tr = e.target.closest('tr[data-variant]');
    if (!tr) return;
    const v = JSON.parse(tr.getAttribute('data-variant'));
    if (e.target.closest('[data-edit-variant]')) openVariant(v);
    if (e.target.closest('[data-remove-variant]')) {
      if (!confirm(`Remove "${v.label}"? A variant with stock history cannot be removed; switch it off instead.`)) return;
      try { await apiFetch(`${base}/variants/${v.id}`, { method: 'DELETE' }); reload(); } catch (err) { fail(err); }
    }
    if (e.target.closest('[data-history]')) {
      const hd = document.getElementById('history-dialog');
      hd.querySelector('[data-history-title]').textContent = `${v.label} · ${v.sku}`;
      const body = hd.querySelector('[data-history-body]');
      body.innerHTML = '<p class="text-sm text-slate-400">Loading…</p>';
      hd.showModal();
      try {
        const res = await apiFetch(`/api/admin/merch/variants/${v.id}/price-history`);
        body.innerHTML = res.data.history.length ? `<ul class="divide-y divide-slate-100 text-sm">${res.data.history.map((h) => `
          <li class="py-2"><span class="font-medium text-slate-800">${esc(h.fieldLabel)}</span>: ${esc(peso(h.oldValue))} &rarr; <span class="font-medium">${esc(peso(h.newValue))}</span>
          <span class="block text-xs text-slate-500">${esc(h.by || 'Unknown')} · ${esc(new Date(h.at).toLocaleString('en-PH'))}</span></li>`).join('')}</ul>`
          : '<p class="text-sm text-slate-500">No price or cost set yet.</p>';
      } catch (err) { body.innerHTML = ''; fail(err); }
    }
  });

  // --- one set of prices for many variants ---
  const spdialog = document.getElementById('setprices-dialog');
  const spform = document.getElementById('setprices-form');
  const sp = (n) => spform.elements.namedItem(n);
  on(root.querySelector('[data-open-setprices]'), 'click', () => { spform.reset(); spdialog.showModal(); });
  spform.addEventListener('submit', async (e) => {
    e.preventDefault();
    const problem = badPrice(spform);
    if (problem) { showToast(problem, 'error'); return; }
    const body = {};
    ['memberPrice', 'price', 'cost'].forEach((k) => { if (sp(k) && sp(k).value.trim()) body[k] = sp(k).value; });
    if (!Object.keys(body).length) { showToast('Fill in at least one price.', 'error'); return; }
    const scope = sp('scope').value;
    const all = Array.from(root.querySelectorAll('tr[data-variant]')).map((tr) => JSON.parse(tr.getAttribute('data-variant')));
    const targets = all.filter((v) => (scope === 'all') || (scope === 'tbd' && (v.memberPriceCentavos === null || v.priceCentavos === null))
      || (scope.startsWith('color:') && v.color === scope.slice(6)));
    let done = 0;
    for (const v of targets) {
      try { await apiFetch(`${base}/variants/${v.id}`, { method: 'PUT', body: JSON.stringify(body) }); done += 1; } catch (err) { showToast(`${v.label}: ${err.message}`, 'error'); }
    }
    showToast(`Prices set on ${done} of ${targets.length} variants.`);
    setTimeout(reload, 600);
  });

  // --- several sizes at once ---
  const bdialog = document.getElementById('bulk-dialog');
  const bform = document.getElementById('bulk-form');
  const bf = (n) => bform.elements.namedItem(n);
  on(root.querySelector('[data-open-bulk]'), 'click', () => bdialog.showModal());
  bform.addEventListener('submit', async (e) => {
    e.preventDefault();
    const problem = badPrice(bform);
    if (problem) { showToast(problem, 'error'); return; }
    const sizes = bf('sizes').value.split(',').map((s) => s.trim()).filter(Boolean);
    if (!sizes.length) { showToast('Enter at least one size.', 'error'); return; }
    const color = bf('color').value.trim();
    let made = 0;
    for (const size of sizes) {
      try {
        await apiFetch(`${base}/variants`, {
          method: 'POST',
          body: JSON.stringify({ label: color ? `${color} / ${size}` : size, size, color, memberPrice: bf('memberPrice').value, price: bf('price').value, cost: bf('cost') ? bf('cost').value : undefined }),
        });
        made += 1;
      } catch (err) { showToast(`${size}: ${err.message}`, 'error'); }
    }
    showToast(`${made} of ${sizes.length} sizes added.`);
    setTimeout(reload, 600);
  });
}());
</script>
