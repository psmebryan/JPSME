<% const chaptersWithStats = locals.chaptersWithStats || []; const chapters = locals.chapters || []; const users = locals.users || []; %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="admin-h1">Chapter Admins</h1>
    <p class="admin-subtitle">Each chapter's leader, at a glance. Click a chapter to view its full member list.</p>
  </div>
  <button id="toggle-assign-panel" type="button" class="btn-primary">
    + Assign Chapter Admin
  </button>
</div>

<!-- Assign panel: hidden by default, toggled by the button above -->
<div id="assign-panel" class="hidden admin-card p-6 mb-8">
  <h2 class="font-semibold mb-4">Assign Chapter Admin</h2>
  <form id="assign-form" class="grid sm:grid-cols-3 gap-4 items-end">
    <div>
      <label class="form-label">Chapter</label>
      <select id="assign-chapterId" name="chapterId" required class="form-input">
        <option value="">Select a chapter</option>
        <% chapters.forEach(c => { %>
          <option value="<%= c.id %>"><%= c.name %></option>
        <% }) %>
      </select>
    </div>
    <div>
      <label class="form-label">User</label>
      <select id="assign-userId" name="userId" required class="form-input">
        <option value="">Select a user</option>
        <% users.forEach(u => { %>
          <option value="<%= u.id %>"><%= u.firstName %> <%= u.lastName %> — <%= u.email %></option>
        <% }) %>
      </select>
    </div>
    <div class="flex gap-2">
      <input type="text" id="assign-note" placeholder="Note (optional)" class="form-input">
      <button type="submit" class="shrink-0 btn-primary">Assign</button>
    </div>
  </form>
</div>

<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
  <% chaptersWithStats.forEach(chapter => { %>
    <% const leader = chapter.chapterAdmin ? chapter.chapterAdmin.user : null; %>
    <% const memberCount = chapter._count ? chapter._count.users : 0; %>
    <div class="relative admin-card hover:shadow-md transition overflow-hidden">

      <!-- Remove button, only when a leader is assigned. Sits outside the
           clickable card body so it never triggers navigation. -->
      <% if (leader) { %>
        <button type="button"
          data-remove-chapter="<%= chapter.id %>"
          data-chapter-name="<%= chapter.name %>"
          class="absolute top-3 right-3 z-10 text-slate-400 hover:text-red-600 bg-white/90 rounded-full p-1.5 shadow-sm"
          title="Remove chapter admin" aria-label="Remove chapter admin">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      <% } %>

      <div class="cursor-pointer" data-view-chapter="<%= chapter.id %>">
        <div class="px-5 pt-6 pb-5 flex flex-col items-center text-center border-b border-slate-100 bg-gradient-to-b from-indigo-50/60 to-white">
          <img src="<%= (leader && leader.profileImage) || '/img/default-avatar.svg' %>" alt=""
               class="h-16 w-16 rounded-full object-cover ring-4 ring-white shadow-sm mb-3">
          <p class="font-semibold text-slate-900 leading-tight"><%= chapter.name %></p>
          <p class="text-xs text-slate-400 mt-0.5"><%= chapter.area ? chapter.area.name : '' %><%= chapter.area && chapter.area.region ? ' · ' + chapter.area.region.name : '' %></p>
        </div>

        <div class="px-5 py-4">
          <% if (leader) { %>
            <p class="text-[11px] font-semibold tracking-wide uppercase text-amber-600 mb-1">Chapter Leader</p>
            <p class="text-sm font-medium text-slate-900 truncate"><%= leader.firstName %> <%= leader.lastName %></p>
            <p class="text-xs text-slate-500 truncate"><%= leader.email %></p>
          <% } else { %>
            <p class="text-[11px] font-semibold tracking-wide uppercase text-slate-400 mb-1">Chapter Leader</p>
            <p class="text-sm text-slate-400 italic">No admin assigned</p>
          <% } %>
        </div>

        <div class="px-5 py-3 border-t border-slate-100 flex items-center justify-between text-sm">
          <span class="text-slate-500">
            <span class="font-semibold text-slate-900"><%= memberCount %></span> member<%= memberCount === 1 ? '' : 's' %>
          </span>
          <span class="text-indigo-600 font-medium text-xs">View members &rarr;</span>
        </div>
      </div>
    </div>
  <% }) %>

  <% if (chaptersWithStats.length === 0) { %>
    <p class="text-slate-500 col-span-full text-center py-10">No chapters found.</p>
  <% } %>
</div>
