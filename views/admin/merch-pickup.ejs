<%#
  Merchandise -> Pickup handover. Scan the buyer's order QR (scanner gun or
  the device camera, via the same qr-camera.js the event doors use) or type
  the order number. The order is shown first, so staff check the items and
  the person, then press Hand over: that marks it Picked up and records who
  handed it over. Event tickets are not order QRs and are refused.
%>
<div class="mx-auto w-full max-w-3xl space-y-6" id="merch-pickup">
  <div>
    <a href="/admin/merch/orders" class="text-sm text-indigo-600 hover:underline">&larr; Orders</a>
    <h1 class="admin-h1 mt-1">Pickup handover</h1>
    <p class="admin-subtitle">Scan the buyer's order QR, or type the order number</p>
  </div>

  <form data-scan-form class="admin-card p-4">
    <label for="scan-input" class="form-label">Order QR or number</label>
    <div class="flex gap-2">
      <input id="scan-input" data-scan-input type="text" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="Waiting for scan… or ORD-2026-000123" class="form-input font-mono">
      <button type="submit" class="btn-primary shrink-0 px-4">Find</button>
      <button type="button" data-qr-camera class="btn-secondary shrink-0 px-4">Use camera</button>
    </div>
  </form>

  <div class="admin-card hidden p-5" data-result>
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p class="font-mono text-lg font-bold" data-number></p>
        <p class="text-slate-700" data-buyer></p>
        <p class="text-sm text-slate-500" data-point></p>
      </div>
      <span class="badge-slate" data-status></span>
    </div>
    <ul class="mt-4 divide-y divide-slate-100 text-sm" data-items></ul>
    <p class="mt-3 text-sm font-medium" data-message></p>
    <button type="button" class="btn-primary mt-4 w-full py-3 text-base" data-handover hidden>Hand over these items</button>
  </div>
</div>

<script src="/js/qr-camera.js"></script>
<script nonce="<%= cspNonce %>">
(function () {
  const root = document.getElementById('merch-pickup');
  const form = root.querySelector('[data-scan-form]');
  const input = root.querySelector('[data-scan-input]');
  const box = root.querySelector('[data-result]');
  const btn = root.querySelector('[data-handover]');
  const msg = root.querySelector('[data-message]');
  let code = '';
  input.focus();

  function show(order) {
    box.classList.remove('hidden');
    box.querySelector('[data-number]').textContent = order.orderNumber;
    box.querySelector('[data-buyer]').textContent = order.buyerName;
    box.querySelector('[data-point]').textContent = order.pickupPoint ? `Pickup at ${order.pickupPoint.name}` : '';
    const status = box.querySelector('[data-status]');
    status.textContent = order.statusLabel;
    status.className = ['READY_FOR_PICKUP', 'UNCLAIMED'].includes(order.status) ? 'badge-green' : 'badge-slate';
    const list = box.querySelector('[data-items]');
    list.textContent = '';
    order.items.forEach((i) => {
      const li = document.createElement('li');
      li.className = 'flex justify-between py-1.5';
      li.innerHTML = '<span></span><span class="font-semibold"></span>';
      li.children[0].textContent = `${i.productName} (${i.label})`;
      li.children[1].textContent = `× ${i.quantity}`;
      list.appendChild(li);
    });
    const ready = ['READY_FOR_PICKUP', 'UNCLAIMED'].includes(order.status);
    btn.hidden = !ready;
    msg.className = `mt-3 text-sm font-medium ${ready ? 'text-slate-700' : 'text-red-700'}`;
    msg.textContent = ready ? 'Check the items and the person, then hand over.' : (order.status === 'PICKED_UP' ? 'Already picked up.' : `Not ready for pickup: ${order.statusLabel}.`);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    code = input.value.trim();
    input.value = '';
    if (!code) return;
    try {
      const res = await apiFetch('/api/admin/merch/handover/lookup', { method: 'POST', body: JSON.stringify({ code }) });
      show(res.data.order);
    } catch (err) {
      box.classList.add('hidden');
      showToast(err.message, 'error');
    }
    input.focus();
  });

  btn.addEventListener('click', async () => {
    btn.disabled = true;
    try {
      const res = await apiFetch('/api/admin/merch/handover', { method: 'POST', body: JSON.stringify({ code }) });
      showToast(res.message);
      show(res.data.order);
    } catch (err) { showToast(err.message, 'error'); }
    btn.disabled = false;
    input.focus();
  });
}());
</script>
