<h1 class="admin-h1 mb-6">Site Settings</h1>

<%#
  Maintenance mode. While it is on, everyone but the main admin sees the
  maintenance page, with a countdown when a duration is set. Saved through
  PUT /api/admin/settings/maintenance; see middleware/maintenance.middleware.
%>
<% const mt = locals.maintenance || { on: false }; %>
<div id="maintenance-module" class="admin-card mb-6 p-6 <%= mt.on ? 'border-amber-300 bg-amber-50' : '' %>" data-on="<%= mt.on ? '1' : '0' %>">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="max-w-2xl">
      <h2 class="font-semibold">Maintenance mode</h2>
      <% if (mt.on) { %>
        <p class="mt-1 text-sm font-semibold text-amber-800" data-maint-status>
          On. The site is closed to everyone but you<%= mt.until ? `, until about ${new Date(mt.until).toLocaleString('en-PH', { timeZone: 'Asia/Manila', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' })}` : '' %>.
        </p>
      <% } else { %>
        <p class="mt-1 text-sm text-slate-500" data-maint-status>Off. The site is open.</p>
      <% } %>
      <p class="mt-2 text-xs text-slate-500">
        While it is on, visitors see a "We're doing some maintenance" page instead of the site, with a countdown if you set how long.
        You can still use the whole site and admin. Payments already started still confirm. The page opens the site by itself when you turn this off.
      </p>
    </div>
    <a href="/" target="_blank" rel="noopener" class="text-sm text-indigo-600 hover:underline">Open the site</a>
  </div>

  <% if (mt.fromEnv) { %>
    <p class="mt-4 rounded-lg border border-amber-300 bg-white px-3 py-2 text-sm text-amber-900">Switched on by the server setting MAINTENANCE_MODE, so it can only be turned off there.</p>
  <% } else { %>
    <div class="mt-5 grid gap-4 sm:grid-cols-[auto_auto_1fr] sm:items-end">
      <div>
        <label class="form-label" for="maint-amount">How long (optional)</label>
        <div class="flex gap-2">
          <input id="maint-amount" type="number" min="1" step="1" inputmode="numeric" class="form-input w-28" placeholder="e.g. 30">
          <select id="maint-unit" class="form-input w-32" aria-label="Unit">
            <option value="1">minutes</option>
            <option value="60">hours</option>
          </select>
        </div>
      </div>
      <div class="sm:col-span-2">
        <label class="form-label" for="maint-message">Message on the page (optional)</label>
        <input id="maint-message" type="text" maxlength="300" class="form-input" value="<%= mt.message || '' %>" placeholder="e.g. We're upgrading the membership system.">
      </div>
    </div>
    <p class="mt-2 text-xs text-slate-500">Leave "How long" empty for no countdown. The site does not reopen by itself when the countdown ends: turn maintenance off when you are done.</p>
    <div class="mt-4 flex flex-wrap gap-2">
      <% if (mt.on) { %>
        <button type="button" class="btn-primary" data-maint="end">End maintenance and open the site</button>
        <button type="button" class="btn-secondary" data-maint="update">Update countdown and message</button>
      <% } else { %>
        <button type="button" class="btn-danger" data-maint="start">Start maintenance</button>
      <% } %>
    </div>
  <% } %>
</div>
<script nonce="<%= cspNonce %>">
(function () {
  const box = document.getElementById('maintenance-module');
  if (!box) return;
  box.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-maint]');
    if (!btn) return;
    const action = btn.getAttribute('data-maint');
    const amount = document.getElementById('maint-amount').value.trim();
    const unit = Number(document.getElementById('maint-unit').value);
    const minutes = amount ? Math.round(Number(amount) * unit) : null;
    if (amount && (!Number.isFinite(minutes) || minutes < 1)) { showToast('Enter how long as a whole number, or leave it empty.', 'error'); return; }
    if (action === 'start' && !confirm(`Close the site to everyone but you${minutes ? ` for about ${amount} ${unit === 60 ? 'hour(s)' : 'minute(s)'}` : ''}?`)) return;
    if (action === 'end' && !confirm('Open the site to everyone again?')) return;
    btn.disabled = true;
    try {
      const body = action === 'end'
        ? { on: false }
        : { on: true, durationMinutes: minutes, message: document.getElementById('maint-message').value };
      const res = await apiFetch('/api/admin/settings/maintenance', { method: 'PUT', body: JSON.stringify(body) });
      showToast(res.message);
      setTimeout(() => window.location.reload(), 500);
    } catch (err) {
      showToast(err.message, 'error');
      btn.disabled = false;
    }
  });
}());
</script>

<%#
  National President access. Ticks decide which admin modules an account with
  the National President role can open; config/adminModules says which pages
  belong to each. Site Settings itself is never offered. Saved through
  PUT /api/admin/settings/president-access (main admin only).
%>
<% const granted = locals.presidentModules || []; %>
<div id="president-access-module" class="admin-card p-6 mb-6">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h2 class="font-semibold mb-1">National President access</h2>
      <p class="text-sm text-slate-500 max-w-2xl">
        Tick what the National President can open in the admin. Everything not ticked is hidden from them and
        refused if they try the address directly. Site Settings, including this list, stays yours alone.
      </p>
    </div>
    <div class="flex gap-2">
      <button type="button" class="btn-secondary px-3 py-1.5 text-sm" data-pa-all>Tick all</button>
      <button type="button" class="btn-secondary px-3 py-1.5 text-sm" data-pa-none>Clear</button>
    </div>
  </div>

  <div class="mt-5 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
    <% (locals.adminModuleList || []).forEach((m) => { %>
      <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 p-3 hover:bg-slate-50 has-[:checked]:border-indigo-300 has-[:checked]:bg-indigo-50/50">
        <input type="checkbox" class="mt-0.5 h-4 w-4 rounded border-slate-300 text-indigo-600" name="presidentModules" value="<%= m.key %>" <%= granted.includes(m.key) ? 'checked' : '' %>>
        <span>
          <span class="block text-sm font-medium text-slate-900"><%= m.label %></span>
          <span class="block text-xs text-slate-500"><%= m.hint %></span>
        </span>
      </label>
    <% }) %>
  </div>

  <div class="mt-5 flex flex-wrap items-center justify-between gap-4 border-t border-slate-200 pt-4">
    <div class="text-sm text-slate-600">
      <% const presidents = locals.presidents || []; %>
      <% if (presidents.length) { %>
        <span class="font-medium text-slate-800">National President:</span>
        <% presidents.forEach((p, i) => { %><a href="/jpsme_admin/users/<%= p.id %>/edit" class="text-indigo-600 hover:underline"><%= p.firstName %> <%= p.lastName %></a><%= i < presidents.length - 1 ? ', ' : '' %><% }) %>
      <% } else { %>
        Nobody has the role yet. Give it on a member's account: <span class="font-medium">Users &rarr; Edit &rarr; Role &rarr; National President</span>.
      <% } %>
    </div>
    <button type="button" class="btn-primary px-4 py-2" data-pa-save>Save access</button>
  </div>
</div>

<script nonce="<%= cspNonce %>">
(function () {
  const box = document.getElementById('president-access-module');
  if (!box) return;
  const boxes = () => Array.from(box.querySelectorAll('input[name="presidentModules"]'));
  box.querySelector('[data-pa-all]').addEventListener('click', () => boxes().forEach((b) => { b.checked = true; }));
  box.querySelector('[data-pa-none]').addEventListener('click', () => boxes().forEach((b) => { b.checked = false; }));
  const save = box.querySelector('[data-pa-save]');
  save.addEventListener('click', async () => {
    save.disabled = true;
    try {
      const res = await apiFetch('/api/admin/settings/president-access', {
        method: 'PUT',
        body: JSON.stringify({ modules: boxes().filter((b) => b.checked).map((b) => b.value) }),
      });
      showToast(res.message);
    } catch (err) {
      showToast(err.message, 'error');
    } finally {
      save.disabled = false;
    }
  });
}());
</script>

<%#
  Finance & Logistics. Each account with that role gets its own ticks:
  Finance tasks, Logistics tasks, Payments (view only), Reports. Saved per
  account through PUT /api/admin/settings/finance-logistics/:userId (main
  admin only). What each task group may do in the store: adminAccess.merchCapsFor.
%>
<% const flAccounts = locals.financeLogistics || []; %>
<div id="fl-access-module" class="admin-card p-6 mb-6">
  <h2 class="font-semibold mb-1">Finance &amp; Logistics access</h2>
  <p class="text-sm text-slate-500 max-w-3xl">
    For the people who run the merchandise store. Tick what each account may do. Finance approves refunds, sees cost
    and profit and checks each day against PayMongo; Logistics handles stock, packing, shipping, pickups and returns.
    One person can have both, but then they still cannot approve a refund they raised themselves.
  </p>
  <% if (!flAccounts.length) { %>
    <p class="mt-4 rounded-lg border border-dashed border-slate-300 px-4 py-3 text-sm text-slate-600">
      Nobody has the role yet. Give it on a member's account: <span class="font-medium">Users &rarr; Edit &rarr; Role &rarr; Finance &amp; Logistics</span>, then tick their tasks here.
    </p>
  <% } %>
  <div class="mt-4 space-y-4">
    <% flAccounts.forEach((a) => { %>
      <div class="rounded-lg border border-slate-200 p-4" data-fl-account="<%= a.id %>">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <p class="text-sm"><a href="/jpsme_admin/users/<%= a.id %>/edit" class="font-semibold text-indigo-600 hover:underline"><%= a.name %></a> <span class="text-slate-500"><%= a.email %></span></p>
          <p class="text-xs text-slate-500"><%= a.grants.length ? '' : 'No tasks yet: they can sign in but see nothing.' %></p>
        </div>
        <div class="mt-3 grid gap-2 sm:grid-cols-2 xl:grid-cols-4">
          <% (locals.flGrantList || []).forEach((g) => { %>
            <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-200 p-3 hover:bg-slate-50 has-[:checked]:border-indigo-300 has-[:checked]:bg-indigo-50/50">
              <input type="checkbox" class="mt-0.5 h-4 w-4 rounded border-slate-300 text-indigo-600" value="<%= g.key %>" <%= a.grants.includes(g.key) ? 'checked' : '' %>>
              <span><span class="block text-sm font-medium text-slate-900"><%= g.label %></span><span class="block text-xs text-slate-500"><%= g.hint %></span></span>
            </label>
          <% }) %>
        </div>
        <div class="mt-3 text-right"><button type="button" class="btn-primary px-4 py-1.5 text-sm" data-fl-save>Save</button></div>
      </div>
    <% }) %>
  </div>
</div>

<script nonce="<%= cspNonce %>">
(function () {
  document.querySelectorAll('[data-fl-account]').forEach((card) => {
    const save = card.querySelector('[data-fl-save]');
    save.addEventListener('click', async () => {
      save.disabled = true;
      try {
        const grants = Array.from(card.querySelectorAll('input[type="checkbox"]')).filter((b) => b.checked).map((b) => b.value);
        const res = await apiFetch(`/api/admin/settings/finance-logistics/${card.dataset.flAccount}`, { method: 'PUT', body: JSON.stringify({ grants }) });
        showToast(res.message);
      } catch (err) {
        showToast(err.message, 'error');
      } finally {
        save.disabled = false;
      }
    });
  });
}());
</script>

<%#
  The four site images, together, because they are one decision: what the
  organisation looks like everywhere it appears. Each says where it shows up,
  since the difference between them is not obvious from a filename.

  All four survive a deploy now - they are stored in the database rather than on
  disk, which the host wipes on every publish.
%>
<div class="admin-card p-6 mb-6">
  <h2 class="font-semibold mb-1">Site Images</h2>
  <p class="mb-5 text-xs text-slate-500">
    PNG, JPEG, WEBP or SVG. These are kept in the database, so they stay put when the site is republished.
  </p>

  <div class="grid gap-5 sm:grid-cols-2">

    <section class="rounded-lg border border-slate-200 p-4">
      <h3 class="text-sm font-semibold text-slate-900">Logo</h3>
      <p class="mt-0.5 mb-3 text-xs text-slate-500">The seal. Shown in the navbar, the footer, both login pages and the home page.</p>
      <div class="mb-3 flex h-24 items-center justify-center rounded border border-slate-200 bg-slate-50 p-2">
        <img id="logo-preview" src="<%= logoUrl %>" alt="Current logo" class="max-h-full max-w-full object-contain">
      </div>
      <form id="logo-form" class="space-y-2">
        <input type="file" name="logo" accept="image/png,image/jpeg,image/webp,image/svg+xml" required
          class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2">
        <button type="submit" class="btn-primary w-full">Upload Logo</button>
      </form>
    </section>

    <section class="rounded-lg border border-slate-200 p-4">
      <h3 class="text-sm font-semibold text-slate-900">Favicon <span class="font-normal text-slate-400">&mdash; optional</span></h3>
      <p class="mt-0.5 mb-3 text-xs text-slate-500">
        The small icon in the browser tab. <strong>Your logo is used automatically</strong>, so you only need this if you
        want something different &mdash; a seal with a ring of lettering can turn to mush at 16 pixels, so a
        simplified crop often reads better.
      </p>
      <div class="mb-3 flex h-24 items-center justify-center gap-4 rounded border border-slate-200 bg-slate-50 p-2">
        <%# Shown at the size it is actually used, beside a legible one. Picking
            favicon artwork by looking at a large preview is how an unreadable
            one gets chosen. %>
        <img id="favicon-preview" src="<%= faviconUrl %>" alt="Current favicon" class="h-12 w-12 object-contain">
        <span class="flex flex-col items-center gap-1">
          <img src="<%= faviconUrl %>" alt="" class="h-4 w-4 object-contain">
          <span class="text-[10px] text-slate-400">actual size</span>
        </span>
      </div>
      <form id="favicon-form" class="space-y-2">
        <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/svg+xml" required
          class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2">
        <button type="submit" class="btn-secondary w-full">Upload Favicon</button>
      </form>
    </section>

    <section class="rounded-lg border border-slate-200 p-4">
      <h3 class="text-sm font-semibold text-slate-900">Home Page Banner</h3>
      <p class="mt-0.5 mb-3 text-xs text-slate-500">Sits behind the top of the home page. Wide and short works best &mdash; around 1500&times;500. Leave it unset for the built-in blueprint artwork.</p>
      <div class="mb-3 flex h-24 items-center justify-center overflow-hidden rounded border border-slate-200 bg-slate-50">
        <% if (heroImageUrl) { %>
          <img id="hero-preview" src="<%= heroImageUrl %>" alt="Current banner" class="h-full w-full object-cover">
        <% } else { %>
          <img id="hero-preview" src="" alt="" class="hidden h-full w-full object-cover">
          <span id="hero-empty" class="text-xs text-slate-400">Using the built-in blueprint</span>
        <% } %>
      </div>
      <form id="hero-form" class="space-y-2">
        <input type="file" name="image" accept="image/png,image/jpeg,image/webp" required
          class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2">
        <button type="submit" class="btn-secondary w-full">Upload Banner</button>
      </form>
    </section>

    <section class="rounded-lg border border-slate-200 p-4">
      <h3 class="text-sm font-semibold text-slate-900">Link Preview</h3>
      <p class="mt-0.5 mb-3 text-xs text-slate-500">What Messenger, Facebook and Viber show when someone shares the site. A square around 1080&times;1080 suits it. Falls back to the logo.</p>
      <div class="mb-3 flex h-24 items-center justify-center rounded border border-slate-200 bg-slate-50 p-2">
        <img id="og-preview" src="<%= ogImageUrl || logoUrl %>" alt="Current link preview" class="max-h-full max-w-full object-contain">
      </div>
      <form id="og-form" class="space-y-2">
        <input type="file" name="image" accept="image/png,image/jpeg,image/webp" required
          class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2">
        <button type="submit" class="btn-secondary w-full">Upload Preview Image</button>
      </form>
    </section>

  </div>
</div>

<%# No membership fee here: each member type's amount on the Master List is
    the fee. This rate is the channel fee added on top of it at checkout. %>
<%# The small one-setting cards sit side by side, so the page uses the width. %>
<div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-2 2xl:grid-cols-4">
<div class="admin-card p-6">
  <h2 class="font-semibold mb-1">PayMongo Channel Fee</h2>
  <p class="mb-4 text-xs text-slate-500">
    PayMongo deducts this percentage from every GCash charge before crediting JPSME. Set here so the payer
    covers it instead of JPSME absorbing it — charged as its own itemized line on PayMongo's checkout page.
    Current PayMongo GCash rate (incl. 12% VAT) is about 2.50% — check paymongo.com/pricing if this ever needs updating.
    This is an upfront estimate; the admin Payments report separately shows PayMongo's actual deducted fee once each payment settles.
  </p>
  <form id="gateway-surcharge-form" class="space-y-3">
    <div class="relative">
      <input
        id="gateway-surcharge-input"
        name="percent"
        type="number"
        min="0"
        max="100"
        step="0.0001"
        value="<%= gatewaySurchargePercent %>"
        required
        class="form-input pr-8">
      <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-slate-500">%</span>
    </div>
    <button type="submit" class="btn-primary">
      Save Channel Fee
    </button>
  </form>
</div>

<div id="membership-required-module" class="admin-card p-6">
  <h2 class="font-semibold mb-1">Membership payment</h2>
  <p class="mb-4 text-xs text-slate-500">
    When optional, anyone can register and use the site straight away and may settle the
    fee later &mdash; their account and details are kept either way. When required, a new
    member is held on the payment page until their payment clears. Admin approval is
    unaffected by this setting.
  </p>
  <label class="flex items-center gap-3 cursor-pointer">
    <input id="membership-required-checkbox" type="checkbox" <%= membershipPaymentRequired ? 'checked' : '' %> class="h-5 w-5 rounded border-slate-300">
    <span id="membership-required-label" class="text-sm font-medium <%= membershipPaymentRequired ? 'text-amber-700' : 'text-green-700' %>">
      <%= membershipPaymentRequired ? 'Payment required to use the site' : 'Membership payment is optional' %>
    </span>
  </label>
</div>

<div id="payments-enabled-module" class="admin-card p-6" data-enabled="<%= paymentsEnabled ? '1' : '0' %>">
  <h2 class="font-semibold mb-1">Payments</h2>
  <p class="mb-4 text-xs text-slate-500">Kill switch for new payment checkouts (membership and event fees). Disabling this does not affect payments already in progress — their webhook confirmation still works normally.</p>
  <label class="flex items-center gap-3 cursor-pointer">
    <input id="payments-enabled-checkbox" type="checkbox" <%= paymentsEnabled ? 'checked' : '' %> class="h-5 w-5 rounded border-slate-300">
    <span id="payments-enabled-label" class="text-sm font-medium <%= paymentsEnabled ? 'text-green-700' : 'text-red-700' %>">
      <%= paymentsEnabled ? 'Payments enabled' : 'Payments disabled' %>
    </span>
  </label>
</div>

<div id="registration-emails-module" class="admin-card p-6">
  <h2 class="font-semibold mb-1">Event registration emails</h2>
  <p class="mb-4 text-xs text-slate-500">
    The confirmation email (with the e-ticket) sent when someone registers for an event. Turn it off when the
    daily email limit is tight, so password resets and verification codes still go out. Registering still works,
    and each member's ticket stays on the event's ticket page.
  </p>
  <label class="flex items-center gap-3 cursor-pointer">
    <input id="registration-emails-checkbox" type="checkbox" <%= locals.registrationEmailsEnabled !== false ? 'checked' : '' %> class="h-5 w-5 rounded border-slate-300">
    <span id="registration-emails-label" class="text-sm font-medium <%= locals.registrationEmailsEnabled !== false ? 'text-green-700' : 'text-red-700' %>">
      <%= locals.registrationEmailsEnabled !== false ? 'Confirmation emails on' : 'Confirmation emails off' %>
    </span>
  </label>
</div>
</div>

<%# Flood guard (src/middleware/floodGuard.middleware.js): an IP that sends too
    many requests too fast is refused for a while. Listed here so a block that
    caught a real network (a campus, a venue) can be lifted at once. %>
<% const fg = locals.floodGuard; %>
<% if (fg) { %>
<div id="blocked-ips-module" class="admin-card p-6 mt-6">
  <h2 class="font-semibold mb-1">Blocked IP addresses</h2>
  <p class="mb-4 text-xs text-slate-500">
    <% if (fg.enabled) { %>
      An address that sends more than <strong><%= fg.max %></strong> requests in <strong><%= fg.windowSeconds %> seconds</strong> is blocked for
      <strong><%= fg.blockMinutes %> minutes</strong>. Pictures, styles and scripts do not count. A whole campus or venue can share one
      address, so lift a block here if real people were caught. Large attacks from many addresses are stopped at Cloudflare.
    <% } else { %>
      The flood guard is <strong>off</strong> on this server (it is on by default in production; FLOOD_GUARD in the environment).
    <% } %>
  </p>
  <% if (!fg.blocked.length) { %>
    <p class="text-sm text-emerald-700" data-no-blocked>No address is blocked right now.</p>
  <% } else { %>
    <div class="relative overflow-x-auto">
      <table class="admin-table">
        <thead class="admin-table-head"><tr><th class="admin-th">Address</th><th class="admin-th">Blocked</th><th class="admin-th">Until</th><th class="admin-th text-right">Refused since</th><th class="admin-th"></th></tr></thead>
        <tbody class="admin-tbody">
          <% fg.blocked.forEach((b) => { %>
            <tr class="admin-tr" data-blocked-ip="<%= b.ip %>">
              <td class="admin-td font-mono text-xs"><%= b.ip %></td>
              <td class="admin-td text-xs"><%= b.since.toLocaleString('en-PH', { timeZone: 'Asia/Manila', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) %></td>
              <td class="admin-td text-xs"><%= b.until.toLocaleString('en-PH', { timeZone: 'Asia/Manila', hour: 'numeric', minute: '2-digit' }) %></td>
              <td class="admin-td text-right tabular-nums"><%= b.refused %></td>
              <td class="admin-td text-right"><button type="button" class="btn-secondary px-3 py-1 text-sm" data-unblock>Unblock</button></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
  <% if (fg.allowlist.length) { %><p class="mt-3 text-xs text-slate-500">Never blocked: <span class="font-mono"><%= fg.allowlist.join(', ') %></span></p><% } %>
</div>
<script nonce="<%= cspNonce %>">
(function () {
  const box = document.getElementById('blocked-ips-module');
  if (!box) return;
  box.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-unblock]');
    if (!btn) return;
    const row = btn.closest('[data-blocked-ip]');
    btn.disabled = true;
    try {
      const res = await apiFetch('/api/admin/settings/blocked-ips/unblock', { method: 'POST', body: JSON.stringify({ ip: row.getAttribute('data-blocked-ip') }) });
      showToast(res.message);
      row.remove();
    } catch (err) {
      showToast(err.message, 'error');
      btn.disabled = false;
    }
  });
}());
</script>
<% } %>

<div id="data-export-module" class="admin-card p-6 mt-6">
  <h2 class="font-semibold mb-1">Data export</h2>
  <p class="mb-4 text-xs text-slate-500">
    Download everything as one Excel workbook &mdash; organizations, members, events,
    registrations, payments and invitations, one sheet each &mdash; for offline tracking.
  </p>

  <div class="flex flex-wrap gap-2">
    <a href="/api/admin/data/export" class="btn-primary inline-block">Export to Excel</a>
  </div>

  <%# ---- Importing moved out ---------------------------------------------
      The export stays here because it is a whole-database dump: every table,
      for offline tracking and backup. That is a settings concern.

      Importing members is not. It was the first step of a three-step job —
      import the sheet, send the activation links, then watch who actually got
      in — and the other two steps live on the Activations page. Splitting the
      first one off onto a settings page meant the person doing that job had to
      start somewhere that showed them nothing about how it went.

      Note the wrapper id above is deliberately NOT data-transfer-module any
      more: admin.js binds the import handlers to that id, and leaving it here
      would bind them to a page with no import controls on it. %>
  <div class="mt-6 pt-5 border-t border-slate-200">
    <h3 class="text-sm font-semibold text-slate-800">Adding members from a spreadsheet</h3>
    <p class="mt-1 text-xs text-slate-500">
      Importing members, sending their activation links, and tracking what became of them are all
      on one page now.
    </p>
    <p class="mt-3 text-sm text-slate-700">
      <span data-pending-activations class="font-semibold"><%= typeof pendingActivations !== 'undefined' ? pendingActivations : 0 %></span>
      member(s) waiting to be invited.
    </p>
    <%# No data-admin-link: admin-nav.js only intercepts that inside the sidebar
        nav, so on a link in the page body it would be a dead attribute implying
        behaviour it does not have. An ordinary navigation is correct here. %>
    <a href="/jpsme_admin/activations" class="btn-primary mt-3 inline-flex">Go to Activations</a>
  </div>
</div>
