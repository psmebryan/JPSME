<%
function regStatusBadge(status) {
  const styles = { REGISTERED: 'badge-green', PENDING_PAYMENT: 'badge-amber', CANCELLED: 'badge-slate' };
  const labels = { PENDING_PAYMENT: 'Awaiting Payment' };
  return `<span class="${styles[status] || 'badge-slate'}">${labels[status] || status}</span>`;
}
%>
<div class="max-w-4xl mx-auto">
  <a href="/admin/events" class="text-sm text-indigo-600 hover:underline">&larr; Back to events</a>
  <div class="mt-3 mb-4 flex flex-wrap items-center justify-between gap-3">
    <h1 class="admin-h1">Registrations for "<%= event.title %>"</h1>
    <div class="flex gap-4 text-sm">
      <a href="/admin/events/<%= event.id %>/certificate" class="text-emerald-600 hover:underline">Manage Certificates &rarr;</a>
      <a href="/admin/events/<%= event.id %>/email" class="text-sky-600 hover:underline">Manage Email &rarr;</a>
    </div>
  </div>

  <% if (!registrations || registrations.length === 0) { %>
    <div class="admin-card p-4">
      <p class="empty-state">No registrations yet.</p>
    </div>
  <% } else { %>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead class="admin-table-head">
          <tr>
            <th class="admin-th">Name</th>
            <th class="admin-th">Email</th>
            <th class="admin-th">Phone</th>
            <th class="admin-th">School</th>
            <th class="admin-th">Status</th>
            <th class="admin-th">Registered At</th>
          </tr>
        </thead>
        <tbody class="admin-tbody">
          <% registrations.forEach(r => { %>
            <tr class="admin-tr">
              <td class="admin-td"><%= r.fullName %></td>
              <td class="admin-td max-w-[220px] truncate"><%= r.email %></td>
              <td class="admin-td"><%= r.phone || '-' %></td>
              <td class="admin-td max-w-[160px] truncate"><%= r.school || '-' %></td>
              <td class="admin-td"><%- regStatusBadge(r.status) %></td>
              <td class="admin-td"><%= new Date(r.createdAt).toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
