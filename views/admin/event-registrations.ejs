<%
function regStatusBadge(status) {
  const styles = { REGISTERED: 'badge-green', PENDING_PAYMENT: 'badge-amber', CANCELLED: 'badge-slate' };
  const labels = { PENDING_PAYMENT: 'Awaiting Payment' };
  return `<span class="${styles[status] || 'badge-slate'}">${labels[status] || status}</span>`;
}
%>
<div class="max-w-4xl mx-auto">
  <a href="/admin/events" class="text-sm text-indigo-600 hover:underline">&larr; Back to events</a>
  <div class="mt-3 mb-4 flex flex-wrap items-center justify-between gap-3">
    <h1 class="admin-h1">Registrations for "<%= event.title %>"</h1>
    <div class="flex gap-4 text-sm">
      <% if (isMainAdmin) { %>
        <a href="/admin/invitations?eventId=<%= event.id %>" class="text-purple-600 hover:underline">Manage Invitations &rarr;</a>
      <% } %>
      <a href="/admin/events/<%= event.id %>/check-in" class="text-amber-600 hover:underline font-medium">Check-in &rarr;</a>
      <a href="/admin/events/<%= event.id %>/certificate" class="text-emerald-600 hover:underline">Manage Certificates &rarr;</a>
      <a href="/admin/events/<%= event.id %>/email" class="text-sky-600 hover:underline">Manage Email &rarr;</a>
    </div>
  </div>

  <form method="GET" action="/admin/events/<%= event.id %>/registrations" class="mb-4 admin-card p-4">
    <div class="grid gap-3 sm:grid-cols-[1.5fr_180px_auto]">
      <input
        type="search"
        name="search"
        value="<%= search || '' %>"
        placeholder="Search name or email"
        class="form-input" />
      <select name="status" class="form-input">
        <option value="">All status</option>
        <option value="REGISTERED" <%= status === 'REGISTERED' ? 'selected' : '' %>>Registered</option>
        <option value="PENDING_PAYMENT" <%= status === 'PENDING_PAYMENT' ? 'selected' : '' %>>Awaiting Payment</option>
        <option value="CANCELLED" <%= status === 'CANCELLED' ? 'selected' : '' %>>Cancelled</option>
      </select>
      <button type="submit" class="btn-primary">Apply</button>
    </div>
  </form>

  <% if (!registrations || registrations.length === 0) { %>
    <div class="admin-card p-4">
      <p class="empty-state">No registrations found.</p>
    </div>
  <% } else { %>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead class="admin-table-head">
          <tr>
            <th class="admin-th">Name</th>
            <th class="admin-th">Email</th>
            <th class="admin-th">Phone</th>
            <th class="admin-th">Organization</th>
            <th class="admin-th">Status</th>
            <th class="admin-th">Source</th>
            <th class="admin-th">Registered At</th>
            <th class="admin-th">Ticket</th>
            <% if (isMainAdmin) { %><th class="admin-th"></th><% } %>
          </tr>
        </thead>
        <tbody class="admin-tbody">
          <% registrations.forEach(r => { %>
            <tr class="admin-tr">
              <td class="admin-td"><%= r.fullName %></td>
              <td class="admin-td max-w-[220px] truncate"><%= r.email %></td>
              <td class="admin-td"><%= r.phone || '-' %></td>
              <%# The organization snapshotted at registration time, not the
                  member's today — a member who transfers must still appear here
                  under the one they attended under. %>
              <td class="admin-td max-w-[220px] truncate" title="<%= r.organizationPath || '' %>"><%= r.organizationPath || '-' %></td>
              <td class="admin-td"><%- regStatusBadge(r.status) %></td>
              <td class="admin-td"><%- r.invitationId ? '<span class="badge-purple">Invited</span>' : '-' %></td>
              <td class="admin-td"><%= new Date(r.createdAt).toLocaleString() %></td>
              <td class="admin-td">
                <% if (r.qrToken) { %>
                  <span class="block font-mono text-xs text-slate-700"><%= r.registrationNumber || '—' %></span>
                  <% if (r.checkedInAt) { %>
                    <span class="badge-green mt-0.5">Checked in <%= new Date(r.checkedInAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
                  <% } else { %>
                    <span class="badge-slate mt-0.5">Not yet scanned</span>
                  <% } %>
                <% } else if (r.status === 'PENDING_PAYMENT') { %>
                  <%# No ticket exists until payment confirms - that is the rule, not a gap. %>
                  <span class="text-xs text-slate-400">Issued once paid</span>
                <% } else { %>
                  <span class="text-xs text-slate-400">&mdash;</span>
                <% } %>
              </td>
              <% if (isMainAdmin) { %>
                <td class="admin-td text-right">
                  <% if (r.qrToken) { %>
                    <button type="button"
                            data-regenerate-qr="<%= r.id %>"
                            data-name="<%= r.fullName %>"
                            class="text-sm text-indigo-600 hover:underline">Regenerate QR</button>
                  <% } %>
                </td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <%- include('../partials/pagination', {
      currentPage: page,
      totalPages: totalPages,
      baseQuery: { search, status },
      pageParam: 'page'
    }) %>
  <% } %>
</div>

<script nonce="<%= cspNonce %>">
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-regenerate-qr]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const name = btn.dataset.name || 'this registrant';
        // Confirmed because it cannot be undone and it breaks something the
        // member may already be holding: their current code stops working the
        // instant this runs.
        const ok = window.confirm(
          'Issue a new QR for ' + name + '?\n\n'
          + 'Their current code will stop working immediately. '
          + 'A replacement e-ticket will be emailed to them.'
        );
        if (!ok) return;

        btn.disabled = true;
        const original = btn.textContent;
        btn.textContent = 'Working...';
        try {
          const eventId = window.location.pathname.split('/')[3];
          const res = await apiFetch(
            '/api/events/' + eventId + '/registrations/' + btn.dataset.regenerateQr + '/qr/regenerate',
            { method: 'POST' }
          );
          showToast(res.message);
          window.location.reload();
        } catch (err) {
          showToast(err.message, 'error');
          btn.disabled = false;
          btn.textContent = original;
        }
      });
    });
  });
</script>
