<%
const regions = locals.regions || [];
const areas = locals.areas || [];
const chapters = locals.chapters || [];
%>

<h1 class="admin-h1 mb-6">Chapter Management</h1>

<div class="space-y-10">
  <section>
    <h2 class="text-lg font-semibold text-slate-800 mb-4">Regions (Luzon / Visayas / Mindanao)</h2>
    <form action="/admin/chapters/regions" method="POST" class="flex gap-3 mb-4">
      <input type="text" name="name" required placeholder="e.g. Luzon" class="form-input flex-1" />
      <button type="submit" class="btn-primary">Add Region</button>
    </form>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead class="admin-table-head">
          <tr>
            <th class="admin-th">Name</th>
            <th class="admin-th">Areas</th>
            <th class="admin-th text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="admin-tbody">
          <% regions.forEach(region => { %>
            <tr class="admin-tr">
              <td class="admin-td font-semibold text-slate-800"><%= region.name %></td>
              <td class="admin-td text-slate-500"><%= region.areas ? region.areas.length : 0 %></td>
              <td class="admin-td text-right">
                <form action="/admin/chapters/regions/<%= region.id %>/delete" method="POST" data-confirm="Delete this region? Its areas and chapters go too.">
                  <button type="submit" class="text-red-600 hover:underline text-sm font-medium">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (regions.length === 0) { %>
        <p class="empty-state">No regions yet.</p>
      <% } %>
    </div>
  </section>

  <section>
    <h2 class="text-lg font-semibold text-slate-800 mb-4">Areas</h2>
    <form action="/admin/chapters/areas" method="POST" class="flex gap-3 mb-4">
      <input type="text" name="name" required placeholder="e.g. National Capital Region" class="form-input flex-1" />
      <select name="regionId" required class="form-input w-auto">
        <option value="" disabled selected>Region</option>
        <% regions.forEach(region => { %>
          <option value="<%= region.id %>"><%= region.name %></option>
        <% }) %>
      </select>
      <button type="submit" class="btn-primary">Add Area</button>
    </form>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead class="admin-table-head">
          <tr>
            <th class="admin-th">Name</th>
            <th class="admin-th">Region</th>
            <th class="admin-th">Chapters</th>
            <th class="admin-th text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="admin-tbody">
          <% areas.forEach(area => { %>
            <tr class="admin-tr">
              <td class="admin-td font-semibold text-slate-800"><%= area.name %></td>
              <td class="admin-td text-slate-500"><%= area.region ? area.region.name : '' %></td>
              <td class="admin-td text-slate-500"><%= area.chapters ? area.chapters.length : 0 %></td>
              <td class="admin-td text-right">
                <form action="/admin/chapters/areas/<%= area.id %>/delete" method="POST" data-confirm="Delete this area? Its chapters go too.">
                  <button type="submit" class="text-red-600 hover:underline text-sm font-medium">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (areas.length === 0) { %>
        <p class="empty-state">No areas yet.</p>
      <% } %>
    </div>
  </section>

  <section>
    <h2 class="text-lg font-semibold text-slate-800 mb-4">Chapters</h2>
    <form action="/admin/chapters" method="POST" class="grid grid-cols-1 sm:grid-cols-4 gap-3 mb-4 items-center">
      <input type="text" name="name" required placeholder="Chapter name" class="form-input sm:col-span-2" />
      <input type="number" name="yearFounded" required placeholder="Year founded" min="1900" max="2100" class="form-input" />
      <select name="areaId" required class="form-input">
        <option value="" disabled selected>Area</option>
        <% areas.forEach(area => { %>
          <option value="<%= area.id %>"><%= area.name %> (<%= area.region ? area.region.name : '' %>)</option>
        <% }) %>
      </select>
      <label class="flex items-center gap-2 text-sm text-slate-600">
        <input type="checkbox" name="isActive" checked /> Active (shown on public page)
      </label>
      <button type="submit" class="btn-primary">Add Chapter</button>
    </form>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead class="admin-table-head">
          <tr>
            <th class="admin-th">Name</th>
            <th class="admin-th">Area</th>
            <th class="admin-th">Year</th>
            <th class="admin-th">Status</th>
            <th class="admin-th text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="admin-tbody">
          <% chapters.forEach(chapter => { %>
            <tr class="admin-tr">
              <td class="admin-td font-semibold text-slate-800"><%= chapter.name %></td>
              <td class="admin-td text-slate-500"><%= chapter.area ? chapter.area.name : '' %></td>
              <td class="admin-td text-slate-500"><%= chapter.yearFounded %></td>
              <td class="admin-td">
                <% if (chapter.isActive) { %>
                  <span class="badge-green">Active</span>
                <% } else { %>
                  <span class="badge-slate">Hidden</span>
                <% } %>
              </td>
              <td class="admin-td text-right">
                <div class="flex flex-wrap justify-end items-center gap-3">
                  <a href="/admin/chapters/<%= chapter.id %>/edit" class="text-indigo-600 hover:underline text-sm font-medium">Edit</a>
                  <form action="/admin/chapters/<%= chapter.id %>/delete" method="POST" class="inline" data-confirm="Delete this chapter?">
                    <button type="submit" class="text-red-600 hover:underline text-sm font-medium">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <% if (chapters.length === 0) { %>
        <p class="empty-state">No chapters yet.</p>
      <% } %>
    </div>
  </section>
</div>
