<%#
  The article editor, shared by Create and Edit. Locals: article (null when
  creating), categoryNames, maxGallery.

  Body: plain text with a few marks (toolbar buttons insert them), turned into
  HTML on the server by utils/articleFormat; Preview asks the server for that
  same HTML. Cover and new gallery photos go up with the form in one request;
  gallery photos already saved can be removed or moved, sent as
  removeImageIds / imageOrder.
%>
<%
  const a = locals.article || null;
  const editing = Boolean(a);
  const images = a && a.images ? a.images : [];
  const dateValue = a && a.publishedAt
    ? new Date(new Date(a.publishedAt).getTime() + 8 * 3600e3).toISOString().slice(0, 10) : '';
  const suggestions = Array.from(new Set(['Circular', 'Newsletter', 'Press Release', 'Announcement', 'Chapter News', ...(categoryNames || [])]));
%>
<div class="w-full">
  <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
    <div>
      <a href="/admin/articles" class="text-sm text-indigo-600 hover:underline">&larr; Back to articles</a>
      <h1 class="admin-h1 mt-2"><%= editing ? 'Edit Article' : 'Create Article' %></h1>
    </div>
    <% if (editing && a.isPublished) { %>
      <a href="/articles/<%= a.id %>" target="_blank" rel="noopener" class="btn-secondary inline-flex items-center gap-2 px-4 py-2">
        View on site
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.5 6H18m0 0v4.5M18 6l-7.5 7.5M9 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-3"/></svg>
      </a>
    <% } %>
  </div>

  <form id="article-form" class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_22rem]" enctype="multipart/form-data"
        data-article-id="<%= editing ? a.id : '' %>" data-max-gallery="<%= maxGallery %>" novalidate>
    <%# ---------- main column ---------- %>
    <div class="space-y-5">
      <div class="admin-card space-y-4 p-6">
        <div>
          <label for="title" class="form-label">Title</label>
          <input id="title" name="title" required maxlength="200" value="<%= a ? a.title : '' %>" placeholder="e.g. PSME NATION | The Real One Adds Value to Everyone" class="form-input text-lg font-semibold" />
        </div>
        <div>
          <label for="summary" class="form-label">Summary <span class="font-normal text-slate-400">(optional)</span></label>
          <textarea id="summary" name="summary" rows="2" maxlength="300" placeholder="One or two sentences shown on the News cards. Leave empty to use the start of the article." class="form-input"><%= a ? a.summary || '' : '' %></textarea>
          <p class="mt-1 text-right text-xs text-slate-400"><span data-count-for="summary">0</span>/300</p>
        </div>
      </div>

      <div class="admin-card overflow-hidden">
        <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 px-4 pt-3">
          <div class="flex gap-1" role="tablist">
            <button type="button" role="tab" aria-selected="true" class="border-b-2 border-indigo-600 px-3 pb-2 text-sm font-semibold text-indigo-700" data-tab="write">Write</button>
            <button type="button" role="tab" aria-selected="false" class="border-b-2 border-transparent px-3 pb-2 text-sm font-semibold text-slate-500 hover:text-slate-800" data-tab="preview">Preview</button>
          </div>
          <div class="flex flex-wrap items-center gap-0.5 pb-2" data-toolbar aria-label="Formatting">
            <button type="button" class="rounded px-2 py-1 text-sm font-bold text-slate-600 hover:bg-slate-100" data-mark="h1" title="Heading">H1</button>
            <button type="button" class="rounded px-2 py-1 text-sm font-bold text-slate-600 hover:bg-slate-100" data-mark="h2" title="Subheading">H2</button>
            <button type="button" class="rounded px-2 py-1 text-sm font-bold text-slate-600 hover:bg-slate-100" data-mark="bold" title="Bold">B</button>
            <button type="button" class="rounded px-2 py-1 text-sm italic text-slate-600 hover:bg-slate-100" data-mark="italic" title="Italic">I</button>
            <span class="mx-1 h-5 w-px bg-slate-200" aria-hidden="true"></span>
            <button type="button" class="rounded px-2 py-1 text-sm text-slate-600 hover:bg-slate-100" data-mark="ul" title="Bullet list">&bull; List</button>
            <button type="button" class="rounded px-2 py-1 text-sm text-slate-600 hover:bg-slate-100" data-mark="ol" title="Numbered list">1. List</button>
            <button type="button" class="rounded px-2 py-1 text-sm text-slate-600 hover:bg-slate-100" data-mark="quote" title="Highlighted note">&ldquo; Note</button>
            <button type="button" class="rounded px-2 py-1 text-sm text-slate-600 hover:bg-slate-100" data-mark="link" title="Link">Link</button>
            <button type="button" class="rounded px-2 py-1 text-sm text-slate-600 hover:bg-slate-100" data-mark="hr" title="Divider">&mdash;</button>
          </div>
        </div>
        <div data-pane="write">
          <label for="body" class="sr-only">Content</label>
          <textarea id="body" name="body" rows="20" required class="block w-full resize-y border-0 px-5 py-4 font-mono text-sm leading-6 text-slate-800 focus:ring-0" placeholder="Write the article here.&#10;&#10;# A heading&#10;A paragraph with **bold** text and a link: https://example.com&#10;- a bullet point"><%= a ? a.body : '' %></textarea>
        </div>
        <div data-pane="preview" hidden>
          <div class="article-prose min-h-[20rem] px-6 py-5" data-preview></div>
        </div>
        <details class="border-t border-slate-200 bg-slate-50 px-5 py-3 text-xs text-slate-600">
          <summary class="cursor-pointer font-semibold text-slate-700">Formatting guide</summary>
          <div class="mt-2 grid gap-x-8 gap-y-1 sm:grid-cols-2">
            <p><code># Heading</code> &middot; <code>## Subheading</code></p>
            <p><code>**bold**</code> &middot; <code>*italic*</code></p>
            <p><code>- item</code> bullet list &middot; <code>1. item</code> numbered</p>
            <p><code>&gt; text</code> highlighted note &middot; <code>---</code> divider</p>
            <p><code>[text](https://link)</code>, or paste a link as is</p>
            <p>A blank line starts a new paragraph.</p>
          </div>
        </details>
      </div>

      <div class="admin-card space-y-3 p-6">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-sm font-semibold text-slate-900">Photo gallery</h2>
            <p class="text-xs text-slate-500">Shown under the article; visitors can open each one full size. Up to <%= maxGallery %> photos, 3 MB each.</p>
          </div>
          <label class="btn-secondary cursor-pointer px-3 py-2 text-sm">
            Add photos
            <input type="file" accept="image/png,image/jpeg,image/webp" multiple class="sr-only" data-gallery-input>
          </label>
        </div>
        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4" data-gallery-list>
          <% images.forEach((img) => { %>
            <li class="group relative overflow-hidden rounded-lg border border-slate-200 bg-slate-50" data-image-id="<%= img.id %>">
              <img src="<%= img.url %>" alt="" class="aspect-[4/3] w-full object-cover">
              <div class="absolute inset-x-0 bottom-0 flex justify-between bg-gradient-to-t from-black/60 to-transparent p-1.5 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 sm:focus-within:opacity-100">
                <span class="flex gap-1">
                  <button type="button" class="rounded bg-white/90 px-1.5 text-xs text-slate-800" data-move="-1" aria-label="Move earlier">&larr;</button>
                  <button type="button" class="rounded bg-white/90 px-1.5 text-xs text-slate-800" data-move="1" aria-label="Move later">&rarr;</button>
                </span>
                <button type="button" class="rounded bg-red-600 px-1.5 text-xs text-white" data-remove-image aria-label="Remove photo">Remove</button>
              </div>
            </li>
          <% }) %>
        </ul>
        <p class="text-sm text-slate-400" data-gallery-empty <%= images.length ? 'hidden' : '' %>>No photos yet.</p>
      </div>
    </div>

    <%# ---------- side column ---------- %>
    <div class="space-y-5">
      <div class="admin-card space-y-4 p-5 lg:sticky lg:top-6">
        <h2 class="text-sm font-semibold text-slate-900">Publish</h2>
        <label class="flex cursor-pointer items-center justify-between gap-3">
          <span class="text-sm text-slate-700">Published on the site</span>
          <span class="relative inline-flex items-center">
            <input id="isPublished" name="isPublished" type="checkbox" class="peer sr-only" <%= a && a.isPublished ? 'checked' : '' %>>
            <span class="h-6 w-11 rounded-full bg-slate-300 transition-colors peer-checked:bg-emerald-600"></span>
            <span class="pointer-events-none absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5"></span>
          </span>
        </label>
        <div>
          <label for="publishedAt" class="form-label">Publish date</label>
          <input id="publishedAt" name="publishedAt" type="date" value="<%= dateValue %>" class="form-input">
          <p class="mt-1 text-xs text-slate-500">Leave empty to use the day it is published. Set an earlier date to post an older circular under its own date; it also decides its By Year folder.</p>
        </div>
        <div class="flex gap-2 pt-1">
          <button type="submit" class="btn-primary flex-1 py-2.5" data-save><%= editing ? 'Save changes' : 'Save article' %></button>
          <a href="/admin/articles" class="btn-secondary px-4 py-2.5">Cancel</a>
        </div>
      </div>

      <div class="admin-card space-y-4 p-5">
        <div>
          <label for="category" class="form-label">Category</label>
          <input id="category" name="category" maxlength="60" list="category-names" value="<%= a ? a.category || '' : '' %>" placeholder="e.g. Circular, Newsletter" class="form-input">
          <datalist id="category-names"><% suggestions.forEach((c) => { %><option value="<%= c %>"><% }) %></datalist>
          <p class="mt-1 text-xs text-slate-500">Each category gets its own section on the News page.</p>
        </div>
        <div>
          <label for="authorName" class="form-label">Author</label>
          <input id="authorName" name="authorName" maxlength="120" value="<%= a ? a.authorName || '' : '' %>" placeholder="e.g. JPSME National Board" class="form-input">
        </div>
      </div>

      <div class="admin-card space-y-3 p-5">
        <h2 class="text-sm font-semibold text-slate-900">Cover image</h2>
        <div class="relative overflow-hidden rounded-lg border border-dashed border-slate-300 bg-slate-50">
          <img src="<%= a && a.coverImage ? a.coverImage : '' %>" alt="Cover preview" class="aspect-[16/10] w-full object-contain <%= a && a.coverImage ? '' : 'hidden' %>" data-cover-preview>
          <p class="flex aspect-[16/10] items-center justify-center text-sm text-slate-400 <%= a && a.coverImage ? 'hidden' : '' %>" data-cover-empty>No cover image</p>
        </div>
        <div class="flex gap-2">
          <label class="btn-secondary flex-1 cursor-pointer py-2 text-center text-sm">
            <%= a && a.coverImage ? 'Replace' : 'Choose image' %>
            <input id="image" name="image" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" class="sr-only" data-cover-input>
          </label>
          <button type="button" class="btn-secondary px-3 py-2 text-sm text-red-600 <%= a && a.coverImage ? '' : 'hidden' %>" data-cover-remove>Remove</button>
        </div>
        <p class="text-xs text-slate-500">Shown whole on the article page and cropped on cards. 3 MB at most.</p>
      </div>

      <div class="admin-card space-y-3 p-5">
        <h2 class="text-sm font-semibold text-slate-900">Button link <span class="font-normal text-slate-400">(optional)</span></h2>
        <div>
          <label for="linkUrl" class="form-label">Link</label>
          <input id="linkUrl" name="linkUrl" type="url" maxlength="500" value="<%= a ? a.linkUrl || '' : '' %>" placeholder="https://heyzine.com/flip-book/…" class="form-input">
        </div>
        <div>
          <label for="linkLabel" class="form-label">Button text</label>
          <input id="linkLabel" name="linkLabel" maxlength="100" value="<%= a ? a.linkLabel || '' : '' %>" placeholder="Read the full newsletter" class="form-input">
        </div>
        <p class="text-xs text-slate-500">Shown as a button under the article, e.g. the full newsletter or a registration form.</p>
      </div>
    </div>
  </form>
</div>

<script nonce="<%= cspNonce %>">
document.addEventListener('DOMContentLoaded', () => {
  const form = document.getElementById('article-form');
  if (!form) return;
  const articleId = form.dataset.articleId;
  const maxGallery = Number(form.dataset.maxGallery) || 12;
  const MAX_BYTES = 3 * 1024 * 1024;
  const body = form.querySelector('#body');
  let dirty = false;
  form.addEventListener('input', () => { dirty = true; });
  window.addEventListener('beforeunload', (e) => { if (dirty) { e.preventDefault(); e.returnValue = ''; } });

  // --- summary counter ---
  const summary = form.querySelector('#summary');
  const counter = form.querySelector('[data-count-for="summary"]');
  const count = () => { counter.textContent = summary.value.length; };
  summary.addEventListener('input', count);
  count();

  // --- toolbar: wrap the selection, or prefix the selected lines ---
  function wrap(before, after, placeholder) {
    const { selectionStart: s, selectionEnd: e, value } = body;
    const text = value.slice(s, e) || placeholder;
    body.setRangeText(before + text + after, s, e, 'end');
    body.setSelectionRange(s + before.length, s + before.length + text.length);
  }
  function prefixLines(prefix, numbered) {
    const { value } = body;
    const s = value.lastIndexOf('\n', body.selectionStart - 1) + 1;
    let e = value.indexOf('\n', body.selectionEnd);
    if (e < 0) e = value.length;
    const lines = value.slice(s, e).split('\n');
    const out = lines.map((l, i) => (numbered ? `${i + 1}. ` : prefix) + l.replace(/^(#{1,3}|[-*•]|\d+[.)]|>)\s+/, '')).join('\n');
    body.setRangeText(out, s, e, 'end');
  }
  form.querySelector('[data-toolbar]').addEventListener('click', (ev) => {
    const btn = ev.target.closest('[data-mark]');
    if (!btn) return;
    if (showingPreview) setTab('write');
    body.focus();
    const mark = btn.getAttribute('data-mark');
    if (mark === 'bold') wrap('**', '**', 'bold text');
    else if (mark === 'italic') wrap('*', '*', 'italic text');
    else if (mark === 'h1') prefixLines('# ');
    else if (mark === 'h2') prefixLines('## ');
    else if (mark === 'ul') prefixLines('- ');
    else if (mark === 'ol') prefixLines('', true);
    else if (mark === 'quote') prefixLines('> ');
    else if (mark === 'hr') body.setRangeText('\n\n---\n\n', body.selectionStart, body.selectionEnd, 'end');
    else if (mark === 'link') {
      const url = prompt('Link address (https://…)', 'https://');
      if (!url || !/^https?:\/\/\S+$/i.test(url.trim())) return;
      wrap('[', `](${url.trim()})`, 'link text');
    }
    dirty = true;
  });

  // --- Write / Preview ---
  let showingPreview = false;
  const preview = form.querySelector('[data-preview]');
  async function setTab(tab) {
    showingPreview = tab === 'preview';
    form.querySelectorAll('[data-tab]').forEach((b) => {
      const on = b.getAttribute('data-tab') === tab;
      b.setAttribute('aria-selected', String(on));
      b.classList.toggle('border-indigo-600', on); b.classList.toggle('text-indigo-700', on);
      b.classList.toggle('border-transparent', !on); b.classList.toggle('text-slate-500', !on);
    });
    form.querySelector('[data-pane="write"]').hidden = showingPreview;
    form.querySelector('[data-pane="preview"]').hidden = !showingPreview;
    if (!showingPreview) return;
    preview.innerHTML = '<p class="text-slate-400">Loading preview…</p>';
    try {
      const res = await apiFetch('/api/articles/preview', { method: 'POST', body: JSON.stringify({ body: body.value }) });
      // Escaped and built by the server's formatter (utils/articleFormat).
      preview.innerHTML = res.data.html || '<p class="text-slate-400">Nothing written yet.</p>';
    } catch (err) {
      preview.innerHTML = '';
      showToast(err.message, 'error');
    }
  }
  form.querySelectorAll('[data-tab]').forEach((b) => b.addEventListener('click', () => setTab(b.getAttribute('data-tab'))));

  // --- cover ---
  const coverInput = form.querySelector('[data-cover-input]');
  const coverImg = form.querySelector('[data-cover-preview]');
  const coverEmpty = form.querySelector('[data-cover-empty]');
  const coverRemove = form.querySelector('[data-cover-remove]');
  let removeCover = false;
  coverInput.addEventListener('change', () => {
    const file = coverInput.files[0];
    if (!file) return;
    if (file.size > MAX_BYTES) { showToast('The cover image is over 3 MB. Save it smaller and try again.', 'error'); coverInput.value = ''; return; }
    coverImg.src = URL.createObjectURL(file);
    coverImg.classList.remove('hidden'); coverEmpty.classList.add('hidden'); coverRemove.classList.remove('hidden');
    removeCover = false;
  });
  coverRemove.addEventListener('click', () => {
    coverInput.value = '';
    coverImg.removeAttribute('src');
    coverImg.classList.add('hidden'); coverEmpty.classList.remove('hidden'); coverRemove.classList.add('hidden');
    removeCover = true; dirty = true;
  });

  // --- gallery ---
  const list = form.querySelector('[data-gallery-list]');
  const empty = form.querySelector('[data-gallery-empty]');
  const removed = [];
  const newFiles = new Map(); // tile -> File
  const tiles = () => Array.from(list.children);
  const refresh = () => { empty.hidden = tiles().length > 0; };
  function tileFor(src, file) {
    const li = document.createElement('li');
    li.className = 'group relative overflow-hidden rounded-lg border border-indigo-200 bg-slate-50';
    li.innerHTML = '<img alt="" class="aspect-[4/3] w-full object-cover"><span class="absolute left-1.5 top-1.5 rounded bg-indigo-600 px-1.5 text-[10px] font-semibold uppercase text-white">New</span>'
      + '<div class="absolute inset-x-0 bottom-0 flex justify-end bg-gradient-to-t from-black/60 to-transparent p-1.5"><button type="button" class="rounded bg-red-600 px-1.5 text-xs text-white" data-remove-image aria-label="Remove photo">Remove</button></div>';
    li.querySelector('img').src = src;
    newFiles.set(li, file);
    return li;
  }
  form.querySelector('[data-gallery-input]').addEventListener('change', (ev) => {
    const files = Array.from(ev.target.files || []);
    ev.target.value = '';
    for (const file of files) {
      if (tiles().length >= maxGallery) { showToast(`Up to ${maxGallery} photos.`, 'error'); break; }
      if (file.size > MAX_BYTES) { showToast(`"${file.name}" is over 3 MB and was skipped.`, 'error'); continue; }
      list.appendChild(tileFor(URL.createObjectURL(file), file));
      dirty = true;
    }
    refresh();
  });
  list.addEventListener('click', (ev) => {
    const li = ev.target.closest('li');
    if (!li) return;
    if (ev.target.closest('[data-remove-image]')) {
      if (li.dataset.imageId) removed.push(li.dataset.imageId);
      newFiles.delete(li);
      li.remove(); refresh(); dirty = true;
      return;
    }
    const move = ev.target.closest('[data-move]');
    if (move) {
      const dir = Number(move.getAttribute('data-move'));
      const sib = dir < 0 ? li.previousElementSibling : li.nextElementSibling;
      if (sib && sib.dataset.imageId) { if (dir < 0) list.insertBefore(li, sib); else list.insertBefore(sib, li); dirty = true; }
    }
  });

  // --- save ---
  form.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const titleInput = form.elements.namedItem('title');
    if (!titleInput.value.trim()) { showToast('Enter a title.', 'error'); titleInput.focus(); return; }
    if (!body.value.trim()) { showToast('Write the article content.', 'error'); setTab('write'); body.focus(); return; }
    const data = new FormData(form);
    data.set('isPublished', form.elements.namedItem('isPublished').checked ? 'true' : 'false');
    data.delete('gallery');
    tiles().forEach((li) => { if (newFiles.has(li)) data.append('gallery', newFiles.get(li)); });
    if (articleId) {
      data.set('removeImageIds', removed.join(','));
      data.set('imageOrder', tiles().filter((li) => li.dataset.imageId).map((li) => li.dataset.imageId).join(','));
      if (removeCover && !coverInput.files.length) data.set('removeCover', 'true');
    }
    const button = form.querySelector('[data-save]');
    button.disabled = true;
    try {
      await apiFetch(articleId ? `/api/articles/${articleId}` : '/api/articles', { method: articleId ? 'PUT' : 'POST', body: data });
      dirty = false;
      showToast(articleId ? 'Article updated' : 'Article created');
      window.location.href = '/admin/articles';
    } catch (err) {
      button.disabled = false;
      showToast((err.errors && err.errors[0] && err.errors[0].msg) || err.message, 'error');
    }
  });
});
</script>
