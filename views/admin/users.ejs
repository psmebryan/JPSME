<h1 class="admin-h1 mb-6"><%= title %></h1>

<%
// JSON in an attribute must use EJS escaped output, never raw: with raw output
// any apostrophe in the data terminates the attribute early and dumps the rest
// of the JSON onto the page as visible text — which is exactly what an
// organization importNote containing "chart's own" did here. Escaping emits
// &#39; instead, and the browser decodes it back to valid JSON when admin.js
// reads .dataset.
%>
<div id="users-module" data-view-mode="<%= viewMode %>" data-organizations="<%= JSON.stringify(organizations || []) %>" data-current-user="<%= JSON.stringify(currentUser || {}) %>" class="admin-card overflow-hidden">
  <% if (viewMode === 'list') { %>
    <form id="members-filter-form" class="flex flex-wrap items-end gap-3 border-b border-slate-200 p-4">
      <div>
        <label class="form-label">Search</label>
        <input type="text" name="search" placeholder="Name or email" class="form-input">
      </div>
      <div>
        <label class="form-label">Organization</label>
        <select name="organizationId" class="form-input">
          <option value="">All organizations</option>
          <% (organizations || []).forEach(o => { %>
            <option value="<%= o.id %>"><%= o.name %></option>
          <% }) %>
        </select>
      </div>
      <div>
        <label class="form-label">Membership</label>
        <select name="membership" class="form-input">
          <option value="">All</option>
          <option value="MEMBER">Member</option>
          <option value="NON_MEMBER">Non-Member</option>
          <%# Worded in membership terms only. "never paid" here read as a
              payment status and collided with the Payment filter beside it,
              which is a different question: a lapsed member has paid. %>
          <option value="LAPSED">&nbsp;&nbsp;&mdash; expired</option>
          <option value="NEVER">&nbsp;&nbsp;&mdash; never a member</option>
        </select>
      </div>
      <div>
        <label class="form-label">Payment</label>
        <select name="paymentStatus" class="form-input">
          <option value="">All</option>
          <%# Labels match the Payment column's badges exactly — an admin
              should be able to read a value off a row and find it here. %>
          <option value="UNPAID">Unpaid</option>
          <option value="PAID">Paid</option>
          <option value="PENDING">Pending</option>
          <option value="PROCESSING">Processing</option>
          <option value="FAILED">Failed</option>
          <option value="EXPIRED">Expired</option>
          <option value="CANCELLED">Cancelled</option>
          <option value="REFUNDED">Refunded</option>
        </select>
      </div>
      <div>
        <label class="form-label">Status</label>
        <select name="status" class="form-input">
          <option value="">All</option>
          <option value="APPROVED">Approved</option>
          <option value="PENDING">Pending</option>
          <option value="REJECTED">Rejected</option>
        </select>
      </div>
      <button type="submit" class="btn-primary">Apply</button>
      <button type="button" id="members-clear-filters" class="btn-secondary hidden">Clear</button>
      <!-- Without this, a filter that legitimately matches nothing is
           indistinguishable from a filter that silently failed. -->
      <p id="members-result-summary" class="w-full text-xs text-slate-500 mt-1"></p>
    </form>
  <% } %>

  <div class="overflow-x-auto">
    <table id="users-table" class="admin-table">
      <colgroup>
        <col>
        <col>
        <col>
        <col>
        <col class="w-28">
        <col class="w-28">
        <col class="w-32">
        <col class="w-36">
        <col class="w-px">
      </colgroup>
      <thead class="admin-table-head">
        <tr>
          <th class="admin-th">Name</th>
          <th class="admin-th">Email</th>
          <th class="admin-th">School</th>
          <th class="admin-th">Organization</th>
          <th class="admin-th">Status</th>
          <th class="admin-th">Email Status</th>
          <th class="admin-th">Membership</th>
          <th class="admin-th">Payment</th>
          <th class="admin-th text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="admin-tbody"></tbody>
    </table>
    <p id="users-empty-state" class="hidden empty-state">No users found.</p>
  </div>

  <% if (viewMode === 'list') { %>
    <div id="members-pagination" class="flex items-center justify-center gap-1 p-4" data-page="1" data-total-pages="1"></div>
  <% } %>
</div>

