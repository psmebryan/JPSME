<%#
  Merchandise -> Orders. Paid orders oldest first (the packing order), with a
  count per status, filters in the URL, select-and-bulk "Packed" / "Ready for
  pickup", a printable pick list and packing slips, and Excel export. Unpaid
  orders are left out unless their status is chosen. See merchOrders.service.
%>
<%
  const f = filters;
  const peso = (c) => '₱' + (c / 100).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const when = (d) => new Date(d).toLocaleString('en-PH', { timeZone: 'Asia/Manila', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
  const qs = (over) => { const p = { status: f.status, fulfilment: f.fulfilment, from: f.from, to: f.to, q: f.q, ...over }; const s = Object.keys(p).filter((k) => p[k]).map((k) => `${k}=${encodeURIComponent(p[k])}`).join('&'); return s ? `?${s}` : ''; };
  const tone = { PAID: 'badge-amber', PACKED: 'badge-blue', SHIPPED: 'badge-blue', READY_FOR_PICKUP: 'badge-green', DELIVERED: 'badge-green', PICKED_UP: 'badge-green', ADDRESS_HOLD: 'badge-red', UNCLAIMED: 'badge-amber', CANCELLED: 'badge-slate', REFUNDED: 'badge-purple', AWAITING_PAYMENT: 'badge-slate' };
  const tiles = ['PAID', 'PACKED', 'ADDRESS_HOLD', 'SHIPPED', 'READY_FOR_PICKUP', 'UNCLAIMED'];
%>
<div class="w-full">
  <div class="admin-card overflow-hidden">
    <div class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-200 px-6 py-5">
      <div>
        <h1 class="admin-h1">Merchandise Orders</h1>
        <p class="admin-subtitle">Paid orders, oldest first: pack, ship or get ready for pickup</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <%# Packing, printing and handover need orders.fulfil (Logistics, the main admin). %>
        <% const canFulfil = locals.merchCaps ? merchCaps.has('orders.fulfil') : true; %>
        <% if (canFulfil) { %><a href="/admin/merch/pickup" class="btn-secondary px-4 py-2.5">Pickup handover</a>
        <a href="/admin/merch/orders/print" target="_blank" rel="noopener" class="btn-secondary px-4 py-2.5" data-print-all>Pick list (all paid)</a><% } %>
        <a href="/admin/merch/orders/export.xlsx<%= qs({}) %>" class="btn-primary px-4 py-2.5">Export XLS</a>
      </div>
    </div>

    <div class="space-y-5 px-6 py-5">
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-6">
        <% tiles.forEach((s) => { %>
          <a href="/admin/merch/orders?status=<%= s %>" class="rounded-lg border px-4 py-3 <%= f.status === s ? 'border-indigo-500 bg-indigo-50' : 'border-slate-200 hover:bg-slate-50' %>" data-count="<%= s %>">
            <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= s === 'PAID' ? 'To pack' : statusLabels[s] %></p>
            <p class="mt-1 text-2xl font-semibold tabular-nums <%= s === 'ADDRESS_HOLD' && counts[s] ? 'text-red-700' : 'text-slate-900' %>"><%= counts[s] || 0 %></p>
          </a>
        <% }) %>
      </div>

      <form method="get" action="/admin/merch/orders" id="order-filters" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_0.8fr_0.8fr_auto] lg:items-end">
        <div><label for="of-q" class="form-label">Search</label><input id="of-q" name="q" type="search" value="<%= f.q %>" maxlength="80" placeholder="Order no., buyer, email, tracking" class="form-input"></div>
        <div>
          <label for="of-status" class="form-label">Status</label>
          <select id="of-status" name="status" class="form-input" data-autosubmit>
            <option value="">All paid orders</option>
            <% Object.entries(statusLabels).forEach(([k, label]) => { %><option value="<%= k %>" <%= f.status === k ? 'selected' : '' %>><%= label %></option><% }) %>
          </select>
        </div>
        <div>
          <label for="of-ful" class="form-label">Delivery or pickup</label>
          <select id="of-ful" name="fulfilment" class="form-input" data-autosubmit>
            <option value="">Both</option><option value="DELIVERY" <%= f.fulfilment === 'DELIVERY' ? 'selected' : '' %>>Delivery</option><option value="PICKUP" <%= f.fulfilment === 'PICKUP' ? 'selected' : '' %>>Pickup</option>
          </select>
        </div>
        <div><label for="of-from" class="form-label">From</label><input id="of-from" name="from" type="date" value="<%= f.from || '' %>" class="form-input" data-autosubmit></div>
        <div><label for="of-to" class="form-label">To</label><input id="of-to" name="to" type="date" value="<%= f.to || '' %>" class="form-input" data-autosubmit></div>
        <span class="flex gap-2"><button type="submit" class="btn-primary px-4 py-2">Search</button><a href="/admin/merch/orders" class="btn-secondary px-3 py-2">Clear</a></span>
      </form>

      <div class="flex flex-wrap items-center gap-2 rounded-lg bg-slate-50 px-3 py-2 text-sm" data-bulk-bar <%= (locals.merchCaps ? merchCaps.has('orders.fulfil') : true) ? '' : 'hidden' %>>
        <span class="text-slate-600"><span data-selected-count>0</span> selected</span>
        <button type="button" class="btn-secondary px-3 py-1.5 text-sm" data-bulk="pack">Mark packed</button>
        <button type="button" class="btn-secondary px-3 py-1.5 text-sm" data-bulk="ready">Mark ready for pickup</button>
        <button type="button" class="btn-secondary px-3 py-1.5 text-sm" data-print-selected>Print pick list and slips</button>
      </div>

      <div class="overflow-x-auto">
        <table class="admin-table" id="orders-table">
          <thead class="admin-table-head">
            <tr>
              <th class="admin-th w-8"><input type="checkbox" data-select-all aria-label="Select all"></th>
              <th class="admin-th">Order</th>
              <th class="admin-th">Placed</th>
              <th class="admin-th">Buyer</th>
              <th class="admin-th">Items</th>
              <th class="admin-th">Delivery / pickup</th>
              <th class="admin-th text-right">Total</th>
              <th class="admin-th">Status</th>
            </tr>
          </thead>
          <tbody class="admin-tbody">
            <% orders.forEach((o) => { %>
              <tr class="admin-tr" data-order-row="<%= o.orderNumber %>">
                <td class="admin-td"><input type="checkbox" data-select value="<%= o.orderNumber %>" aria-label="Select <%= o.orderNumber %>"></td>
                <td class="admin-td whitespace-nowrap"><a href="/admin/merch/orders/<%= o.orderNumber %>" class="font-mono text-sm font-medium text-indigo-700 hover:underline"><%= o.orderNumber %></a></td>
                <td class="admin-td whitespace-nowrap tabular-nums text-slate-500"><%= when(o.createdAt) %></td>
                <td class="admin-td"><span class="font-medium text-slate-900"><%= o.buyerName %></span></td>
                <td class="admin-td max-w-[260px] truncate" title="<%= o.items.map((i) => `${i.quantity} × ${i.productName} (${i.label})`).join(', ') %>"><%= o.items.map((i) => `${i.quantity} × ${i.productName} (${i.label})`).join(', ') %></td>
                <td class="admin-td whitespace-nowrap"><%= o.fulfilment === 'PICKUP' ? `Pickup: ${o.pickupPoint ? o.pickupPoint.name : ''}` : o.fulfilment === 'DELIVERY' ? `Delivery: ${o.zoneName}` : '—' %></td>
                <td class="admin-td whitespace-nowrap text-right tabular-nums"><%= peso(o.total) %></td>
                <td class="admin-td"><span class="<%= tone[o.status] || 'badge-slate' %>"><%= o.statusLabel %></span></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <% if (!orders.length) { %><p class="py-8 text-center text-sm text-slate-500">No orders match.</p><% } %>
      </div>
      <% if (totalPages > 1) { %>
        <nav class="flex items-center justify-end gap-2 text-sm">
          <% if (page > 1) { %><a href="<%= qs({ page: page - 1 }) %>" class="btn-secondary px-3 py-1.5">Previous</a><% } %>
          <span>Page <%= page %> of <%= totalPages %></span>
          <% if (page < totalPages) { %><a href="<%= qs({ page: page + 1 }) %>" class="btn-secondary px-3 py-1.5">Next</a><% } %>
        </nav>
      <% } %>
    </div>
  </div>
</div>

<script nonce="<%= cspNonce %>">
(function () {
  const filters = document.getElementById('order-filters');
  filters.querySelectorAll('[data-autosubmit]').forEach((el) => el.addEventListener('change', () => filters.submit()));
  const boxes = () => Array.from(document.querySelectorAll('[data-select]'));
  const chosen = () => boxes().filter((b) => b.checked).map((b) => b.value);
  const count = document.querySelector('[data-selected-count]');
  const sync = () => { count.textContent = chosen().length; };
  document.querySelector('[data-select-all]').addEventListener('change', (e) => { boxes().forEach((b) => { b.checked = e.target.checked; }); sync(); });
  document.getElementById('orders-table').addEventListener('change', (e) => { if (e.target.matches('[data-select]')) sync(); });
  document.querySelectorAll('[data-bulk]').forEach((btn) => btn.addEventListener('click', async () => {
    const list = chosen();
    if (!list.length) { showToast('Select orders first.', 'error'); return; }
    btn.disabled = true;
    try {
      const res = await apiFetch('/api/admin/merch/orders/bulk', { method: 'POST', body: JSON.stringify({ action: btn.getAttribute('data-bulk'), orderNumbers: list }) });
      showToast(res.message + (res.data.failed.length ? ` ${res.data.failed.map((f) => `${f.orderNumber}: ${f.message}`).join(' · ')}` : ''), res.data.failed.length ? 'error' : undefined);
      setTimeout(() => window.location.reload(), 1200);
    } catch (err) { showToast(err.message, 'error'); btn.disabled = false; }
  }));
  document.querySelector('[data-print-selected]').addEventListener('click', () => {
    const list = chosen();
    if (!list.length) { showToast('Select orders first.', 'error'); return; }
    window.open(`/admin/merch/orders/print?orders=${encodeURIComponent(list.join(','))}`, '_blank', 'noopener');
  });
}());
</script>
