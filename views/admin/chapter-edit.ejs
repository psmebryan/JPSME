<%
const chapter = locals.chapter;
const areas = locals.areas || [];
%>
<div class="max-w-lg admin-card p-6">
  <h1 class="admin-h1 mb-4">Edit Chapter</h1>
  <form action="/admin/chapters/<%= chapter.id %>" method="POST" class="space-y-4">
    <div>
      <label class="form-label">Name</label>
      <input type="text" name="name" required value="<%= chapter.name %>" class="form-input" />
    </div>
    <div>
      <label class="form-label">Year founded</label>
      <input type="number" name="yearFounded" required value="<%= chapter.yearFounded %>" min="1900" max="2100" class="form-input" />
    </div>
    <div>
      <label class="form-label">Area</label>
      <select name="areaId" required class="form-input">
        <% areas.forEach(area => { %>
          <option value="<%= area.id %>" <%= area.id === chapter.areaId ? 'selected' : '' %>>
            <%= area.name %> (<%= area.region ? area.region.name : '' %>)
          </option>
        <% }) %>
      </select>
    </div>
    <label class="flex items-center gap-2 text-sm text-slate-600">
      <input type="checkbox" name="isActive" <%= chapter.isActive ? 'checked' : '' %> /> Active (shown on public page)
    </label>
    <div class="flex gap-3 pt-2">
      <button type="submit" class="btn-primary">Save changes</button>
      <a href="/admin/chapters" class="text-sm text-slate-500 px-5 py-2">Cancel</a>
    </div>
  </form>
</div>
