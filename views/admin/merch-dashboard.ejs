<%#
  Merchandise -> Store dashboard (phase 4). Sales today and this month, the
  work waiting for each team, stock running low and the reconciliation. Each
  part shows only to whoever may act on it (merchCaps); cost and profit
  figures are already taken out on the server for anyone without cost.view.
  See merchFinance.service dashboard.
%>
<%
  const peso = (c) => '₱' + ((Number(c) || 0) / 100).toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const when = (d) => new Date(d).toLocaleString('en-PH', { timeZone: 'Asia/Manila', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
  const day = (d) => new Date(`${d}T00:00:00+08:00`).toLocaleDateString('en-PH', { timeZone: 'Asia/Manila', month: 'short', day: 'numeric' });
  const mc = (c) => locals.merchCaps && merchCaps.has(c);
  const showCost = month.profitCentavos !== undefined;
  const tile = 'rounded-lg border border-slate-200 px-4 py-3';
  const label = 'text-xs font-medium uppercase tracking-wide text-slate-500';
  const big = 'mt-1 text-2xl font-semibold tabular-nums text-slate-900';
  const queue = (href, n, text, warn) => ({ href, n, text, warn });
  const queues = [];
  if (mc('orders.view')) {
    queues.push(queue('/admin/merch/orders?status=PAID', work.toPack, 'Paid, to pack'));
    queues.push(queue('/admin/merch/orders?status=PACKED', work.packed, 'Packed, to ship or set ready'));
    queues.push(queue('/admin/merch/orders?status=ADDRESS_HOLD', work.addressHold, 'Address on hold', true));
    queues.push(queue('/admin/merch/orders?status=READY_FOR_PICKUP', work.awaitingPickup, 'Waiting for pickup'));
    queues.push(queue('/admin/merch/orders?status=SHIPPED', work.inTransit, 'On the way'));
  }
  if (mc('returns.view')) {
    queues.push(queue('/admin/merch/returns?group=logistics', work.returnsForLogistics, 'Returns for Logistics'));
    queues.push(queue('/admin/merch/returns?group=approval', work.refundsToApprove, 'Refunds to approve', true));
    queues.push(queue('/admin/merch/returns?group=second', work.refundsSecond, 'Second approval needed', true));
  }
%>
<div class="w-full space-y-6">
  <div class="admin-card overflow-hidden">
    <div class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-200 px-6 py-5">
      <div>
        <h1 class="admin-h1">Store Dashboard</h1>
        <p class="admin-subtitle">Sales are counted on the day PayMongo took the payment (Philippine time)</p>
        <p class="mt-2 text-sm" data-store-mode="<%= launch.mode %>">Store: <a href="/admin/merch/launch" class="font-semibold <%= launch.mode === 'OPEN' ? 'text-emerald-700' : 'text-amber-700' %> hover:underline"><%= launch.label %></a><% if (launch.feedbackOpen && mc('orders.view')) { %> · <a href="/admin/merch/feedback?status=open" class="font-semibold text-red-700 hover:underline"><%= launch.feedbackOpen %> reported problem<%= launch.feedbackOpen === 1 ? '' : 's' %> open</a><% } %></p>
      </div>
      <% if (mc('reports.view')) { %><a href="/admin/merch/reports" class="btn-secondary px-4 py-2">Sales reports</a><% } %>
    </div>
    <div class="grid grid-cols-2 gap-3 px-6 py-5 lg:grid-cols-4" data-sales>
      <div class="<%= tile %>" data-tile="today"><p class="<%= label %>">Today</p><p class="<%= big %>"><%= peso(today.chargedCentavos) %></p><p class="text-xs text-slate-500"><%= today.orders %> order<%= today.orders === 1 ? '' : 's' %>, <%= today.units %> item<%= today.units === 1 ? '' : 's' %></p></div>
      <div class="<%= tile %>" data-tile="month"><p class="<%= label %>"><%= month.label %></p><p class="<%= big %>"><%= peso(month.chargedCentavos) %></p><p class="text-xs text-slate-500"><%= month.orders %> orders, <%= month.units %> items</p></div>
      <div class="<%= tile %>" data-tile="net"><p class="<%= label %>">Net this month</p><p class="<%= big %>"><%= peso(month.netCentavos) %></p><p class="text-xs text-slate-500">after <%= peso(month.paymongoFeeCentavos) %> PayMongo fees and <%= peso(month.refundsCentavos) %> refunds</p></div>
      <% if (showCost) { %>
        <div class="<%= tile %>" data-tile="profit"><p class="<%= label %>">Profit on items</p><p class="<%= big %> <%= month.profitCentavos < 0 ? 'text-red-700' : 'text-emerald-700' %>"><%= peso(month.profitCentavos) %></p><p class="text-xs <%= month.costMissingUnits ? 'text-amber-700' : 'text-slate-500' %>"><%= month.costMissingUnits ? `${month.costMissingUnits} item(s) sold with no cost yet` : 'this month, known costs, before refunds' %></p></div>
      <% } else { %>
        <div class="<%= tile %>" data-tile="delivery"><p class="<%= label %>">Delivery fees this month</p><p class="<%= big %>"><%= peso(month.deliveryCentavos) %></p></div>
      <% } %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
    <% if (queues.length) { %>
      <div class="admin-card p-6 xl:col-span-2" data-work>
        <h2 class="font-semibold">Waiting for someone</h2>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
          <% queues.forEach((q) => { %>
            <a href="<%= q.href %>" class="rounded-lg border px-4 py-3 hover:bg-slate-50 <%= q.warn && q.n ? 'border-amber-300 bg-amber-50' : 'border-slate-200' %>">
              <p class="text-2xl font-semibold tabular-nums <%= q.warn && q.n ? 'text-amber-800' : 'text-slate-900' %>"><%= q.n %></p>
              <p class="text-xs text-slate-600"><%= q.text %></p>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <% if (mc('reconcile.view')) { %>
      <div class="admin-card p-6" data-recon>
        <h2 class="font-semibold">Daily reconciliation</h2>
        <% if (reconciliation.uncheckedDays) { %>
          <p class="mt-3 rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-900">
            <strong><%= reconciliation.uncheckedDays %></strong> day<%= reconciliation.uncheckedDays === 1 ? '' : 's' %> with sales not checked yet<%= reconciliation.oldestUnchecked ? `, oldest ${day(reconciliation.oldestUnchecked)}` : '' %>.
          </p>
        <% } else { %>
          <p class="mt-3 text-sm text-emerald-700">Every day with sales in the last 60 days has been checked.</p>
        <% } %>
        <% if (reconciliation.gapDays) { %><p class="mt-2 text-sm text-red-700"><%= reconciliation.gapDays %> day(s) with gaps not explained.</p><% } %>
        <p class="mt-2 text-xs text-slate-500">Last checked: <%= reconciliation.lastChecked ? `${day(reconciliation.lastChecked.day)} (${reconciliation.lastChecked.statusLabel})` : 'never' %></p>
        <a href="/admin/merch/reconciliation" class="btn-secondary mt-4 inline-flex px-3 py-1.5 text-sm">Open reconciliation</a>
      </div>
    <% } %>
  </div>

  <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
    <div class="admin-card p-6" data-stock>
      <div class="flex items-baseline justify-between gap-2">
        <h2 class="font-semibold">Stock</h2>
        <% if (mc('stock.view')) { %><a href="/admin/merch/inventory?state=LOW" class="text-sm text-indigo-600 hover:underline">Inventory</a><% } %>
      </div>
      <p class="mt-2 text-sm text-slate-600"><%= stock.units %> units on hand. <span class="<%= stock.low ? 'text-amber-700' : '' %>"><%= stock.low %> low</span>, <span class="<%= stock.soldOut ? 'text-red-700' : '' %>"><%= stock.soldOut %> sold out</span>.</p>
      <% if (stock.valueCentavos !== undefined) { %><p class="text-xs text-slate-500">Value at cost: <%= peso(stock.valueCentavos) %></p><% } %>
      <ul class="mt-3 divide-y divide-slate-100 text-sm">
        <% stock.lowRows.forEach((r) => { %>
          <li class="flex justify-between gap-3 py-1.5"><span class="min-w-0 truncate"><%= r.productName %> <span class="text-slate-500"><%= r.label %></span></span><span class="tabular-nums <%= r.stockState === 'SOLD_OUT' ? 'text-red-700' : 'text-amber-700' %>"><%= r.onHand %></span></li>
        <% }) %>
      </ul>
    </div>

    <div class="admin-card p-6" data-top>
      <h2 class="font-semibold">Best sellers, <%= month.label %></h2>
      <% if (!topProducts.length) { %><p class="mt-3 text-sm text-slate-500">No sales yet this month.</p><% } %>
      <ul class="mt-3 divide-y divide-slate-100 text-sm">
        <% topProducts.forEach((r) => { %>
          <li class="flex justify-between gap-3 py-1.5"><span class="min-w-0 truncate"><%= r.productName %> <span class="text-slate-500"><%= r.label %></span></span><span class="tabular-nums text-slate-700"><%= r.units %> · <%= peso(r.salesCentavos) %></span></li>
        <% }) %>
      </ul>
    </div>

    <div class="admin-card p-6" data-recent>
      <h2 class="font-semibold">Latest paid orders</h2>
      <% if (!recent.length) { %><p class="mt-3 text-sm text-slate-500">No paid orders yet.</p><% } %>
      <ul class="mt-3 divide-y divide-slate-100 text-sm">
        <% recent.forEach((o) => { %>
          <li class="py-1.5">
            <div class="flex justify-between gap-3">
              <% if (mc('orders.view')) { %><a href="/admin/merch/orders/<%= o.orderNumber %>" class="font-mono text-xs text-indigo-700 hover:underline"><%= o.orderNumber %></a><% } else { %><span class="font-mono text-xs"><%= o.orderNumber %></span><% } %>
              <span class="tabular-nums"><%= peso(o.totalCentavos) %></span>
            </div>
            <div class="flex justify-between gap-3 text-xs text-slate-500"><span class="min-w-0 truncate"><%= o.buyerName %> · <%= o.statusLabel %></span><span><%= when(o.paidAt) %></span></div>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
</div>
