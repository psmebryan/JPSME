<%
const areas = region.areas || [];
%>

<section class="relative left-1/2 -ml-[50vw] w-screen bg-indigo-950">
  <div class="max-w-5xl mx-auto px-4 py-16 text-center">
    <h1 class="text-3xl sm:text-4xl font-extrabold text-white">Chapters</h1>
  </div>
</section>

<div class="max-w-5xl mx-auto px-4 py-10">
  <nav class="text-sm text-gray-500 mb-4" aria-label="Breadcrumb">
    <a href="/" class="hover:text-indigo-600">Home</a>
    <span class="mx-2">&gt;</span>
    <a href="/chapters" class="hover:text-indigo-600">Chapters</a>
    <span class="mx-2">&gt;</span>
    <span class="text-gray-700 font-medium"><%= region.name %></span>
  </nav>

  <h2 class="text-2xl font-extrabold text-indigo-950 mb-8"><%= region.name %></h2>

  <% const hasAnyChapters = areas.some(area => area.chapters.length > 0); %>
  <% if (!hasAnyChapters) { %>
    <p class="text-sm text-gray-500">No chapters in this region yet.</p>
  <% } %>

  <% areas.forEach(area => { %>
    <% if (area.chapters.length) { %>
      <div class="mb-10">
        <h3 class="text-lg font-bold text-indigo-600 mb-5"><%= area.name %></h3>
        <div class="grid grid-cols-1 min-[400px]:grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-5">
          <% area.chapters.forEach(chapter => { %>
            <a href="/chapters/<%= chapter.id %>"
               class="bg-indigo-950 border-2 border-amber-400 rounded-xl p-5 text-center shadow-sm hover:shadow-md transition-shadow">
              <p class="text-sm font-bold text-white leading-snug min-h-[2.5rem] flex items-center justify-center"><%= chapter.name %></p>
              <div class="mx-auto mt-3 w-14 h-14 rounded-full border-2 border-amber-400 flex items-center justify-center">
                <svg class="w-8 h-8 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.28z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <p class="mt-3 text-xs font-semibold text-amber-400"><%= chapter.yearFounded %></p>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>
  <% }) %>
</div>
