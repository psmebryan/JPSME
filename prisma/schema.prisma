// Prisma schema for JPSME
// Run `npm run prisma:generate` after changes, and `npm run prisma:migrate` to apply to your local XAMPP MySQL database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  CHAPTER_ADMIN
}

// Stored as named levels rather than a number so the value can't drift into
// something meaningless (year 0, year 7) and reads correctly wherever it's
// displayed. Deliberately stops at fourth year.
enum YearLevel {
  FIRST
  SECOND
  THIRD
  FOURTH
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RegistrationStatus {
  REGISTERED
  PENDING_PAYMENT
  CANCELLED
}

// What a scan was trying to do. CHECK_IN is the scanner-gun path; MANUAL_CHECK_IN
// is the staff fallback search (a person admitted without presenting a QR at all)
// — recorded distinctly so an audit can tell the two apart. CHECK_OUT is unused in
// Phase 1 but reserved so re-entry tracking doesn't need an enum migration later.
enum CheckInAction {
  CHECK_IN
  CHECK_OUT
  MANUAL_CHECK_IN
}

// The server's verdict on a scan. Every scan writes an EventCheckIn row carrying
// one of these — the failures included, which is the point: "how many wrong-event
// scans happened at ENTRANCE-02" is a question door staff actually ask, and it is
// unanswerable if only successes are stored.
enum CheckInResult {
  SUCCESS
  ALREADY_CHECKED_IN
  INVALID_QR
  WRONG_EVENT
  NOT_REGISTERED
  CANCELLED
  UNPAID
  REJECTED
}

// Pure delivery lifecycle — engagement (opened/clicked) is tracked as
// separate nullable timestamps on EventInvitation instead of folded into
// this enum, since a delivered email may or may not ever be opened; those
// are two independent facts, not mutually exclusive states.
enum InvitationStatus {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

enum InvitationSource {
  ADMIN_SENT
  SELF_REQUESTED
}

// A guest (no account) invitee's lightweight yes/no on attending — separate
// from registeredAt, which only ever gets set by an actual EventRegistration
// (which requires an account). PENDING covers both "hasn't answered yet" and
// "ignored the email entirely" — there's no forced choice, per design.
enum InvitationRsvpStatus {
  PENDING
  ATTENDING
  NOT_ATTENDING
}

enum Modality {
  FACE_TO_FACE
  ONLINE
}

enum CertificateTemplateType {
  MEMBERSHIP
  EVENT
}

enum PaymentPurpose {
  MEMBERSHIP_REGISTRATION
  EVENT_REGISTRATION
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum PaymentAttemptStatus {
  CREATED
  AWAITING_PAYMENT
  SUCCEEDED
  FAILED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum AuditAction {
  PAYMENT_CREATED
  PAYMENT_PROCESSING
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  WEBHOOK_RECEIVED
  WEBHOOK_REJECTED
  WEBHOOK_DUPLICATE
  REFUND_REQUESTED
  REFUND_SUCCEEDED
  REFUND_FAILED
  UNAUTHORIZED_PAYMENT_ACCESS
  SUSPICIOUS_PAYMENT_MISMATCH
  PAYMENT_RECONCILED
  USER_STATUS_CHANGED
  // Payment confirmed but the membership auto-approve step itself threw —
  // previously only console.error'd (invisible outside server logs); this
  // makes it show up on the admin audit log so a stuck PENDING-despite-PAID
  // account actually gets noticed and manually approved.
  AUTO_APPROVAL_FAILED
  // QR + check-in access lifecycle. Individual scan outcomes deliberately do
  // NOT go here — they are rows in EventCheckIn, which is indexed for the
  // per-event and per-station reporting this table cannot serve. These four are
  // the administrative actions around it: minting or replacing a ticket's
  // identity, and granting or removing a chapter admin's ability to scan.
  QR_GENERATED
  QR_REGENERATED
  CHECKIN_ACCESS_GRANTED
  CHECKIN_ACCESS_REVOKED
}

model User {
  id              Int      @id @default(autoincrement())
  firstName       String
  middleInitial   String?
  lastName        String
  email           String   @unique
  password        String
  phone           String?
  school          String?
  // Optional: a member attached at province level (an officer, say) is not
  // studying a year at all, so this is never required.
  yearLevel       YearLevel?
  profileImage    String?
  // A member attaches to whichever organization is actually appropriate — a
  // student unit, or a province directly where no unit applies. Ancestors are
  // derived from Organization.path, never stored redundantly here.
  organizationId  Int?
  role            Role     @default(USER)
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?
  // When the current paid membership lapses — set to one year from the moment
  // a membership payment is confirmed (payment.service.js's applyPaymentPaid).
  // Null means no membership has ever been paid for, which is a normal state
  // now that payment is optional; it is NOT the same as expired. Renewing
  // extends from whichever is later, the existing expiry or today, so paying
  // early never costs the member the remainder of their current year.
  membershipExpiresAt DateTime?
  // Where to send them on their first login after finally clearing payment +
  // admin approval — e.g. the event they originally clicked "Create an
  // account" from. Set at registration, read + cleared (one-time) by
  // auth.service.js's login once status is APPROVED. Null the rest of the time.
  postApprovalRedirectUrl String?
  // Null means this account has never completed a login. That is the whole
  // point of the column: the first login after registering lands on /profile,
  // so a new member sees their membership card and learns that paying is
  // optional — every login after that goes to the site home instead, because
  // repeating the orientation on a returning member's tenth visit is just an
  // extra click between them and the site. Written on every successful login,
  // so it doubles as "last seen" for admin use.
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization    Organization? @relation("UserOrganization", fields: [organizationId], references: [id], onDelete: SetNull)
  registrations   EventRegistration[]
  emailVerificationToken EmailVerificationToken?

  organizationAdmin       OrganizationAdmin?
  orgAdminAuditsOld       OrganizationAdminAudit[] @relation("old_org_user")
  orgAdminAuditsNew       OrganizationAdminAudit[] @relation("new_org_user")
  orgAdminAuditsMade      OrganizationAdminAudit[] @relation("org_changed_by")

  eventCertificates EventCertificate[]

  payments          Payment[]
  refundsRequested  Refund[]   @relation("refund_requested_by")
  auditLogsAsActor  AuditLog[] @relation("audit_actor")
  auditLogsAsTarget AuditLog[] @relation("audit_target")
  broadcastsCreated EmailBroadcast[]
  eventInvitations  EventInvitation[]

  checkInsScanned      EventCheckIn[]      @relation("checkin_scanned_by")
  checkInAccess        EventCheckInStaff[] @relation("checkin_staff_user")
  checkInAccessGranted EventCheckInStaff[] @relation("checkin_staff_granted_by")
  checkInAccessRevoked EventCheckInStaff[] @relation("checkin_staff_revoked_by")

  @@index([status])
  @@index([organizationId])
  @@index([membershipExpiresAt])
}

// One active verification code per user; requesting a new one replaces it.
//
// Holds a short numeric code rather than a long random link token. A code is
// typed rather than clicked, so it does not depend on the deployment's own URL
// being reachable — the reason a link is fragile here — but it is also only six
// digits, which changes what the storage has to defend against: guessing is now
// feasible in a way it never was for 256 bits. Hence the attempt counter, and a
// far shorter life than the old 24-hour link.
model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  // sha256 of "<userId>:<code>", never the code itself. The user id is mixed in
  // for two reasons: two people can legitimately be issued the same six digits,
  // which would collide as a bare hash, and it means a stolen hash cannot be
  // matched against a precomputed table of a million codes without also knowing
  // which account it belongs to.
  //
  // Deliberately not unique — lookup is by userId, since verification always
  // knows which account is being confirmed.
  codeHash  String
  // Wrong guesses against the current code. The code is destroyed once this is
  // exhausted, so a million-guess search cannot be run against a live code; the
  // attacker has to request a new one each time, which is rate-limited and
  // mails the real owner every round.
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  description String?  @db.Text
  location    String?
  modality    Modality @default(FACE_TO_FACE)
  imageUrl    String?
  zoomLink    String?
  featured    Boolean  @default(false)
  startDate   DateTime
  endDate     DateTime?
  capacity    Int?
  isPublished Boolean  @default(true)
  // 0 = free (unchanged default behavior). Charged via GCash, same PayMongo
  // flow already used for membership registration — see Payment.eventId.
  feeCentavos Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registrations EventRegistration[]
  certificateTemplate CertificateTemplate?
  certificates        EventCertificate[]
  emailTemplates      EmailTemplate[]
  payments            Payment[]
  invitations         EventInvitation[]
  checkIns            EventCheckIn[]
  checkInStaff        EventCheckInStaff[]
}

model EventRegistration {
  id           Int      @id @default(autoincrement())
  userId       Int
  eventId      Int
  fullName     String
  email        String
  phone        String?
  school       String?
  // Organization snapshot, captured at registration time for the same reason
  // fullName/email/school above are: a member's affiliation can change, and a
  // past event's report must keep reporting who they were affiliated with
  // THEN. organizationId supports aggregation/joins; organizationPath is the
  // rendered label ("JPSME National › Luzon › Cavite Chapter") so the history
  // survives a later rename, reparent, or deletion of the organization.
  organizationId   Int?
  organizationPath String?
  status       RegistrationStatus @default(REGISTERED)
  // Set only when this registration was completed by clicking through an
  // event invitation (see EventInvitation.registeredAt) — lets the admin
  // registrations list show "invited" registrants distinctly from ones who
  // found the event and registered on their own.
  // Human-facing reference ("REG-2026-000123") — what staff read aloud, search
  // by, and print on the ticket. Distinct from Payment.referenceNumber, which
  // identifies a payment rather than a registration. Nullable because it is
  // assigned when the registration becomes valid, not when the row is created.
  registrationNumber String?   @unique
  // The QR's actual payload: 32 cryptographically random bytes, hex-encoded.
  // Opaque by design — it encodes nothing about the person or the event, so a
  // photographed ticket leaks nothing and the server stays the only thing able
  // to resolve it. Unique, so a collision is a write error rather than a silent
  // two-people-one-ticket. Nullable: a PENDING_PAYMENT or CANCELLED
  // registration legitimately has no usable QR.
  qrToken            String?   @unique
  qrGeneratedAt      DateTime?
  // Denormalized "first successful check-in". The scan hot path gates on this
  // one column with a single conditional UPDATE (... WHERE checkedInAt IS NULL),
  // which is what makes two scanners hitting the same QR safe without holding a
  // transaction open; deriving it from the EventCheckIn rows would mean an
  // aggregate on every scan instead. Null = not yet admitted.
  checkedInAt        DateTime?
  invitationId Int?     @unique
  createdAt    DateTime @default(now())

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitation   EventInvitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  // SetNull, not Cascade — deleting an organization must never delete the
  // historical registration; organizationPath still preserves the label.
  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  checkIns     EventCheckIn[]

  @@unique([userId, eventId])
  @@index([organizationId])
  // countActiveRegistrations() (the capacity check on every registration
  // attempt) and the admin registrations list both filter by eventId+status
  // alone — the (userId, eventId) unique index above can't serve that
  // (userId isn't a filter there), so without this it's a full table scan.
  @@index([eventId, status])
}

// Admin-initiated invite for a specific event, sent by email. `userId` is set
// when the admin picked an existing member; left null for a manually-typed
// external contact — either way fullName/email/chapter/school are snapshotted
// onto the row itself so the invite (and the report of it) don't depend on
// the invitee ever having/keeping an account. `token` is the unguessable
// value embedded in the email link; clicking it is how registeredAt/the
// linked EventRegistration ever get set — nothing here auto-registers anyone.
// One row per SCAN, not per admitted person — a person who is scanned three
// times produces three rows (one SUCCESS, two ALREADY_CHECKED_IN). That is
// deliberate: the duplicate and rejected attempts are exactly what the door
// reports are about, and discarding them would leave "this QR was presented
// four times at three stations" invisible. "Is this person admitted?" is
// answered by EventRegistration.checkedInAt, never by aggregating this table.
model EventCheckIn {
  id                  Int      @id @default(autoincrement())
  // Nullable: a scan of a token that matches nothing still gets logged, and by
  // definition has no registration to point at (result = INVALID_QR).
  eventRegistrationId Int?
  // Denormalized from the registration so per-event and per-station reporting
  // never needs a join — and so INVALID_QR scans, which have no registration at
  // all, are still attributable to the event whose door they happened at.
  eventId             Int
  // Reserved for the session-level check-in in the roadmap (Opening Ceremony,
  // Technical Session 1, ...). Unused and always null in Phase 1; present now
  // only so adding sessions later is a new table plus a foreign key, not a
  // rewrite of how scans are recorded.
  sessionId           Int?
  scannedAt           DateTime      @default(now())
  // Null only for a scan that somehow reaches the service without a session —
  // in practice always set, since the endpoint is behind an admin gate.
  scannedBy           Int?
  // Free text the station operator sets once ("ENTRANCE-02"), stored per scan
  // so the station breakdown survives the station being renamed later.
  scannerIdentifier   String?
  action              CheckInAction @default(CHECK_IN)
  result              CheckInResult
  ipAddress           String?
  userAgent           String?       @db.Text
  createdAt           DateTime      @default(now())

  // SetNull rather than Cascade: deleting a registration must not erase the
  // record that someone was admitted at the door with it.
  eventRegistration EventRegistration? @relation(fields: [eventRegistrationId], references: [id], onDelete: SetNull)
  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scanner           User?              @relation("checkin_scanned_by", fields: [scannedBy], references: [id], onDelete: SetNull)

  @@index([eventRegistrationId])
  // Backs both the live "recent check-ins" feed and any time-windowed report.
  @@index([eventId, scannedAt])
  // Backs the per-result counts (successes, duplicates, invalid) on the
  // dashboard without scanning every scan ever recorded for the event.
  @@index([eventId, result])
  @@map("event_check_ins")
}

// A main admin (Role.ADMIN) can always run check-in for any event. This table is
// how that authority is lent to a CHAPTER_ADMIN, and it is scoped to ONE event
// on purpose: a chapter admin granted access for the National Convention gains
// no ability to scan at anything else, and the grant stops mattering when that
// event ends rather than lingering on their account.
//
// Revocation is soft (revokedAt/revokedBy) rather than a row delete, mirroring
// why OrganizationAdminAudit exists — "who could scan at this event, and who
// gave them that" must remain answerable after access is taken away. The unique
// constraint is on (eventId, userId) alone, so re-granting revives the existing
// row instead of accumulating duplicates; active means revokedAt IS NULL.
model EventCheckInStaff {
  id        Int       @id @default(autoincrement())
  eventId   Int
  userId    Int
  grantedBy Int
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  revokedBy Int?

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User  @relation("checkin_staff_user", fields: [userId], references: [id], onDelete: Cascade)
  grantedByUser User  @relation("checkin_staff_granted_by", fields: [grantedBy], references: [id], onDelete: Cascade)
  revokedByUser User? @relation("checkin_staff_revoked_by", fields: [revokedBy], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_check_in_staff")
}

model EventInvitation {
  id            Int              @id @default(autoincrement())
  eventId       Int
  userId        Int?
  fullName      String
  email         String
  chapter       String?
  school        String?
  company       String?
  source        InvitationSource @default(ADMIN_SENT)
  token         String           @unique
  status        InvitationStatus @default(PENDING)
  failureReason String?
  sentAt        DateTime?
  openedAt      DateTime?
  clickedAt     DateTime?
  registeredAt  DateTime?
  rsvpStatus    InvitationRsvpStatus @default(PENDING)
  rsvpAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  event        Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  registration EventRegistration?

  @@unique([eventId, email])
  @@index([eventId])
  @@map("event_invitations")
}

model Sponsor {
  id        Int      @id @default(autoincrement())
  name      String
  logoUrl   String
  websiteUrl String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("sponsors")
}

// MAIN_ADMIN-managed public news/articles (see article.service.js). Body is
// plain text (whitespace-pre-line on render), matching the rest of the site's
// content pages — no rich-text editor dependency.
model Article {
  id          Int       @id @default(autoincrement())
  title       String
  category    String?
  authorName  String?
  coverImage  String?
  body        String    @db.Text
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
  @@map("articles")
}

// Key/value store for site-wide content the admin can change, e.g. site_logo path.
model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// The five organization levels PSME actually uses (taken from the official
// workbook's own LEGEND, not invented here). Deliberately NOT used to enforce
// an ordering: any type may parent any other type, which is what makes a
// variable-depth tree possible. National → Region → Chapter (no cluster) and
// National → Region → Cluster (no chapter) are both valid, and neither needs
// a placeholder row to fill the "missing" level.
// The levels PSME actually uses, taken from the official workbook's own LEGEND
// (MOTHER ORG / REGION / CLUSTER / CHAPTER / STUDENT UNIT) with NATIONAL as the
// single root above them.
//
// National → Region → Province → Student Unit.
//
// Region is the island-group tier: LUZON, VISAYAS, MINDANAO, NCR. Those are
// not provinces — provinces sit beneath them — and only one NATIONAL root is
// permitted, so without this level they had nowhere to go.
//
// Still parent-driven and variable-depth: nothing enforces the order, and a
// school may attach straight to a region where no province is recorded rather
// than having a placeholder invented for it.
enum OrganizationType {
  NATIONAL
  REGION
  PROVINCE
  STUDENT_UNIT
}

// One self-referencing table replaces the old fixed ChapterRegion →
// ChapterArea → Chapter chain. Depth is a property of each branch (data),
// not of the schema.
//
// `path` is a materialized path ("/1/4/9/") maintained alongside parentId by
// organization.service.js. It exists for performance: descendant lookups
// become a single indexed `path LIKE '/1/4/%'` and ancestor lookups a single
// `id IN (...)` parsed from the path, instead of a recursive per-level walk.
// That matters because RBAC resolves a subtree on every scoped admin request
// — an N-query walk there would undo the 5K-readiness work. The tradeoff is
// that reparenting must rewrite a subtree's paths, done inside a transaction
// (a rare admin action).
model Organization {
  id          Int              @id @default(autoincrement())
  name        String
  slug        String           @unique
  code        String?
  type        OrganizationType
  // NULL only for the single NATIONAL root. Restrict (not Cascade) so an
  // organization with children can never be deleted out from under them —
  // same defensive convention as Payment.event elsewhere in this schema.
  parentId    Int?
  path        String           @default("/")
  depth       Int              @default(0)

  // Import provenance. The official workbook establishes a parent for only 1
  // of its 176 organization rows, so the importer attaches what it can
  // actually derive (the mother region) and flags the rest for an admin to
  // resolve — rather than silently guessing a cluster/chapter relationship.
  needsReview Boolean          @default(false)
  importNote  String?          @db.Text
  sourceSheet String?

  institution String?
  email       String?
  facebookUrl String?
  subRegion   String?
  yearFounded Int?
  isActive    Boolean          @default(true)
  order       Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  parent        Organization?       @relation("OrgTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Organization[]      @relation("OrgTree")
  users         User[]              @relation("UserOrganization")
  admins        OrganizationAdmin[]
  registrations EventRegistration[]
  adminAudits   OrganizationAdminAudit[]

  @@index([parentId])
  @@index([type])
  @@index([path])
  @@index([needsReview])
  @@index([parentId, isActive])
  @@map("organizations")
}

// Replaces ChapterAdmin. userId stays @unique (a user administers at most one
// organization) but organizationId is deliberately NOT unique — unlike the old
// one-admin-per-chapter rule, an organization may have more than one admin.
model OrganizationAdmin {
  id             Int      @id @default(autoincrement())
  organizationId Int
  userId         Int      @unique
  assignedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_admins")
}

// Assignment history, same purpose as the old ChapterAdminAudit.
model OrganizationAdminAudit {
  id             Int      @id @default(autoincrement())
  organizationId Int
  oldUserId      Int?
  newUserId      Int?
  changedBy      Int
  changedAt      DateTime @default(now())
  note           String?

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  oldUser       User?        @relation("old_org_user", fields: [oldUserId], references: [id], onDelete: SetNull)
  newUser       User?        @relation("new_org_user", fields: [newUserId], references: [id], onDelete: SetNull)
  changedByUser User         @relation("org_changed_by", fields: [changedBy], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_admin_audit")
}

// One global row (eventId null) for the membership certificate; one row per
// event (eventId set) for that event's certificate. Both customizable only
// by the main ADMIN.
model CertificateTemplate {
  id              Int      @id @default(autoincrement())
  type            CertificateTemplateType
  eventId         Int?     @unique
  backgroundImage String?
  title           String   @default("Certificate")
  bodyText        String   @db.Text
  textColor       String   @default("#1a1a2e")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("certificate_templates")
}

// A generated event certificate PDF for one user. Membership certificates
// are generated on demand from live profile data and not stored here.
model EventCertificate {
  id          Int      @id @default(autoincrement())
  eventId     Int
  userId      Int
  filePath    String
  generatedAt DateTime @default(now())
  generatedBy Int
  released    Boolean  @default(false)
  releasedAt  DateTime?
  releasedBy  Int?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@map("event_certificates")
}

// A membership-registration payment. Amounts are stored in centavos (PayMongo's
// own smallest-unit convention) to avoid float rounding. A user can have more
// than one Payment over time (e.g. a REFUNDED one followed by a new PAID one),
// so userId is intentionally not unique — "at most one active payment" is
// enforced in payment.service.js inside a transaction, not by a DB constraint.
model Payment {
  id                Int            @id @default(autoincrement())
  userId            Int
  purpose           PaymentPurpose @default(MEMBERSHIP_REGISTRATION)
  // Null for MEMBERSHIP_REGISTRATION payments; set for EVENT_REGISTRATION
  // payments. onDelete: Restrict means an event with any payment history
  // (pending, processing, paid, or refunded) can never be deleted out from
  // under its financial records — event.service.js's deleteEvent() also
  // checks this explicitly before touching anything, so the app-level error
  // is friendly; this is the DB-level backstop.
  eventId           Int?
  gateway           String         @default("paymongo")
  gatewayCheckoutId String?        @unique
  gatewayPaymentId  String?        @unique
  // The actual fee/membership amount charged to the payer — JPSME absorbs
  // PayMongo's own transaction fee out of this, it's never added on top.
  amount            Int
  // What PayMongo actually deducted from `amount` before crediting JPSME —
  // populated from the Payment resource's own `fee` field once the payment
  // settles (see applyPaymentPaid), not estimated in advance. 0 until then,
  // and stays 0 for a payment that never reaches PAID. `amount - gatewayFeeCentavos`
  // is what JPSME actually received net.
  gatewayFeeCentavos Int           @default(0)
  currency          String         @default("PHP")
  status            PaymentStatus  @default(PENDING)
  expiresAt         DateTime?
  paidAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event    Event?           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  attempts PaymentAttempt[]
  webhooks PaymentWebhook[]
  refund   Refund?

  @@index([userId])
  @@index([status])
  @@index([eventId])
  @@map("payments")
}

// One row per gateway checkout attempt for a given Payment, so retries after
// a FAILED attempt are tracked individually instead of overwriting history.
model PaymentAttempt {
  id               Int                  @id @default(autoincrement())
  paymentId        Int
  attemptNumber    Int
  gatewayReference String?
  status           PaymentAttemptStatus @default(CREATED)
  failureCode      String?
  createdAt        DateTime             @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, attemptNumber])
  @@map("payment_attempts")
}

// Records every inbound gateway webhook. The (gateway, webhookId) unique
// constraint is what makes replayed/duplicate webhook deliveries a guaranteed
// database-level no-op, not just an application-level check.
model PaymentWebhook {
  id          Int       @id @default(autoincrement())
  gateway     String    @default("paymongo")
  webhookId   String
  eventType   String
  paymentId   Int?
  payload     String    @db.Text
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([gateway, webhookId])
  @@map("payment_webhooks")
}

// A refund only ever reaches SUCCEEDED once the gateway's own refund webhook
// confirms it — never from the synchronous refund-request API response alone.
model Refund {
  id              Int          @id @default(autoincrement())
  paymentId       Int          @unique
  requestedBy     Int
  reason          String?      @db.Text
  amount          Int
  gatewayRefundId String?      @unique
  status          RefundStatus @default(REQUESTED)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  payment         Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  requestedByUser User    @relation("refund_requested_by", fields: [requestedBy], references: [id], onDelete: Restrict)

  @@map("refunds")
}

// General-purpose audit trail (distinct from OrganizationAdminAudit, which
// only covers org-admin reassignment). metadata is a JSON string of plain
// values only — amounts, IDs, reasons — never secrets or credentials.
model AuditLog {
  id           Int         @id @default(autoincrement())
  action       AuditAction
  actorId      Int?
  targetUserId Int?
  paymentId    Int?
  metadata     String?     @db.Text
  ipAddress    String?
  createdAt    DateTime    @default(now())

  actor      User? @relation("audit_actor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUser User? @relation("audit_target", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([actorId])
  @@index([targetUserId])
  // The admin payment detail page's audit-trail lookup filters by paymentId;
  // audit_logs grows continuously (every webhook is logged), so this scans
  // the whole table without an index.
  @@index([paymentId])
  @@map("audit_logs")
}

enum EmailTemplatePurpose {
  MEMBER_APPROVED
  EVENT_REGISTRATION
  EVENT_INVITATION
}

// One global row (eventId null, purpose=MEMBER_APPROVED) for the "you're
// approved" email; one row per event (eventId set, purpose=EVENT_REGISTRATION)
// for that event's registration-confirmation email. Both customizable only by
// the main ADMIN — same shape as CertificateTemplate.
model EmailTemplate {
  id              Int                  @id @default(autoincrement())
  purpose         EmailTemplatePurpose
  eventId         Int?
  subject         String
  bodyHtml        String               @db.Text
  attachmentImage String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Was a plain @unique on eventId — widened to a composite so one event can
  // now hold two template rows (EVENT_REGISTRATION and EVENT_INVITATION)
  // instead of colliding on the same eventId. MEMBER_APPROVED's single
  // global row (eventId always null) stays unique in practice via its own
  // find-or-create logic, not this constraint — MySQL permits multiple NULLs
  // in a unique index anyway.
  @@unique([eventId, purpose])
  @@map("email_templates")
}

enum BroadcastStatus {
  PENDING
  SENDING
  COMPLETED
  FAILED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// The "local" JOB_DRIVER (config.jobs.driver) — a durable, DB-backed queue so
// a crash between "enqueue" and "process" never silently loses the job, the
// way a plain in-memory queue or an un-awaited fire-and-forget call would. A
// future SQS-backed driver would replace job.service.js's implementation
// without this row shape needing to change (a worker process still needs a
// place to record attempts/failures for observability).
model Job {
  id          Int       @id @default(autoincrement())
  type        String
  // JSON-serialized — must be plain IDs/values a handler can rehydrate from
  // the DB, never a live object reference, since a job can be processed by a
  // worker process restarted long after it was enqueued.
  payload     String    @db.Text
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  // Retry backoff: a failed job becomes claimable again only once this time
  // has passed, instead of a worker hot-looping on a job that just failed.
  availableAt DateTime  @default(now())
  lastError   String?   @db.Text
  // JSON-serialized, set on successful completion only — a small summary a
  // caller can poll for (e.g. { generatedCount, skippedCount }), never a
  // large payload. Optional: most job types have nothing worth reporting
  // back beyond "it finished."
  result      String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, availableAt])
  @@map("jobs")
}

// An admin-composed one-off email blast to all members or a hand-picked
// subset. No per-recipient tracking table — this row IS the audit trail
// (who sent what, to how many, aggregate outcome).
model EmailBroadcast {
  id              Int             @id @default(autoincrement())
  subject         String
  bodyHtml        String          @db.Text
  attachmentImage String?
  audienceFilter  String          @db.Text
  totalRecipients Int             @default(0)
  sentCount       Int             @default(0)
  failedCount     Int             @default(0)
  failedEmails    String?         @db.Text
  status          BroadcastStatus @default(PENDING)
  createdBy       Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  creator User @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("email_broadcasts")
}
